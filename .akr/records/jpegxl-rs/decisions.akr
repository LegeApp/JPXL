akr 0.1
project jpegxl-rs

record jpegxl-rs.decision.annex-h-corrected-constants/1 : decision {
    title "Annex H OCR corruptions: the verified constants"
    state proposed
    scope [ path "JPXL/crates/jpxl-decode/**", path "JPXL/crates/jpxl-entropy/**" ]
    topic annex-h-constants
    decision """
        Verified Annex H values after OCR corruption (2026-08-02): Table H.4 rows 4/5 are
        abs(N)/abs(W); kDeltaPalette[4] is {0,-12,0} (not {0,-12,9}); Table H.3 row 13 is
        WW not WH (pinned by the coefficients-sum-to-16 test); H.5.2 weight normalisation
        and error2weight exist only in the LaTeX; in H.6.3 "B = B + A&A" means B = B + A.
        Do not re-transcribe these from the corrupted source.
        """
    context """
        Recovered from HANDOFF "Already fixed" (2026-08-02). See the prefer-latex-over-ocr
        policy for the general rule.
        """
    author "GitHub Uploader"
}

record jpegxl-rs.decision.c26-alias-mapping/1 : decision {
    title "C.2.6 alias mapping is symbols[u] = o, not 0"
    state proposed
    scope [ path "JPXL/crates/jpxl-entropy/**" ]
    topic c26-alias-mapping
    decision """
        In the C.2.6 alias-table build, symbols[u] = o (the overfull index), not 0. The
        LaTeX renders it as 0, an OCR corruption; only o is consistent with the algorithm.
        The invariant test (each symbol s appears exactly D[s] times across slots, offsets
        a permutation of 0..D[s]) fails under = 0. If that test fires, the bug is in new
        code, not the test.
        """
    context """
        Recovered from HANDOFF "Already fixed" (2026-08-02).
        """
    author "GitHub Uploader"
}

record jpegxl-rs.decision.cover-rate-model-calibrated-for-target-rate/1 : decision {
    title "Target-rate requests price the cover objective's rate with the Phase Q4 calibrated model; fixed-quantizer defaults keep the legacy proxy"
    state proposed
    scope [
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/request.rs"
    ]
    topic cover-rate-model
    decision """
        EncodeRequest::for_target sets cover_rate_model = CoverRateModel::Calibrated: a candidate's residual-bit proxy is scaled by 1.56 / 1.63 / 1.88 for DCT8x8 / DCT16x16 / DCT32x32 and each varblock is charged 5.5 / 12.4 / 10.5 fixed bits (non_zeros symbols plus a few bits of DctSelect signalling for merged blocks), replacing 1.0 / 1.0 / 1.0 and 2 / 34 / 34. block_cost_bounded scales its pruning arithmetic by the same factor, so CoverRateModel::Legacy is bit-identical to the Phase Q3 objective and remains the fixed-quantizer default and an explicit --cover-rate-model legacy control.
        """
    context """
        tests/rate_proxy_audit.rs priced the chosen plan's I.4 events under the plan's own trained histograms on the three standing photos at 1 bpp Balanced: interior zeros cost 0.4-1.1 bits, nonzero tokens 3.3-4.1 bits, the three non_zeros symbols 5-11 bits per varblock, DctSelect signalling a few bits; the legacy proxy under-priced DCT8x8/16x16/32x32 residuals by 1.56x/1.63x/1.88x (mid), 1.52/1.58/1.76 (large), 1.84/1.89/2.0 (mid2), so it over-charged merging by its 32-bit constant and under-charged large transforms per coefficient.
        """
    consequences """
        Against Phase Q3 the photo ladder moves SSIMULACRA2 +0.048 (worst -0.19), Butteraugli 3-norm -0.15%, max-norm mean +0.04%; the scenes +0.059 / -0.13% / +0.61%; timing neutral; Fast cells unchanged (fixed cover). The cover mix on the mid photo shifts from 42/38/20% DCT8/16/32 area to 33/52/16%. Phase 7.2's lambda_scale 4 was tuned against the legacy proxy; the absolute 1.56x scale therefore also lowers the cover's effective lambda, and a size-ordering-only variant (1.0/1.045/1.2) was worse on Butteraugli max-norm, so the absolute constants are the promoted ones.
        """
    implements [ @jpegxl-rs.decision.optimization-determinism-contract/1 ]
}

record jpegxl-rs.decision.encoder-architecture-phases/1 : decision {
    title "Reorient encoder work to architecture phases 0-6 (outside-advice)"
    state superseded
    scope [
        path "JPXL/crates/jpxl-cli/**",
        path "JPXL/crates/jpxl-encode-policy/**",
        path "JPXL/crates/jpxl-encode/**",
        path "JPXL/crates/jpxl-entropy/**"
    ]
    topic encoder-architecture-phases
    decision """
        After Opt-F through Opt-P leaf work, further leaf SIMD/LTO/PGO is deferred.
        Implementation follows sources/outside-advice.md phases: (0) instrumentation
        and matched-quality harness foundations; (1) output-preserving corrections;
        (2) replace VarDCT quant/CfL unit of work; (3) replace candidate coefficient
        retention with summaries; (4) rebuild modular planning; (5) perceptual
        parity calibration; (6) entropy specialization and low-level opts last.
        Phase completion is marked in AKR only. Clean-room boundary still forbids
        porting libjxl architecture; behavioral comparison and black-box timing
        remain allowed.
        """
    context """
        Real-world benches showed ~15x VarDCT and ~30-100x Modular gaps with
        parallel+simd features already default-on. Flamegraphs and outside advice
        attribute the gap to call multiplicity and multi-pass planning, not missing
        AVX kernels on leaves that are already small fractions of wall time.
        """
    consequences """
        jpegxl-rs.work.encoder-optimization-plan and Opt-* leaf milestones remain
        historical; new work items attach to architecture-phase work under this
        decision. sources/outside-advice.md is retained per policy.
        """
    implements [
        @jpegxl-rs.constraint.correctness-before-speed,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
    author "grok-build"
}

record jpegxl-rs.decision.encoder-architecture-phases/2 : decision {
    title "Execute the evidence-gated G0-G6 libjxl-gap bridge"
    state active
    scope [
        path "JPXL/crates/jpxl-cli/**",
        path "JPXL/crates/jpxl-encode-policy/**",
        path "JPXL/crates/jpxl-encode/**",
        path "JPXL/crates/jpxl-entropy/**",
        path "JPXL/tools/**"
    ]
    decision """
        The earlier architecture phases through dense coefficient banks, anchored search, finalist token traversal, leaf finishing and Butteraugli localization are complete and are not restarted. Continue with the registered 2026-08-21 gap bridge in evidence order: G0 comparison truth; G1 diagnostic edge-flat risk localization; G2 selective finalist-only run-aware quantization; G3 a bounded truthful production controller; G4 selective low-margin cover/CfL refresh; G5 packed entropy representation and bounded alternatives; G6 only after a fresh profile. No production decision change precedes the G0 baseline, and G2 does not start unless G1 concentrates held-out failures into a small area.
        """
    context """
        Real-world benches showed ~15x VarDCT and ~30-100x Modular gaps with
        parallel+simd features already default-on. Flamegraphs and outside advice
        attribute the gap to call multiplicity and multi-pass planning, not missing
        AVX kernels on leaves that are already small fractions of wall time.
        """
    consequences """
        jpegxl-rs.work.encoder-optimization-plan and Opt-* leaf milestones remain
        historical; new work items attach to architecture-phase work under this
        decision. sources/outside-advice.md is retained per policy.
        """
    implements [
        @jpegxl-rs.constraint.correctness-before-speed,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    supersedes [ @jpegxl-rs.decision.encoder-architecture-phases/1 ]
    supported_by [ @jpegxl-rs.assessment.gap-bridge-2026-08-21 ]
    source {
        kind external
        role origin
        path "sources/external/jpxl-bridging-libjxl-gap-2026-08-21--ae1ed657.md"
        use """
            Adopts the roadmap ordering while keeping each recommendation subject to JPXL evidence.
            """
    }
}

record jpegxl-rs.decision.image-io-at-cli-boundary/1 : decision {
    title "Common raster format dependencies stay at the CLI boundary"
    state superseded
    scope [ path "JPXL/crates/jpxl-cli/**", path "JPXL/crates/jpxl/**" ]
    decision """
        The high-level jpxl library facade remains pixel-buffer based and dependency-light. Common raster file decoding and encoding is an adapter concern of jpxl-cli, where the Rust image crate may be used without entering the normative decoder, encoder, or policy crates.
        """
    context """
        General-use file conversion needs maintained PNG, JPEG, WebP, TIFF, BMP, QOI, TGA, and PNM implementations, while the project keeps normative codec crates near-zero-dependency.
        """
    consequences """
        Library consumers pass ordinary interleaved 8/16-bit buffers without paying for unrelated file codecs. The CLI gains external image-format dependencies and owns their security/version maintenance.
        """
    implements [ @jpegxl-rs.requirement.general-use-integration-surface/1 ]
    author "GitHub Uploader"
}

