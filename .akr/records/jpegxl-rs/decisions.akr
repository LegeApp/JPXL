akr 0.1
project jpegxl-rs

record jpegxl-rs.decision.annex-h-corrected-constants/1 : decision {
    title "Annex H OCR corruptions: the verified constants"
    state proposed
    scope [ path "JPXL/crates/jpxl-decode/**", path "JPXL/crates/jpxl-entropy/**" ]
    topic annex-h-constants
    decision """
        Verified Annex H values after OCR corruption (2026-08-02): Table H.4 rows 4/5 are
        abs(N)/abs(W); kDeltaPalette[4] is {0,-12,0} (not {0,-12,9}); Table H.3 row 13 is
        WW not WH (pinned by the coefficients-sum-to-16 test); H.5.2 weight normalisation
        and error2weight exist only in the LaTeX; in H.6.3 "B = B + A&A" means B = B + A.
        Do not re-transcribe these from the corrupted source.
        """
    context """
        Recovered from HANDOFF "Already fixed" (2026-08-02). See the prefer-latex-over-ocr
        policy for the general rule.
        """
    author "GitHub Uploader"
}

record jpegxl-rs.decision.c26-alias-mapping/1 : decision {
    title "C.2.6 alias mapping is symbols[u] = o, not 0"
    state proposed
    scope [ path "JPXL/crates/jpxl-entropy/**" ]
    topic c26-alias-mapping
    decision """
        In the C.2.6 alias-table build, symbols[u] = o (the overfull index), not 0. The
        LaTeX renders it as 0, an OCR corruption; only o is consistent with the algorithm.
        The invariant test (each symbol s appears exactly D[s] times across slots, offsets
        a permutation of 0..D[s]) fails under = 0. If that test fires, the bug is in new
        code, not the test.
        """
    context """
        Recovered from HANDOFF "Already fixed" (2026-08-02).
        """
    author "GitHub Uploader"
}

record jpegxl-rs.decision.encoder-architecture-phases/1 : decision {
    title "Reorient encoder work to architecture phases 0-6 (outside-advice)"
    state active
    scope [
        path "JPXL/crates/jpxl-cli/**",
        path "JPXL/crates/jpxl-encode-policy/**",
        path "JPXL/crates/jpxl-encode/**",
        path "JPXL/crates/jpxl-entropy/**"
    ]
    topic encoder-architecture-phases
    decision """
        After Opt-F through Opt-P leaf work, further leaf SIMD/LTO/PGO is deferred.
        Implementation follows sources/outside-advice.md phases: (0) instrumentation
        and matched-quality harness foundations; (1) output-preserving corrections;
        (2) replace VarDCT quant/CfL unit of work; (3) replace candidate coefficient
        retention with summaries; (4) rebuild modular planning; (5) perceptual
        parity calibration; (6) entropy specialization and low-level opts last.
        Phase completion is marked in AKR only. Clean-room boundary still forbids
        porting libjxl architecture; behavioral comparison and black-box timing
        remain allowed.
        """
    context """
        Real-world benches showed ~15x VarDCT and ~30-100x Modular gaps with
        parallel+simd features already default-on. Flamegraphs and outside advice
        attribute the gap to call multiplicity and multi-pass planning, not missing
        AVX kernels on leaves that are already small fractions of wall time.
        """
    consequences """
        jpegxl-rs.work.encoder-optimization-plan and Opt-* leaf milestones remain
        historical; new work items attach to architecture-phase work under this
        decision. sources/outside-advice.md is retained per policy.
        """
    implements [
        @jpegxl-rs.constraint.correctness-before-speed,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
    author "grok-build"
}

record jpegxl-rs.decision.ledger-conventions/1 : decision {
    title "AKR ledger conventions for jpegxl-rs"
    state proposed
    scope [ all ]
    topic ledger-conventions
    decision """
        The AKR ledger at the repository root is the plan-of-record. One namespace,
        jpegxl-rs; structure comes from scope path globs over JPXL/crates/**, not from
        extra namespaces. Kind crosswalk from the retired markdown: roadmap phases and
        milestones become milestone and track; waves and slices become work; HANDOFF
        "Already fixed" becomes decision; HANDOFF "Traps" becomes policy; LESSONS and
        resource limits become decision and constraint; docs/experiments notes become
        observation and evidence with watches; CONFORMANCE becomes milestone acceptance
        plus observation. Generated views under docs/generated are the single reading
        surface; the source markdown is retired to legacy citations. Historical
        milestones are imported with source { kind legacy } so D-028 exempts their old
        evidence commits from the descendant-commit gate.
        """
    context """
        Planning lived in RUST_JXL_ENCODER_ROADMAP.md, JPXL/docs HANDOFF, PLAN and
        CONFORMANCE, and about twenty-five dated docs/experiments notes, all hand
        maintained and drifting. AKR makes the plan typed, checkable and generated.
        """
    consequences """
        Agents propose and revise records and log papercuts instead of editing
        HANDOFF.md; wave commits become ledger writes. Renaming the namespace later
        rewrites every key, so it is fixed here.
        """
    author "GitHub Uploader"
}

record jpegxl-rs.decision.modular-lean-default/1 : decision {
    title "Modular default effort is the lean level 1; the full search is opt-in"
    state active
    scope [ path "JPXL/crates/jpxl-cli/**", path "JPXL/crates/jpxl-encode/**" ]
    decision """
        Effort::DEFAULT for the lossless modular path is Effort::MIN (level 1): one predictor, no split search, no per-leaf refinement, no palette/squeeze trials, coarse sampling stride, collapsed tree. The full pre-ramp search is retained verbatim at level 7 -- a byte-identical density anchor pinned by the effort_7_budget_is_the_pre_ramp_search test -- and levels 8-9 add finer stride and deeper search for density chasing. Effort is expanded once at the plan_for stage boundary into a ModularSearchBudget (Encoder-plan1.md 12), never re-checked in a kernel.
        """
    context """
        The full search was measured to be chaff on the photo corpus: byte-identical output to level 1 at ~16x the wall time (jpegxl-rs.assessment.modular-effort-lean-default). Quality is preserved unconditionally because every level is exact-lossless.
        """
    consequences """
        Default encodes are 4.6-16.9x faster on photos with byte-identical output (verified: .agent/scratch/effort-ramp-2026-08-10/verify_default_flip.ps1). Flat/paletteable content encodes a few percent larger by default (measured 3.7% on a synthetic screenshot) unless a higher effort is selected. This default-output change is deliberate but validated only on a limited corpus; a broader real-world UI/line-art corpus should confirm the tradeoff before any method is deleted (as opposed to demoted).
        """
    implements [
        @jpegxl-rs.constraint.correctness-before-speed,
        @jpegxl-rs.policy.optimization-correctness-gates
    ]
    supported_by [ @jpegxl-rs.assessment.modular-effort-lean-default ]
    author "GitHub Uploader"
}

record jpegxl-rs.decision.opt-p-wide-rayon-deps/1 : decision {
    title "wide and rayon are feature-gated default dependencies for Opt-P"
    state proposed
    scope [ path "JPXL/crates/**" ]
    topic opt-p-wide-rayon-deps
    decision """
        The encoder optimization track may depend on the `wide` (portable SIMD)
        and `rayon` (work-stealing pool) crates. Both are optional Cargo features
        named `simd` and `parallel`, enabled by default on jpxl-core (simd),
        jpxl-encode, jpxl-encode-policy, and jpxl-cli. Builds with
        --no-default-features remain pure-scalar and std::thread-only. Contract A
        holds across thread counts for section emission; SIMD kernels may use
        Contract B float semantics relative to scalar builds and stay decode-valid.
        """
    context """
        Approved during Opt-P leaf-SIMD work after coarse section parallelism landed.
        """
}

record jpegxl-rs.decision.optimization-determinism-contract/1 : decision {
    title "Contract A for structural optimization; bounded Contract B for quality policy"
    state proposed
    scope [
        path "JPXL/crates/jpxl-bitstream/**",
        path "JPXL/crates/jpxl-encode-policy/**",
        path "JPXL/crates/jpxl-encode/**",
        path "JPXL/crates/jpxl-entropy/**"
    ]
    decision """
        Default to Contract A for optimization changes: same source and options produce identical codestream bytes across thread counts, scheduling, and scalar versus optimized integer/bitstream paths. Structural refactors (BitWriter bulk path, plan Arc-sharing, coefficient arenas, scratch reuse, Rayon section encoding, integer SIMD) must prove byte-identical output. Contract B permits deliberate quality-policy changes after a recorded corpus gate. Phase 5G's target-rate AQ/quant_lf gate required matched achieved rate, no Butteraugli regression in 12 representative cells, at least 7.5% observed Butteraugli improvement in every cell, RMSE improvement in every cell, and disclosed SSIMULACRA2 regression bounded to 4.5 points. Phase 5I's active-EPF gate separately requires matched achieved rate, no Butteraugli regression in 12 cells, at least 0.6% observed Butteraugli improvement in every cell, RMSE and Butteraugli-pnorm3 improvement in every cell, and any SSIMULACRA2 regression disclosed and bounded to 0.05 points. Future Contract B changes require another explicit revision naming their bounds.
        """
    context """
        VarDCT RD ties are sensitive to tiny float differences. Wide and hand SIMD can change NaN patterns and wrapping. The project already requires software-defined float conversion without fast-math for the reference pair. Phase 5G deliberately changed target-rate quantization policy. Phase 5I deliberately activates decoder restoration by signalling one EPF step and a uniform Sharpness 7 grid; this changes reconstructed pixels without changing coefficient decisions.
        """
    consequences """
        Every structural PR needs scalar-vs-optimized and 1-vs-N-thread byte equality tests where applicable. Float kernel and RD-search work may not claim Contract A without proof. Phase 5 target-rate quality policies may be promoted only while their recorded corpus evidence satisfies the separately stated Butteraugli, RMSE, achieved-rate, pnorm3, and SSIMULACRA2 bounds. The observed SSIMULACRA2 tradeoffs remain explicit guardrails for later work.
        """
    implements [ @jpegxl-rs.constraint.correctness-before-speed ]
    supported_by [ @jpegxl-rs.assessment.encoder-static-optimization ]
}

record jpegxl-rs.decision.optimization-ordering/1 : decision {
    title "Optimization order: structure, then parallel, then SIMD"
    state proposed
    scope [
        path "JPXL/crates/jpxl-bitstream/**",
        path "JPXL/crates/jpxl-core/**",
        path "JPXL/crates/jpxl-encode-policy/**",
        path "JPXL/crates/jpxl-encode/**"
    ]
    topic optimization-ordering
    decision """
        Within the encoder optimization pass, implement in this order: (1) separate
        Modular and VarDCT benchmarks plus multiplicity counters; (2) remove repeated
        full-frame work, deep plan clones, and per-varblock allocation; (3) replace
        known-bad algorithms (bit-at-a-time writer, dense DCT32 fallback when factored
        scalar exists, brute-force LZ only if hot); (4) reshape hot scalar loops for
        the compiler; (5) coarse group and section parallelism with a single resource
        policy; (6) explicit SIMD only on remaining leaf kernels; (7) LTO and PGO last.
        Do not start with a general SIMD or Rayon sweep.
        """
    context """
        Advisor static assessment. Aligns with correctness-before-speed (scalar before
        parallelism before SIMD).
        """
    implements [
        @jpegxl-rs.constraint.correctness-before-speed,
        @jpegxl-rs.constraint.forbid-unsafe-by-default
    ]
    supported_by [ @jpegxl-rs.assessment.encoder-static-optimization ]
    source {
        kind legacy
        path "JPXL/optimization-plan.akr"
        excerpt """
            First remove repeated transforms, repeated whole-frame scans, repeated
            emissions, deep coefficient copies, and per-varblock allocations. Then
            parallelize groups. Then vectorize the small number of arithmetic kernels
            still visible at the top of the profile.
            """
    }
}

record jpegxl-rs.decision.optimization-pass-opened/1 : decision {
    title "Open the encoder optimization pass under AKR"
    state proposed
    scope [ path "JPXL/crates/**" ]
    topic optimization-pass-opened
    decision """
        Begin the encoder optimization pass now that M1-M8 exist. PLAN/AGENTS language
        that deferred SIMD and Rayon for the scalar reference phase remains the default
        outside this track; work on this track may introduce coarse parallelism and
        leaf SIMD only after the measurement foundation and structural multiplicity
        fixes land, and only under correctness-before-speed and forbid-unsafe-by-default.
        """
    context """
        VarDCT M1-M8 and Modular density work (slice 19+) are feature-complete enough
        for a performance baseline. PERFORMANCE.md still has no rows. An external advisor
        assessment is captured as jpegxl-rs.assessment.encoder-static-optimization.
        """
    consequences """
        Optimization work is planned as jpegxl-rs.track.encoder-optimization milestones.
        Density-pin vs cjxl becomes a Modular metric under the foundation milestone, not
        an excuse to skip benches.
        """
    implements [ @jpegxl-rs.constraint.correctness-before-speed ]
    supported_by [ @jpegxl-rs.assessment.encoder-static-optimization ]
    source {
        kind legacy
        path "JPXL/optimization-plan.akr"
        excerpt """
            Recommended implementation order: Common foundation, then Modular track,
            then VarDCT track, then parallel and SIMD, finish with LTO and PGO.
            """
    }
}

