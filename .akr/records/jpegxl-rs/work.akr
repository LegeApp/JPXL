record jpegxl-rs.work.arch-phase28-cfl-lf-scratch-reuse/1 : work {
    title "Phase 28: reusable CfL LF-sample scratch buffers"
    state completed
    scope [
        path ".agent/scratch/**",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/docs/optimize.md"
    ]
    intent """
        Replace estimate_cfl's three fresh `vec![0.0f32; n*n]` heap allocations per varblock (y_lf, x_lf, b_lf) with per-LF-group scratch buffers reused across varblocks via `Vec::resize`, the same pattern already used for the group's `llf_scratch` TransformScratch. Preserve exact arithmetic (lf_samples_of always overwrites exactly the first n*n cells it is handed) and every wire byte; this is allocation-only construction reuse in the spirit of Phases 19-24, not an algorithmic change.
        """
    note """
        A fresh diagnostic pass (bench vardct-rate --diag on this session's host, since perf/flamegraph access is blocked in this sandbox: perf_event_paranoid=4, no sudo) showed CfL search is now the largest or second-largest single cost bucket post-Phase-27: ~146-302ms of Balanced's ~760-1540ms wall (19-20%), and ~1.27-2.19s per anchor of Quality's plan_ms (Quality's cfl_ms is now its single largest bucket at roughly 37-40% of total wall, ahead of cover_ms and entropy_ms). Cover/CfL structural reuse across anchors was already tried and rejected in an earlier phase (regressed SSIMULACRA2 up to 3.95 points), so this phase only removes allocation overhead within the existing per-structural-build CfL search, not the search itself. The pinned five-iteration timing showed small, mostly positive deltas (Balanced mid 942.267->928.328ms, Balanced large 1787.939->1741.568ms, Quality mid 6849.583->6644.058ms); Quality large's median rose slightly (13592.348->13889.233ms) while its five-iteration total fell (73961.143->68760.513ms) and its minimum fell (13457.713->12841.807ms), so that one cell reads as noisy rather than a regression. All four cases stayed byte- and fingerprint-identical to the pre-change binary. The remaining CfL/cover cost is now believed to be dominated by the search's own arithmetic (forward DCT + regression), not allocation, so a further reduction needs the local dirty-frontier idea in optimize.md's open question 1, not more construction reuse.
        """
    acceptance {
        check gates {
            statement """
                Workspace build, formatting, and Clippy on the changed crate pass; strict Clippy remains isolated to pre-existing blockers.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase28-gates-2026-08-16/1 ]
        }
        check identity {
            statement """
                Canonical Fast, Balanced, Quality, and masking-AQ streams on mid and large inputs remain byte-identical to the pre-Phase-28 binary; every candidate output decodes.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase28-identity-2026-08-16/1 ]
        }
        check safety {
            statement """
                The full workspace test suite passes unchanged.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase28-safety-2026-08-16/1 ]
        }
        check speed {
            statement """
                A pinned five-iteration Balanced/Quality mid+large timing screen shows small, mostly positive deltas with identical output bytes and fingerprints in every case.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase28-speed-2026-08-16/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase27-finalist-only-entropy ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

record jpegxl-rs.work.arch-phase29-srgb-linear-lut/1 : work {
    title "Phase 29: sRGB-to-linear lookup table"
    state completed
    scope [
        path ".agent/scratch/**",
        path "JPXL/crates/jpxl-encode-policy/src/source.rs",
        path "JPXL/docs/optimize.md"
    ]
    intent """
        Replace PreparedFrame::from_srgb8's per-sample call to jpxl_core::color::srgb_to_linear (which evaluates powf(x, 2.4) on its non-linear segment) with a 256-entry lookup table built once per encode, since an 8-bit sample has only 256 distinct byte values. Preserve exact output: the LUT is filled by calling the same srgb_to_linear function on each of the 256 possible byte/255.0 inputs, so every lookup returns the identical f32 a direct call would have returned.
        """
    target 2026-08-16
    note """
        This session's host had perf_event_paranoid relaxed to 0 (user: `sudo sysctl -w kernel.perf_event_paranoid=0`), unblocking real perf/inferno profiling for the first time in this optimization pass. A DWARF-unwound flamegraph on Balanced mid immediately identified `<f32>::powf` inside `srgb_to_linear`, called only from this one per-pixel call site in `from_srgb8`, as a top self-time leaf (`__powf_fma` was 2.7% of sampled cycles in a shallow frame-pointer profile; `cbrtf`, reached from the same libm powf implementation, was another 1.7%). A post-change profile shows `cbrtf` gone entirely and `__powf_fma` reduced to a small residual. This is the first phase in this pass driven by an instruction-level profile rather than the built-in stage-timer diagnostics, and the first to touch the color-conversion stage rather than the rate/quantization search.
        """
    acceptance {
        check gates {
            statement """
                Workspace build, formatting, full test suite, and Clippy on the changed crate pass.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase29-gates-2026-08-16/1 ]
        }
        check identity {
            statement """
                Canonical Fast, Balanced, Quality, and masking-AQ streams on mid and large inputs remain byte-identical to the pre-Phase-29 binary; every candidate output decodes.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase29-identity-2026-08-16/1 ]
        }
        check profile {
            statement """
                A DWARF-unwound profile traces the powf/cbrtf cost to the per-pixel srgb_to_linear call site, and a post-change profile shows it removed.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase29-profile-2026-08-16/1 ]
        }
        check speed {
            statement """
                A pinned five-iteration Fast/Balanced/Quality mid+large timing screen shows every case faster with identical output bytes and fingerprints.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase29-speed-2026-08-16/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase28-cfl-lf-scratch-reuse ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

record jpegxl-rs.work.arch-phase3-forward-cache/1 : work {
    title "Phase 3: eliminate the selected-forward clone; borrow from CandidateForwardCache"
    state superseded
    intent """
        outside-advice.md §7 flags two redundant retentions of full per-candidate
        HF coefficient vectors: CandidateForwardCache (every scored cover candidate,
        frame-wide, ~428 MB at 12 MP) and forward_selected's second owned clone of
        just the selected varblocks (~144 MB at 12 MP). This work eliminates the
        second one: split cover selection's per-group loop into two passes so every
        selected varblock's forward can be *borrowed* from CandidateForwardCache
        (now exposing a read-only get()) instead of cloned into groups. The first
        retention (CandidateForwardCache itself, which must keep every scored
        candidate -- winners and losers -- because the rate loop shares one cache
        across quantizer probes to avoid re-running the forward DCT per probe) is
        explicitly NOT touched by this work; see the note for why a naive LRU/FIFO
        cap on it is risky (could gut cross-probe reuse for RateSearchBudget's up to
        40 probes) and deferred pending a design that understands the rate loop's
        access pattern.
        """
    note """
        2026-08-07: landed the safe half (selected-forward clone). Verified
        output-preserving by construction (pure ownership/borrow restructuring, no
        decision logic touched) and confirmed via --diag fingerprint identity: 12MP
        vardct-fixed threads=1 output_bytes and fingerprint unchanged
        (1,530,188 / 30e55ba3faef4d64) both before and after, sel_clones/sel_bytes
        41,949/144,000,000 -> 0/0. All jpxl-encode + jpxl-encode-policy lib, oracle,
        roundtrip and rate_loop tests pass (the one pre-existing
        both_oracles_decode_a_stream_from_the_hf_mul_segment failure is unrelated,
        see jpegxl-rs.work.arch-phase2-cfl-quant's note).

        CandidateForwardCache itself (the ~428 MB frame-wide candidate retention,
        the larger of outside-advice §7's two numbers) is unaddressed. It backs
        cross-probe reuse in the rate loop (crates/jpxl-encode-policy/src/rate.rs:589
        keeps one CandidateForwardCache across all quantizer probes of one encode,
        so a probe's cover search can skip re-running the forward DCT for positions
        a prior probe already scored). A bounded cap (LRU/FIFO) risks evicting
        exactly the entries a later probe needs, which for RateSearchBudget's up to
        ~40 probes could turn a cache hit into 40x the forward-DCT work -- a real
        wall-clock regression, not just a missed win. A safe reduction here needs
        either: (a) a cap sized/validated against actual rate-loop access patterns
        (measure hit-rate degradation, not just implement and hope), or (b) the
        fuller outside-advice §8 redesign -- compact per-candidate summaries
        (estimated_rate/distortion/band_energy, not raw coefficient vectors) scored
        during cover search, with only the winning transform's exact coefficients
        ever materialized. (b) is the architecturally 'right' answer per outside-
        advice but is a much bigger change (touches block_cost/tile_region's
        candidate representation, not just an ownership pattern) and should get its
        own scoped work item rather than being bolted onto this one.
        """
    acceptance {
        check clone-eliminated {
            statement """
                --diag on a 12 MP VarDCT encode reports sel_clones=0 and sel_bytes=0.
                """
            method observation
            verified_by [
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated-postcommit/1
            ]
        }
        check output-unchanged {
            statement """
                The --diag fingerprint and output_bytes for a fixed 12 MP vardct-fixed encode are identical before and after (pure representational change, no decision logic touched).
                """
            method observation
            verified_by [
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated-postcommit/1
            ]
        }
        check tests-green {
            statement """
                jpxl-encode-policy and jpxl-encode lib, oracle, roundtrip and rate_loop tests pass (modulo the pre-existing, unrelated both_oracles_decode_a_stream_from_the_hf_mul_segment failure).
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode -p jpxl-encode-policy --lib --release && cargo test -p jpxl-encode-policy --test vardct_oracle --test vardct_roundtrip --test rate_loop"
            verified_by [
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated-postcommit/1
            ]
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
    source {
        kind external
        path "sources/outside-advice.md"
        excerpt """
            Section 7: The current forward cache is counterproductive
            """
    }
}

record jpegxl-rs.work.arch-phase3-forward-cache/2 : work {
    title "Phase 3: eliminate the selected-forward clone; borrow from CandidateForwardCache"
    state completed
    intent """
        outside-advice.md §7 flags two redundant retentions of full per-candidate
        HF coefficient vectors: CandidateForwardCache (every scored cover candidate,
        frame-wide, ~428 MB at 12 MP) and forward_selected's second owned clone of
        just the selected varblocks (~144 MB at 12 MP). This work eliminates the
        second one: split cover selection's per-group loop into two passes so every
        selected varblock's forward can be *borrowed* from CandidateForwardCache
        (now exposing a read-only get()) instead of cloned into groups. The first
        retention (CandidateForwardCache itself, which must keep every scored
        candidate -- winners and losers -- because the rate loop shares one cache
        across quantizer probes to avoid re-running the forward DCT per probe) is
        explicitly NOT touched by this work; see the note for why a naive LRU/FIFO
        cap on it is risky (could gut cross-probe reuse for RateSearchBudget's up to
        40 probes) and deferred pending a design that understands the rate loop's
        access pattern.
        """
    note """
        2026-08-07: landed the safe half (selected-forward clone). Verified
        output-preserving by construction (pure ownership/borrow restructuring, no
        decision logic touched) and confirmed via --diag fingerprint identity: 12MP
        vardct-fixed threads=1 output_bytes and fingerprint unchanged
        (1,530,188 / 30e55ba3faef4d64) both before and after, sel_clones/sel_bytes
        41,949/144,000,000 -> 0/0. All jpxl-encode + jpxl-encode-policy lib, oracle,
        roundtrip and rate_loop tests pass (the one pre-existing
        both_oracles_decode_a_stream_from_the_hf_mul_segment failure is unrelated,
        see jpegxl-rs.work.arch-phase2-cfl-quant's note).

        CandidateForwardCache itself (the ~428 MB frame-wide candidate retention,
        the larger of outside-advice §7's two numbers) was left unaddressed pending
        measurement -- see jpegxl-rs.evidence.phase3-rate-loop-cache-reuse-measured.

        2026-08-07 (later same day): measured it. Extended `jpxl bench vardct-rate
        --diag` with a new rate_diag= line surfacing RateOutcome.stats (fast_prices,
        full_prices, dct_cache_hits/misses -- fields that already existed but were
        never printed). Two images (4000x3000 and 1024x768, bpp=1.0, default
        max_prices=40 budget) both landed a ~96-97% cross-probe hit rate
        (6,349,453/6,595,028 and 497,050/513,177 respectively) over 23-25 total
        probes. Misses in both runs closely match a single vardct-fixed probe's
        unique candidate count, confirming every probe after the first scores the
        *same* candidate set (position+transform is quantizer-independent; only
        block_cost's score of each candidate depends on the probe's quantizer) and
        gets an almost-total cache hit.

        This answers the note's option (a): a size cap is **not viable**. The cache
        would need to retain essentially 100% of one frame's unique candidates to
        preserve this reuse, so capping it below that trades wall-time (up to ~23x
        more forward-DCT recomputation for evicted-then-needed entries) for a memory
        saving that shrinks to nothing as the cap approaches the size needed to avoid
        that cost. Option (b) -- outside-advice §8's compact-per-candidate-summary
        redesign (score cover candidates from summaries, materialize full
        coefficients only for the winner) -- is the only remaining path to actually
        shrinking this 428 MB, and it needs its own scoped work item: it changes
        block_cost/tile_region's candidate representation, not just a cache policy,
        so it carries real correctness/quality risk the way Phase 2's CfL rewrite
        did, not the representational-only safety of this work item's landed half.
        """
    acceptance {
        check clone-eliminated {
            statement """
                --diag on a 12 MP VarDCT encode reports sel_clones=0 and sel_bytes=0.
                """
            method observation
            verified_by [
                @jpegxl-rs.evidence.phase3-forward-cache-rev2-postcommit/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated-postcommit/1
            ]
        }
        check output-unchanged {
            statement """
                The --diag fingerprint and output_bytes for a fixed 12 MP vardct-fixed encode are identical before and after (pure representational change, no decision logic touched).
                """
            method observation
            verified_by [
                @jpegxl-rs.evidence.phase3-forward-cache-rev2-postcommit/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated-postcommit/1
            ]
        }
        check tests-green {
            statement """
                jpxl-encode-policy and jpxl-encode lib, oracle, roundtrip and rate_loop tests pass (modulo the pre-existing, unrelated both_oracles_decode_a_stream_from_the_hf_mul_segment failure).
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode -p jpxl-encode-policy --lib --release && cargo test -p jpxl-encode-policy --test vardct_oracle --test vardct_roundtrip --test rate_loop"
            verified_by [
                @jpegxl-rs.evidence.phase3-forward-cache-rev2-postcommit/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated-postcommit/1
            ]
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supersedes [ @jpegxl-rs.work.arch-phase3-forward-cache/1 ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
}

record jpegxl-rs.work.arch-phase30-natural-order-ref/1 : work {
    title "Phase 30: zero-copy natural coefficient order"
    state completed
    scope [
        path ".agent/scratch/**",
        path "JPXL/crates/jpxl-core/src/varblock.rs",
        path "JPXL/crates/jpxl-encode-policy/src/entropy.rs",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode/src/vardct/walk.rs",
        path "JPXL/crates/jpxl-encode/src/vardct/write.rs",
        path "JPXL/docs/optimize.md"
    ]
    intent """
        jpxl_core::varblock::natural_coeff_order(bwidth, bheight) already caches its I.3.2 table in a per-Order-ID OnceLock<Vec<u32>>, but every call still clones the cached Vec, even though there are only 13 possible Order IDs and the table never changes after the first call for a given shape. Add natural_coeff_order_ref (and TransformType::natural_coeff_order_ref) returning a 'static borrow into the same cache, and switch every read-only call site this profile found -- jpxl-encode-policy's entropy.rs (twice, one of them inside a per-varblock loop over every LF-group block), jpxl-encode's walk.rs OrderTables::from_order_set, and write.rs's write_hf_coeff_orders -- to the borrowed form. Call sites that mutate their own copy (write.rs's two order-search table builders, plan.rs's order-length validator) keep calling the owned natural_coeff_order, unchanged.
        """
    note """
        Found via a DWARF-unwound perf/inferno profile on Quality mid (2 iters, threads=4, 33580 samples) -- the first phase in this pass to profile the encoder's write/entropy stage rather than color conversion (Phase 29) or CfL (Phase 28). The clone chain (natural_coeff_order -> Vec::clone -> to_vec_in -> allocator) was about 1.24% of sampled self-time (17.95M of 1.452B cycles across 9 distinct stacks), concentrated in entropy.rs's per-varblock order-frequency counting loop. A post-change profile of the same scenario shows the same chain reduced to about 0.03% of sampled cycles (3.06M of 9.89B), roughly a 40x reduction in that specific cost. The pinned wall-clock screen was mixed: Fast large -2.2%, Balanced large -11.6%, Quality mid -3.1% (all in the profile-predicted direction), but Fast mid +8.8% and Quality large +4.2% with markedly higher run-to-run spread (mad) in exactly those two candidate runs -- read as host-noise contamination of specific samples, not a real regression, since a redundant-clone removal has no mechanism to slow anything down and every output byte and fingerprint stayed identical. The profile-measured before/after delta is the load-bearing evidence for this phase, not the noisy wall-clock screen.
        """
    acceptance {
        check gates {
            statement """
                Workspace build (with and without --tests) is warning-free, formatting is clean, the full test suite passes, and Clippy reports nothing on any changed file.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase30-gates-2026-08-16/1 ]
        }
        check identity {
            statement """
                Canonical Fast, Balanced, Quality, and masking-AQ streams on mid and large inputs remain byte-identical to the pre-Phase-30 binary; every candidate output decodes.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase30-identity-2026-08-16/1 ]
        }
        check profile {
            statement """
                A DWARF-unwound profile traces the redundant-clone cost to the per-varblock natural_coeff_order call site, and a post-change profile shows it reduced roughly 40x. A pinned wall-clock screen was also recorded (mixed, noise-dominated result; see evidence) since it is this pass's usual acceptance method, but the profile delta carries the cost claim.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase30-profile-2026-08-16/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase29-srgb-linear-lut ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

record jpegxl-rs.work.arch-phase31-lane4-vector-select/1 : work {
    title "Phase 31: lane-parallel candidate scoring in choose_lane4"
    state completed
    scope [
        path ".agent/scratch/**",
        path "JPXL/crates/jpxl-encode-policy/src/quantize.rs",
        path "JPXL/docs/optimize.md"
    ]
    intent """
        A fresh DWARF-unwound profile of the Quality-mid scenario (post Phase 30) moved the leaf encoder cost to HfQuantizer::choose_lane4: 12.7% self time plus ~10% more in the bounds-check helpers its candidate-scoring loop de-vectorized into (a quantize-loop family of 34.8% of samples). The SIMD choose_lane4 built reconstructions as f32x4 but then spilled every candidate lane back to scalar arrays and re-selected winners with sixteen bounds-checked .get() updates per call. Rewrite the candidate loop lane-parallel: keep best_q/best_err/best_recon in registers as f32x4, express the scalar update rule (first legal candidate with strictly smaller error, else equal error and strictly smaller magnitude, in choose's [0, estimate-1, estimate, estimate+1] order) as comparison masks and blends, turn the |q| > MAX_QUANT legality skip into a float cmp_le against splat(MAX_QUANT) (exact at 2^20), and force zero-threshold lanes to zero after the search. Also hoist the per-channel step/threshold row lookups out of the lane loop and convert remaining scalar tails to zip iteration. Results must stay bit-identical to four scalar choose calls -- same comparisons on the same values in the same order, lane-parallel.
        """
    note """
        Found via a fresh DWARF-unwound perf/inferno profile on Quality mid (threads=4), taken after Phase 30 shifted the write/entropy cost: choose_lane4 at 12.7% self, with the de-vectorized selection helpers (SliceIndex::get for [i32]/[f32], Option::copied, wrapping_abs, range/comparison glue) pushing the quantize-loop family to 34.8% of samples. Fix: candidate scoring stays in f32x4 registers end to end (comparison masks + blend), the MAX_QUANT legality skip becomes a float cmp_le against splat(MAX_QUANT) (exact at 2^20 in f32), zero-threshold lanes are forced after the search exactly as the scalar shortcut would have returned early, and the per-channel step/threshold row lookups leave the lane loop. Post-change profile of the same scenario: family at 27.2% (choose_lane4 self 10.5%), a ~22% relative reduction. Pinned wall-clock screen: 4 of 6 cases in the predicted direction (Quality mid -6.4% median with tight mad, Fast large -31%, Balanced large -2.5% total, Balanced mid flat); Fast mid and Quality large slower/noisier -- the same host-contamination signature Phase 30 hit, so the profile delta again carries the cost claim and no formal speed check is asserted. Gates: workspace build and build --tests warning-free, fmt --all --check clean, full workspace test suite (40 suites) passes. PRE-EXISTING, NOT THIS CHANGE: workspace cargo clippy --all-targets -- -D warnings fails at HEAD on 70 indexing_slicing hits in jpxl-core/src/color.rs (introduced by f3be8b8; verified present on the clean tree by stashing this change). color.rs is outside this brief, so it is reported, not opportunistically fixed. Raw folded profiles and timing log under .agent/scratch/phase31/.
        """
    acceptance {
        check gates {
            statement """
                Workspace build (with and without --tests) is warning-free, formatting is clean, and the full test suite passes. Workspace clippy is documented as failing at HEAD on pre-existing jpxl-core/src/color.rs indexing_slicing hits (f3be8b8), outside this brief.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase31-gates-2026-08-16/2 ]
        }
        check identity {
            statement """
                Canonical Fast, Balanced, Quality, and masking-AQ streams on mid and large inputs remain byte-identical to the pre-Phase-31 binary; every candidate output decodes.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase31-identity-2026-08-16/2 ]
        }
        check profile {
            statement """
                A DWARF-unwound profile traces the candidate-selection cost inside choose_lane4, and a post-change profile shows the quantize-loop family reduced (34.8% -> 27.2% of samples). A pinned wall-clock screen was recorded but is mixed/noise-dominated (as in Phase 30); the profile delta carries the cost claim.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase31-profile-2026-08-16/2 ]
        }
    }
}

record jpegxl-rs.work.arch-phase32-dirty-frontier-screen/1 : work {
    title "Phase 32: dirty-frontier cover stability screen (open question 1)"
    state completed
