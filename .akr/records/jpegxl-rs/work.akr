akr 0.1
project jpegxl-rs

record jpegxl-rs.work.arch-phase0-instrumentation/1 : work {
    title "Phase 0: encode diagnostics and thread-scaling counters"
    state active
    intent """
        Instrument VarDCT plan stages (choose calls by cover/cfl_y/cfl_factor/final,
        stage wall times, candidate-forward and CfL sample memory proxies) and
        Modular plan multiplicity (residual scans, plane clone bytes). Expose via
        jpxl bench --diag. Measure 12 MP one-thread vs auto-thread for modular and
        vardct-fixed. Do not change encode outputs in this work.
        """
    acceptance {
        check counters-available {
            statement """
                jpxl bench --diag prints choose_total (or residual_scans) on a
                release binary for modular and vardct-fixed modes.
                """
            method command
        }
        check twelve-mp-diag-logged {
            statement """
                A scratch log under .agent/scratch/ records 12 MP diag lines for
                threads=1 and threads=auto for at least one VarDCT and one Modular
                path.
                """
            method observation
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
    author "grok-build"
    source {
        kind external
        path "sources/outside-advice.md"
        excerpt """
            Phase 0: Instrumentation and matched-quality testing
            """
    }
}

record jpegxl-rs.work.arch-phase1-output-preserving/1 : work {
    title "Phase 1: output-preserving encode speed fixes"
    state active
    intent """
        Output-preserving corrections from sources/outside-advice.md Phase 1:
        exact zero return and precomputed steps in HfQuantizer::choose; bounded
        block_cost and CfL residual cost; precomputed LF X/B factor costs;
        shared modular plane storage (no per-trial deep clone); specialized
        single-leaf residual paths for Gradient/Zero/West. Codestreams must
        stay byte-identical to the pre-Phase-1 encoder for the same requests.
        """
    acceptance {
        check byte-identical-default-paths {
            statement """
                Existing modular and VarDCT encode tests remain green; a golden
                fingerprint check (or unit tests asserting choose/cover identity)
                shows no output change for fixed inputs.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode -p jpxl-encode-policy --lib --release"
        }
        check plane-clone-down {
            statement """
                On a multi-megapixel modular encode, plane_clone_bytes from
                plan_for is far below the Phase-0 ~10GB (shared Arc path).
                """
            method observation
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
    author "grok-build"
    source {
        kind external
        path "sources/outside-advice.md"
        excerpt """
            Phase 1: Output-preserving corrections
            """
    }
}

record jpegxl-rs.work.arch-phase2-cfl-quant/1 : work {
    title "Phase 2: analytic CfL and once-final HF quant unit of work"
    state superseded
    intent """
        Replace frame-sized CflSample storage and per-candidate scalar choose
        refinement with closed-form tile CfL (CflAccumulator sufficient stats)
        and keep final HF quantization only on the selected cover. Optionally
        tighten final quant as a block/lane loop. Deterministic Contract A
        identity across threads is preserved. Codestreams may change vs Phase 1.
        """
    acceptance {
        check choose-cfl-down {
            statement """
                On 12 MP VarDCT defaults, choose_cfl_y and choose_cfl_factor are
                near zero (analytic path); choose_total is dominated by cover+final.
                """
            method observation
        }
        check tests-green {
            statement """
                jpxl-encode-policy and jpxl-encode lib tests pass in release.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode -p jpxl-encode-policy --lib --release"
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
    author "grok-build"
    source {
        kind external
        path "sources/outside-advice.md"
        excerpt """
            Phase 2: Replace the VarDCT quant/CfL unit of work
            """
    }
}

record jpegxl-rs.work.arch-phase2-cfl-quant/2 : work {
    title "Phase 2: analytic CfL and once-final HF quant unit of work"
    state completed
    intent """
        Replace frame-sized CflSample storage and per-candidate scalar choose
        refinement with closed-form tile CfL (CflAccumulator sufficient stats)
        and keep final HF quantization only on the selected cover. Optionally
        tighten final quant as a block/lane loop. Deterministic Contract A
        identity across threads is preserved. Codestreams may change vs Phase 1.
        """
    note """
        2026-08-07: two attempts to score the HF CfL factor purely from
        CflAccumulator's 3 sufficient statistics (no per-sample exact scoring)
        each regressed a real test -- see
        jpegxl-rs.evidence.phase2-analytic-cfl-regressed-correctness. The
        original choose-cfl-down acceptance check (near-zero choose_cfl_y and
        choose_cfl_factor) is not safely reachable without either richer
        per-tile statistics than a 2nd-moment regression, or a calibrated rate
        model built against the matched-quality harness outside-advice.md §19
        describes. Landed instead: factor_candidates window narrowed ±4 -> ±1,
        plus an exact-LS-neutral (seed==0) shortcut -- both still exact-oracle
        scored, just over fewer candidates, so no calibration risk.
        choose_total -39%, choose_cfl_factor -71%, tests green. Re-open the
        full analytic-CfL elimination only alongside Phase 0's matched-quality
        harness (or a richer per-tile summary), not as an isolated heuristic
        guess.
        """
    acceptance {
        check choose-cfl-down {
            statement """
                factor_candidates' search window is narrowed to seed±1 (from ±4) and refine_hf_factor short-circuits to the neutral factor when the closed-form least-squares seed is already 0, cutting choose_cfl_factor calls without changing the exact per-sample scoring semantics. Full elimination of choose_cfl_y/choose_cfl_factor is deferred -- see the note.
                """
            method observation
            verified_by [
                @jpegxl-rs.evidence.phase2-safe-window-narrowing-landed/1,
                @jpegxl-rs.evidence.phase2-safe-window-narrowing-landed-postcommit/1
            ]
        }
        check tests-green {
            statement """
                jpxl-encode-policy and jpxl-encode lib tests pass in release.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode -p jpxl-encode-policy --lib --release"
            verified_by [
                @jpegxl-rs.evidence.phase2-safe-window-narrowing-landed/1,
                @jpegxl-rs.evidence.phase2-safe-window-narrowing-landed-postcommit/1
            ]
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supersedes [ @jpegxl-rs.work.arch-phase2-cfl-quant/1 ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
}

record jpegxl-rs.work.arch-phase3-forward-cache/1 : work {
    title "Phase 3: eliminate the selected-forward clone; borrow from CandidateForwardCache"
    state completed
    intent """
        outside-advice.md §7 flags two redundant retentions of full per-candidate
        HF coefficient vectors: CandidateForwardCache (every scored cover candidate,
        frame-wide, ~428 MB at 12 MP) and forward_selected's second owned clone of
        just the selected varblocks (~144 MB at 12 MP). This work eliminates the
        second one: split cover selection's per-group loop into two passes so every
        selected varblock's forward can be *borrowed* from CandidateForwardCache
        (now exposing a read-only get()) instead of cloned into groups. The first
        retention (CandidateForwardCache itself, which must keep every scored
        candidate -- winners and losers -- because the rate loop shares one cache
        across quantizer probes to avoid re-running the forward DCT per probe) is
        explicitly NOT touched by this work; see the note for why a naive LRU/FIFO
        cap on it is risky (could gut cross-probe reuse for RateSearchBudget's up to
        40 probes) and deferred pending a design that understands the rate loop's
        access pattern.
        """
    note """
        2026-08-07: landed the safe half (selected-forward clone). Verified
        output-preserving by construction (pure ownership/borrow restructuring, no
        decision logic touched) and confirmed via --diag fingerprint identity: 12MP
        vardct-fixed threads=1 output_bytes and fingerprint unchanged
        (1,530,188 / 30e55ba3faef4d64) both before and after, sel_clones/sel_bytes
        41,949/144,000,000 -> 0/0. All jpxl-encode + jpxl-encode-policy lib, oracle,
        roundtrip and rate_loop tests pass (the one pre-existing
        both_oracles_decode_a_stream_from_the_hf_mul_segment failure is unrelated,
        see jpegxl-rs.work.arch-phase2-cfl-quant's note).

        CandidateForwardCache itself (the ~428 MB frame-wide candidate retention,
        the larger of outside-advice §7's two numbers) is unaddressed. It backs
        cross-probe reuse in the rate loop (crates/jpxl-encode-policy/src/rate.rs:589
        keeps one CandidateForwardCache across all quantizer probes of one encode,
        so a probe's cover search can skip re-running the forward DCT for positions
        a prior probe already scored). A bounded cap (LRU/FIFO) risks evicting
        exactly the entries a later probe needs, which for RateSearchBudget's up to
        ~40 probes could turn a cache hit into 40x the forward-DCT work -- a real
        wall-clock regression, not just a missed win. A safe reduction here needs
        either: (a) a cap sized/validated against actual rate-loop access patterns
        (measure hit-rate degradation, not just implement and hope), or (b) the
        fuller outside-advice §8 redesign -- compact per-candidate summaries
        (estimated_rate/distortion/band_energy, not raw coefficient vectors) scored
        during cover search, with only the winning transform's exact coefficients
        ever materialized. (b) is the architecturally 'right' answer per outside-
        advice but is a much bigger change (touches block_cost/tile_region's
        candidate representation, not just an ownership pattern) and should get its
        own scoped work item rather than being bolted onto this one.
        """
    acceptance {
        check clone-eliminated {
            statement """
                --diag on a 12 MP VarDCT encode reports sel_clones=0 and sel_bytes=0.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1 ]
        }
        check output-unchanged {
            statement """
                The --diag fingerprint and output_bytes for a fixed 12 MP vardct-fixed encode are identical before and after (pure representational change, no decision logic touched).
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1 ]
        }
        check tests-green {
            statement """
                jpxl-encode-policy and jpxl-encode lib, oracle, roundtrip and rate_loop tests pass (modulo the pre-existing, unrelated both_oracles_decode_a_stream_from_the_hf_mul_segment failure).
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode -p jpxl-encode-policy --lib --release && cargo test -p jpxl-encode-policy --test vardct_oracle --test vardct_roundtrip --test rate_loop"
            verified_by [ @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1 ]
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
    source {
        kind external
        path "sources/outside-advice.md"
        excerpt """
            Section 7: The current forward cache is counterproductive
            """
    }
}

record jpegxl-rs.work.dispose-performance-md/1 : work {
    title "Dispose PERFORMANCE.md into AKR and scratch"
    state superseded
    intent """
        Migrate durable PERFORMANCE.md content into AKR (baseline rules, jpxl bench
        entry points, retirement decision, preopt observations) and keep full raw
        measurements only under .agent/scratch/. Replace PERFORMANCE.md with a short
        stub. Do not implement encoder optimizations as part of this work.
