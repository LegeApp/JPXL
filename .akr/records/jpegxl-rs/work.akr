record jpegxl-rs.work.arch-phase5a-aq-policy-gate/1 : work {
    title "Phase 5A: replace one-pass AQ guesswork with a corpus-gated perceptual policy"
    state completed
    scope [
        path ".agent/scratch/**",
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode-policy/src/field.rs",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/request.rs",
        path "test-set/**"
    ]
    intent """
        Start Phase 5 perceptual parity by broadening the verified AQ-off result across representative test-set photographs at matched bitrate, exposing the already-implemented Off/Masking/Uniform policies as explicit research controls, and only changing the production default when Butteraugli evidence demonstrates a corpus-level win without a material regression. Retuning the existing single-pass activity constants is out of scope because Phase 4J showed every nonzero tuning clustering behind AQ-off; measured multi-pass signals remain the next candidate if neither static direction clears the gate.
        """
    note """
        Speed is diagnostic only for this quality-first phase. libjxl remains a black-box rate/distortion oracle; no source inspection.
        """
    acceptance {
        check corpus-butteraugli {
            statement """
                At least three representative test-set photographs are encoded at matched target rates and decoded, with bytes, Butteraugli distance, and SSIMULACRA2 recorded for each AQ policy.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5a-aq-policy-gate-2026-08-11 ]
        }
        check correctness {
            statement """
                The selected implementation passes targeted policy/CLI tests and both the in-project decoder and djxl oracle on the measured corpus.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase5-scoped-tests-2026-08-11 ]
        }
        check default-gate {
            statement """
                Any production-default change is supported by aggregate and per-image Butteraugli results and no material per-image regression; otherwise the current default is left unchanged and the negative result is recorded.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5a-aq-policy-gate-2026-08-11 ]
        }
        check mode-control {
            statement """
                The CLI can select Off, Masking, and Uniform AQ for lossy research encodes while the untouched request remains byte-identical to the current default.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-cli"
            verified_by [ @jpegxl-rs.evidence.phase5-scoped-tests-2026-08-11 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase4j-aq-tuning-measurable ]
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.clean-room-boundary,
        @jpegxl-rs.policy.research-out-of-core
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

record jpegxl-rs.work.arch-phase5b-restoration-screen/1 : work {
    title "Phase 5B: screen decoder restoration as a Butteraugli lever"
    state completed
    scope [
        path ".agent/scratch/**",
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/request.rs",
        path "JPXL/crates/jpxl-encode/src/vardct/gaborish.rs",
        path "JPXL/crates/jpxl-encode/src/vardct/headers.rs",
        path "test-set/**"
    ]
    intent """
        Expose the already-implemented, standards-derived Gaborish decision as a research-only lossy CLI control, then compare Off versus Gaborish at matched target rate using the Phase 5A AQ winner and symmetric djxl decoding. Keep it only if Butteraugli improves without a material per-image regression. EPF remains separately scoped because the encoder has no inverse/preconditioning model for it.
        """
    note """
        This is a quality screen, not restoration architecture completion. libjxl is used only as a black-box decoder and quality oracle.
        """
    acceptance {
        check butteraugli-screen {
            statement """
                At least two distinct test-set photographs are encoded at matched target rate with Gaborish off and on, decoded through the same djxl oracle, and compared with Butteraugli and SSIMULACRA2.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5b-gaborish-negative-2026-08-11 ]
        }
        check gaborish-control {
            statement """
                The CLI can enable Gaborish on lossy research encodes while untouched requests remain restoration-off.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode-policy -p jpxl-cli"
            verified_by [ @jpegxl-rs.evidence.phase5-scoped-tests-2026-08-11 ]
        }
        check promotion-gate {
            statement """
                Gaborish is promoted only if the multi-image Butteraugli screen improves without a material per-image regression; otherwise the negative result is recorded and the production default remains off.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5b-gaborish-negative-2026-08-11 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase5a-aq-policy-gate ]
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.clean-room-boundary
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

record jpegxl-rs.work.arch-phase5c-lf-hf-balance-screen/1 : work {
    title "Phase 5C: screen LF/HF balance at matched rate"
    state superseded
    scope [
        path ".agent/scratch/**",
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode-policy/src/rate.rs",
        path "JPXL/crates/jpxl-encode-policy/src/request.rs",
        path "test-set/**"
    ]
    intent """
        Expose a fixed quant_lf research control that disables the secondary LF byte-fill search, then sweep representable LF/HF balances at matched target rate using AQ Off and symmetric djxl decoding. The production rate loop currently maximises feasible bytes rather than perceptual quality, so this screen tests whether its fixed/default LF allocation is a major Butteraugli lever before building any perceptual finalist selector.
        """
    note """
        The control is retained only if it supports reproducible quality calibration; the production default changes only on a multi-image Butteraugli gate.
        """
    acceptance {
        check fixed-lf-control {
            statement """
                A lossy research encode can set quant_lf while disabling LF-fill probes, and an untouched request retains the existing rate-search behavior.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode-policy -p jpxl-cli"
        }
        check matched-rate-sweep {
            statement """
                At least two distinct test-set photographs are swept across coarse, default, and fine LF settings at matched target rate, decoded through djxl, and scored with Butteraugli and SSIMULACRA2.
                """
            method observation
        }
        check promotion-gate {
            statement """
                Any production LF/HF policy change is supported by a multi-image Butteraugli win without a material per-image regression; otherwise the negative or image-dependent result is recorded.
                """
            method observation
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase5a-aq-policy-gate ]
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.clean-room-boundary
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

