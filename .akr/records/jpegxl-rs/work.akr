record jpegxl-rs.work.arch-phase14-region-cover-parallel/1 : work {
    title "Phase 14: intra-group cover region parallelism"
    state completed
    scope [ path "JPXL/crates/jpxl-encode-policy/src/lib.rs", path "JPXL/docs/optimize.md" ]
    intent """
        Close the four-thread utilization gap on frames with fewer LF groups than workers. Prefill each underfilled group's complete square-transform candidate cache once, then score its independent aligned 32x32 cover regions through immutable cache reads on the existing request executor and reduce in raster order. Preserve the current lazy group path when LF groups already saturate workers and retain only if output is byte-identical and mid-size speed materially improves without a large-image regression.
        """
    acceptance {
        check determinism {
            statement """
                Serial and four-thread cover planning produce byte-identical Fast and Quality codestreams on multi-group and canonical inputs.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase14-determinism-2026-08-15/1 ]
        }
        check gates {
            statement """
                Workspace build, tests, formatting, no-default-features check, lint-delta review, and AKR validation pass or isolate pre-existing blockers.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase14-gates-2026-08-15/1 ]
        }
        check speed {
            statement """
                Fresh interleaved timing shows a material 2400x1800 improvement and no material 4000x3000 regression against Phase 13.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase14-speed-2026-08-15/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase13-quant-scratch-overwrite ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

record jpegxl-rs.work.arch-phase15-fast-entropy/1 : work {
    title "Phase 15: Fast entropy and structural speed tier"
    state completed
    scope [
        path "JPXL/crates/jpxl-encode-policy/src/entropy.rs",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/docs/optimize.md"
    ]
    intent "Make the Fast preset a deliberate speed tier: retain deterministic clustered entropy training with only the legacy default hybrid-uint configuration, fixed DCT8x8 cover selection, and nearest HF quantization during Fast probes. Keep Quality and Full entropy, hierarchical cover search, and trailing quantization exhaustive. Retain the change only if Fast codestreams remain valid, target-safe, deterministic, and materially faster while Quality remains byte-identical."
    acceptance {
        check determinism {
            statement """
                Fast and Quality codestreams remain byte-identical across one and four threads on canonical and multi-group inputs, and every Fast output remains decodable.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase15-determinism-2026-08-15/1 ]
        }
        check gates {
            statement """
                Workspace build, tests, formatting, no-default-features check, lint-delta review, and AKR validation pass or isolate pre-existing blockers.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase15-gates-2026-08-15/1 ]
        }
        check quality {
            statement """
                Matched-quality Fast output remains target-safe and its SSIMULACRA2/Butteraugli deltas are recorded against the Phase 14 baseline; Quality remains unchanged.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase15-quality-2026-08-15/1 ]
        }
        check speed {
            statement """
                Fresh interleaved PGO timing shows a material Fast improvement at 2400x1800 without a material 4000x3000 regression.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase15-speed-2026-08-15/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase14-region-cover-parallel ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

record jpegxl-rs.work.arch-phase16-fast-anchor/1 : work {
    title "Phase 16: Fast anchor reuse"
    state completed
    scope [
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/rate.rs",
        path "JPXL/docs/optimize.md"
    ]
    intent "Reduce Fast-preset structural multiplicity by reusing its captured neutral-CfL anchor for the final relaxed-quality candidate, while leaving Quality/Full exhaustive and byte-identical. Retain only if Fast remains target-safe, deterministic, decodable, and materially faster without a catastrophic perceptual regression; document the deliberate Fast quality trade and keep the high-quality path available."
    acceptance {
        check determinism {
            statement """
                Fast outputs are deterministic across repeated one- and four-thread runs and decode successfully on the canonical mid and large photographs; Quality output remains unchanged.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase16-determinism-2026-08-15/1 ]
        }
        check gates {
            statement """
                Workspace build, tests, formatting, no-default-features check, and AKR validation pass; any pre-existing strict Clippy diagnostics are isolated.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase16-gates-2026-08-15/1 ]
        }
        check quality {
            statement """
                Fast target adherence and SSIMULACRA2, Butteraugli, PSNR, and pnorm3 are recorded against the Phase 15 Fast output, with no catastrophic regression; Quality remains the higher-quality fallback.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase16-quality-2026-08-15/1 ]
        }
        check speed {
            statement """
                Interleaved release or PGO timing shows a material Fast speed improvement on both canonical size classes and remains within the stated parity band against cjxl at the same relaxed operating point.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase16-speed-2026-08-15/1 ]
        }
    }
}

record jpegxl-rs.work.arch-phase17-quality-speed-preset/1 : work {
    title "Phase 17: Hierarchical anchored speed preset"
    state completed
    scope [
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/rate.rs",
        path "JPXL/crates/jpxl-encode-policy/src/request.rs",
        path "JPXL/crates/jpxl-encode-policy/tests/rate_loop.rs",
        path "JPXL/docs/optimize.md"
    ]
    intent "Reduce equivalent-quality rate-loop multiplicity by screening a measured hierarchical anchored speed preset. Balanced keeps the configured hierarchical cover, CfL, and trailing quantizer, reuses one structural anchor across bounded navigation/final probes, and uses fast entropy for the anchored finalist; Quality remains the exhaustive full-entropy reference and Fast remains the relaxed fixed-cover tier. Retain only if Balanced stays target-safe, decodable, deterministic, and perceptually near Quality while materially reducing time; otherwise record the negative result."
    acceptance {
        check correctness {
            statement """
                Balanced remains deterministic across one/four threads, never exceeds target, decodes through djxl, and the exhaustive Quality output remains unchanged. Non-photo corpus classes may fall back, but fallback output must remain the Quality stream.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase17-correctness-2026-08-15/1 ]
        }
        check gates {
            statement """
                Workspace build, tests, formatting, no-default-features check, and AKR validation pass; pre-existing strict Clippy diagnostics remain isolated if unchanged.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase17-gates-2026-08-15/1 ]
        }
        check quality {
            statement """
                Balanced is compared against exhaustive Quality and cjxl at matched target on both canonical photographs with SSIMULACRA2, Butteraugli, pnorm3, PSNR, bytes, and decoded pixels recorded; the observed metric trade is documented.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase17-quality-2026-08-15/1 ]
        }
        check speed {
            statement """
                Four-thread timing records Balanced against exhaustive Quality and cjxl on both canonical size classes, with raw logs, binary hashes, diagnostics, and a flamegraph profile.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase17-speed-2026-08-15/1 ]
        }
    }
}

record jpegxl-rs.work.arch-phase18-balanced-entropy-reuse/1 : work {
    title "Phase 18: Reuse Balanced anchor entropy model"
    state completed
    scope [
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/rate.rs",
        path "JPXL/crates/jpxl-encode-policy/tests/rate_loop.rs",
        path "JPXL/docs/optimize.md"
    ]
    intent "Reduce repeated Balanced rate-probe work by training one fast entropy model on the first anchored plan and reusing that validated model for the second anchor, finalist, and correction. Keep Fast byte-identical and Quality exhaustive; retain the reuse only if exact writer sizing, target safety, decoder acceptance, deterministic output, and measured perceptual quality remain acceptable while the canonical speed gap materially narrows."
    acceptance {
        check correctness {
            statement """
                Balanced is deterministic across one/four threads, never exceeds its target, decodes through djxl, and non-photo fallback paths preserve their prior Quality streams; Fast and Quality reference outputs remain byte-identical.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase18-correctness-2026-08-15/1 ]
        }
        check gates {
            statement """
                Workspace build, tests, formatting, no-default-features check, and AKR validation pass; any unchanged strict Clippy diagnostics remain isolated and documented.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase18-gates-2026-08-15/1 ]
        }
        check quality {
            statement """
                Balanced is compared with the retained Phase 17 Balanced/Quality references on both canonical photographs and representative fallback corpus inputs using bytes, PSNR, SSIMULACRA2, Butteraugli, pnorm3, and decoded-pixel acceptance; any trade is recorded.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase18-quality-2026-08-15/1 ]
        }
        check speed {
            statement """
                Pinned interleaved four-thread timings and focused diagnostics show the repeated entropy census/training multiplicity removed, with raw logs and binary/input hashes retained under .agent/scratch.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase18-speed-2026-08-15/1 ]
        }
    }
}

record jpegxl-rs.work.arch-phase19-dequant-matrix-reuse/1 : work {
    title "Phase 19: reuse dequantization matrices across quantizer lanes"
    state completed
    scope [
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/quantize.rs",
        path "JPXL/docs/optimize.md"
    ]
    intent "Remove output-preserving construction work from HfQuantizers: build each default dequantization matrix once per transform and reuse it across the transform's HfMul lanes, while keeping the public single-quantizer constructor and every emitted integer byte-identical. Measure whether this lower-risk cleanup improves the Balanced and Fast target-rate paths before attempting spatial or quality-policy changes."
    acceptance {
        check gates {
            statement """
                Workspace build, no-default-features check, formatting, and AKR validation pass; unchanged strict Clippy blockers remain isolated.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase19-gates-2026-08-15/1 ]
        }
        check identity {
            statement """
                Canonical Fast, Balanced, and exhaustive Quality streams remain byte-identical to the Phase 18 commit, and the quantizer unit tests continue to prove decoder reconstruction choices.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase19-identity-2026-08-15/1 ]
        }
        check safety {
            statement """
                Workspace tests, independent decoder/oracle checks, and deterministic one/four-thread encodes remain green with no target-rate regressions.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase19-safety-2026-08-15/1 ]
        }
        check speed {
            statement """
                A pinned before/after release comparison records the construction change's wall-time effect and diagnostics; retain the change only if it is neutral or improves the measured target-rate path.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase19-speed-2026-08-15/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase18-balanced-entropy-reuse ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

record jpegxl-rs.work.arch-phase1b-opt-in-diagnostics/1 : work {
    title "Phase 1B: make architecture diagnostics opt-in"
    state superseded
    scope [
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode-policy/src/diagnostics.rs",
        path "JPXL/crates/jpxl-encode/src/lossless.rs"
    ]
    intent """
        Phase 0 counters currently update thread-local cells on every scalar quantizer choice and modular planning event even when no caller reads diagnostics. Add explicit scoped enablement for jpxl bench --diag; default encoding must skip counter updates and stage timers while producing identical bytes.
        """
    acceptance {
        check default-output-identical {
            statement """
                With diagnostics disabled by default, fixed VarDCT and Modular benchmark output fingerprints remain identical to the Phase 0 baseline and encoder library tests pass.
                """
            method command
        }
        check diag-still-available {
            statement """
                Release jpxl bench --diag still reports nonzero choose_total for vardct-fixed and residual_scans or plane_clone_bytes for modular.
                """
            method command
        }
        check overhead-measured {
            statement """
                A matched 12 MP serial comparison records wall time before and after opt-in diagnostics, with any speed change reported honestly.
                """
            method observation
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.optimization-correctness-gates
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

