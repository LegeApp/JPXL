record jpegxl-rs.work.arch-phase8-6-finalist-measured-hf-allocation/1 : work {
    title "Phase 8.6: prototype finalist-measured HF allocation"
    state abandoned
    scope [
        path ".agent/scratch/**",
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode-policy/src/field.rs",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/rate.rs",
        path "JPXL/crates/jpxl-encode-policy/src/request.rs"
    ]
    intent """
        Build and evaluate a default-off, speed-compatible measured high-frequency allocator before deciding whether this missing architecture should replace uniform target-rate allocation.
        """
    note """
        Prototype removed after the fixed-rate screen found no multi-metric operating point: isolated Butteraugli-max gains always traded against SSIMULACRA2 or pnorm3, and the fifth exact candidate added material runtime. Evidence: @jpegxl-rs.evidence.phase8-6-measured-hf-quality-screen-2026-08-14/1, @jpegxl-rs.evidence.phase8-6-measured-hf-speed-screen-2026-08-14/1, @jpegxl-rs.evidence.phase8-6-measured-hf-removal-2026-08-14/1.
        """
    acceptance {
        check fixed-rate-quality {
            statement """
                A fixed-rate corpus screen reports SSIMULACRA2, Butteraugli maximum and pnorm3 for baseline and measured allocation and reaches an explicit keep/remove decision.
                """
            method observation
        }
        check prototype-correct {
            statement """
                The default-off path is byte-identical, the measured field is deterministic and bounded, decoded outputs are valid, and workspace tests/clippy/fmt pass.
                """
            method command
        }
        check speed-bounded {
            statement """
                The prototype adds no cover, DCT or CfL pass; exact-candidate count and end-to-end overhead are measured and disclosed.
                """
            method observation
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase8-6-butteraugli-localization/2 ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
}

record jpegxl-rs.work.arch-phase9-quant-scheduling/1 : work {
    title "Phase 9: deterministic quantization scheduling"
    state completed
    intent """
        Continue the profile-backed quantization architecture work after Phase 8.5 by evaluating finer deterministic scheduling even when LF-group count equals worker count. Retain a scheduling change only if interleaved end-to-end A/B improves production-quality target-rate encoding while every candidate stream remains byte-identical to the immutable baseline.
        """
