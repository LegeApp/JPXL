        path "JPXL/crates/jpxl-encode/src/vardct/write.rs",
        path "test-set/**"
    ]
    intent """
        Re-open the Phase 5O same-8x8-footprint transform experiment behind a research-only mode, but score each special candidate with exact inverse-transform reconstruction error in sample space rather than the square-DCT coefficient-SSE side-squared approximation. Keep exact local residual-bit terms and a bounded DctSelect transition proxy, prove wire/rate/oracle behavior, then screen the Phase 5O regressors and strongest winners before a full six-scene gate. Remove the temporary mode if exact distortion does not eliminate Butteraugli regressions.
        """
    acceptance {
        check distortion-proof {
            statement """
                Tests compare the exact sample-domain scorer to direct inverse-reconstruction SSE and show at least one special transform is not silently treated as a square-DCT Parseval case.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase5p-distortion-proof-2026-08-12 ]
        }
        check policy-decision {
            statement """
                Production changes only if the full matrix has no Butteraugli regression under an explicit Contract B; otherwise the research mode is removed and production fingerprint restored.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5p-policy-decision-2026-08-12 ]
        }
        check quality-screen {
            statement """
                Pre-registered Phase 5O regressors and winners are scored symmetrically at production byte caps; a full matrix is run only if direction is non-regressing.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5p-quality-screen-2026-08-12 ]
        }
        check rate-oracle {
            statement """
                An active exact-distortion special-transform stream stays under target and decodes consistently in djxl and jxl-oxide.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase5p-rate-oracle-2026-08-12 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase5o-special8-transform-screen ]
