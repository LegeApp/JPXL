record jpegxl-rs.work.arch-phase23-cow-geometry/1 : work {
    title "Phase 23: copy-on-write anchored geometry"
    state completed
    scope [ path "JPXL/crates/jpxl-encode-policy/src/lib.rs", path "JPXL/docs/optimize.md" ]
    intent "Replace deep copies of anchored varblock vectors with immutable shared storage and a copy-on-write HfMul retarget overlay. Fresh plans keep owned vectors; anchored probes share unchanged structural decisions and materialize only groups whose quantizer-dependent HfMul values differ. Preserve output bytes, decoder behavior, thread determinism, and the current AnchorReuse semantics."
    note "This is the first bounded slice toward immutable structural geometry plus a quantizer-dependent HfMul overlay. It does not yet change cover selection, CfL, quantization rules, entropy choices, or the wire-facing plan."
    acceptance {
        check gates {
            statement """
                Workspace build, tests, no-default-features check, formatting, and AKR validation pass; strict Clippy remains isolated to pre-existing blockers.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase23-gates-2026-08-15/1 ]
        }
        check identity {
            statement """
                Canonical Fast, Balanced, Quality, fallback, one-group, and masking-AQ streams remain byte-identical; decoded pixels and fingerprints are unchanged.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase23-identity-2026-08-15/1 ]
        }
        check safety {
            statement """
                Focused policy tests, workspace tests, and oracle-backed decoder checks pass; shared storage cannot mutate the captured structure through a probe.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase23-safety-2026-08-15/1 ]
        }
        check speed {
            statement """
                Pinned interleaved Balanced timing measures the anchored copy-on-write path on canonical mid and large inputs with binary/input hashes and dispersion.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase23-speed-2026-08-15/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase22-cfl-arc ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

record jpegxl-rs.work.arch-phase24-hfmul-overlay/1 : work {
    title "Phase 24: compact per-probe HfMul overlay"
    state superseded
    scope [
        path "JPXL/Cargo.toml",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/docs/optimize.md"
    ]
    intent """
        Replace Phase 23's copy-on-write HfMul retarget (which materialized an
        owned copy of a whole group's VarblockDecision vector when any multiplier
        moved) with a dense Box<[HfMul]> overlay layered over the shared immutable
        decisions. Geometry reads keep using the base decisions; multiplier reads
        resolve through hf_mul_at / PlannedVarblockRange. Groups whose multipliers
        did not move keep their shared storage untouched, and capturing an anchor
        applies the overlay before freezing the base. Also carries the workspace
        version bump to 0.3.0. Preserve output bytes, decoder behavior, thread
        determinism, and AnchorReuse semantics.
        """
    note """
        Bounded slice: no change to cover selection, CfL, quantization rules,
        entropy choices, or the wire-facing plan beyond ownership of the HfMul
        values. The speed check is the only open acceptance item: both pinned
        A/B attempts on 2026-08-16 ran against heavy competing host load, and
        the Balanced path never exercises the overlay anyway (neutral AQ keeps
        the desired multipliers equal, so Phase 23's CoW path is taken). The
        definitive pass must also time a masking-AQ stream, which is what
        actually exercises the overlay, on a quiet host.
        """
    acceptance {
        check gates {
            statement """
                Workspace build, tests, no-default-features check, formatting, and AKR validation pass; strict Clippy remains isolated to pre-existing blockers.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase24-gates-2026-08-16/1 ]
        }
        check identity {
            statement """
                Canonical Fast, Balanced, Quality, and masking-AQ streams remain byte-identical to Phase 23; decoded pixels and fingerprints are unchanged.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase24-identity-2026-08-16/1 ]
        }
        check safety {
            statement """
                Focused policy tests, workspace tests, and oracle-backed decoder checks pass; the overlay cannot mutate the captured base decisions and length mismatches are rejected, not truncated.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase24-safety-2026-08-16/1 ]
        }
        check speed {
            statement """
                Pinned interleaved Balanced timing measures the overlay retarget path on canonical mid and large inputs with binary/input hashes and dispersion, run without competing load.
                """
            method observation
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase23-cow-geometry ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

