    part_of [ @jpegxl-rs.milestone.m-opt-vardct-structure ]
    supersedes [ @jpegxl-rs.work.opt-v1-count-only-and-arenas/1 ]
}

record jpegxl-rs.work.opt-v2-rate-work-sharing/1 : work {
    title "Opt-V2 PreparedSearch and Fast/Full rate pricing"
    state superseded
    intent """
        Implement Opt-V2 rate-loop work sharing: PreparedSearch (shared geometry,
        preconditioned frame, analysis, cross-probe CandidateForwardCache) vs per-probe
        quantizer work; Fast entropy ladder for bracket/bisect/fill; Full entropy
        refinement only for finalist rungs; RateProbeStats multiplicity counters for
        the rate-probe-multiplicity-down acceptance gate.
        """
    acceptance {
        check multiplicity-test {
            statement """
                rate_probe_multiplicity_is_down and the full rate_loop suite pass;
                RateProbeStats shows gaborish once, DCT cache reuse, Full confined
                to refinement.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode-policy --test rate_loop"
            verified_by [ @jpegxl-rs.evidence.opt-v2-rate-probe-multiplicity/1 ]
        }
    }
    part_of [ @jpegxl-rs.milestone.m-opt-vardct-rate ]
}

