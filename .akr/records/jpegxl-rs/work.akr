record jpegxl-rs.work.arch-phase8-3-anchor-sketch/1 : work {
    title "Phase 8.3: anchor-and-sketch target-rate search"
    state completed
    scope [ path "JPXL/crates/jpxl-cli/**", path "JPXL/crates/jpxl-encode-policy/**" ]
    intent """
        Add a feature-gated structural anchor and context-aware RateSketch search with exact finalist replanning and exhaustive fallback. Normal-path budgets are at most two structural builds, two Full entropy searches, four exact candidates, and one final Store. Promotion requires target adherence, fallback <=5%, no per-cell SSIMULACRA2 regression beyond 0.25, and non-regressing corpus mean.
        """
    acceptance {
        check probe-collapse {
            statement """
                Normal-path structural and exact probe counts meet the stated budgets with fallback at or below 5%.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase8-3-windows-speed/1 ]
        }
        check rate-and-quality {
            statement """
                Across the promotion corpus, output never exceeds target, undershoot meets the existing tolerance, SSIMULACRA2 regresses by no more than 0.25 per cell and not in aggregate, and all secondary metrics are reported.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase8-3-quality-screen/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase8-2-dense-group-banks ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

record jpegxl-rs.work.arch-phase8-4-finalist-token-tape/1 : work {
    title "Phase 8.4: finalist-only entropy and shared token tape"
    state superseded
    scope [
        path "JPXL/crates/jpxl-encode-policy/**",
        path "JPXL/crates/jpxl-encode/src/vardct/**"
    ]
    intent """
        Confine entropy alternatives to one or two finalists and share a typed per-section token tape between training and exact Count/Store. Compare Store-every-finalist with Count-then-Store-one; require a 3% end-to-end win before changing policy.
