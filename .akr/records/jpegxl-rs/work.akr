akr 0.1
project jpegxl-rs

record jpegxl-rs.work.arch-phase0-instrumentation/1 : work {
    title "Phase 0: encode diagnostics and thread-scaling counters"
    state completed
    intent """
        Instrument VarDCT plan stages (choose calls by cover/cfl_y/cfl_factor/final,
        stage wall times, candidate-forward and CfL sample memory proxies) and
        Modular plan multiplicity (residual scans, plane clone bytes). Expose via
        jpxl bench --diag. Measure 12 MP one-thread vs auto-thread for modular and
        vardct-fixed. Do not change encode outputs in this work.
        """
    acceptance {
        check counters-available {
            statement """
                jpxl bench --diag prints choose_total (or residual_scans) on a
                release binary for modular and vardct-fixed modes.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase0-diag-available-2026-08-13/1 ]
        }
        check twelve-mp-diag-logged {
            statement """
                A scratch log under .agent/scratch/ records 12 MP diag lines for
                threads=1 and threads=auto for at least one VarDCT and one Modular
                path.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase0-12mp-thread-scaling-2026-08-13/1 ]
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
    author "grok-build"
    source {
        kind external
        path "sources/outside-advice.md"
        excerpt """
            Phase 0: Instrumentation and matched-quality testing
            """
    }
}

record jpegxl-rs.work.arch-phase1-output-preserving/1 : work {
    title "Phase 1: output-preserving encode speed fixes"
    state completed
    intent """
        Output-preserving corrections from sources/outside-advice.md Phase 1:
        exact zero return and precomputed steps in HfQuantizer::choose; bounded
        block_cost and CfL residual cost; precomputed LF X/B factor costs;
        shared modular plane storage (no per-trial deep clone); specialized
        single-leaf residual paths for Gradient/Zero/West. Codestreams must
        stay byte-identical to the pre-Phase-1 encoder for the same requests.
        """
    acceptance {
        check byte-identical-default-paths {
            statement """
                Existing modular and VarDCT encode tests remain green; a golden
                fingerprint check (or unit tests asserting choose/cover identity)
                shows no output change for fixed inputs.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode -p jpxl-encode-policy --lib --release"
            verified_by [ @jpegxl-rs.evidence.phase1-default-paths-current-2026-08-13/1 ]
        }
        check plane-clone-down {
            statement """
                On a multi-megapixel modular encode, plane_clone_bytes from
                plan_for is far below the Phase-0 ~10GB (shared Arc path).
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase1-plane-clones-current-2026-08-13/1 ]
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
    author "grok-build"
    source {
        kind external
        path "sources/outside-advice.md"
        excerpt """
            Phase 1: Output-preserving corrections
            """
    }
}

record jpegxl-rs.work.arch-phase10-two-anchor-prediction/1 : work {
    title "Phase 10: explicit Fast two-anchor preset"
    state completed
    scope [
        path "JPXL/crates/jpxl-cli/Cargo.toml",
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode-policy/Cargo.toml",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/rate.rs",
        path "JPXL/crates/jpxl-encode-policy/src/request.rs",
        path "JPXL/crates/jpxl-encode-policy/tests/rate_loop.rs",
        path "JPXL/docs/optimize.md"
    ]
    intent """
        Add an explicit Fast target-rate preset that uses two exact anchors to predict a default-entropy finalist directly, while preserving the exhaustive controller as the default Quality preset. Fast may trade a wider, documented undershoot band and measured perceptual quality for lower latency, but must verify the final stream exactly, never exceed the target, remain deterministic, and fall back to Quality when its bounded search cannot satisfy its contract.
        """
    acceptance {
        check gates {
            statement """
                Policy tests, independent decoder checks, workspace tests, formatting, lint-delta checks, and AKR validation pass or any pre-existing blockers are explicitly isolated.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase10-two-anchor-gates-2026-08-15/1 ]
        }
        check quality {
            statement """
                Quality remains the unchanged default exhaustive path. Fast's wider rate band, fallback frequency, achieved sizes, and perceptual deltas against Quality are measured on the canonical corpus; the exact final ceiling and independent decoding contract remain mandatory even when quality is traded for speed.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase10-two-anchor-quality-2026-08-15/1 ]
        }
        check speed {
            statement """
                Fresh interleaved A/B on the pinned 4.3 MP and 12 MP photographs shows a material production-style target-rate speed improvement and diagnostics attribute it to fewer navigation quantization and census passes.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase10-two-anchor-speed-2026-08-15/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase9-quant-scheduling ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

record jpegxl-rs.work.arch-phase11-cheap-navigation/1 : work {
    title "Phase 11: neutral-CfL anchors and direct finalist Store"
    state completed
    scope [
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/rate.rs",
        path "JPXL/docs/optimize.md"
    ]
    intent """
        Remove work that cannot affect the Fast preset's returned pixels: keep the production hierarchical cover but use neutral CfL for both navigation anchors, then restore full CfL on the freshly optimized finalist. Verify finalist and correction sizes through their exact retained Store emission so the accepted path does not traverse Count and Store separately. Retain only if the exact ceiling, fallback behavior and perceptual corpus remain sound while fresh interleaved timing improves over Phase 10.
        """
    note """
        Two broader navigation shortcuts were screened and rejected first. Fixed-DCT8x8 anchors improved 4.3 MP by about 4.7% but slowed 12 MP by about 3.8% because merged images paid more quantization and writer work. A single-anchor fixed-slope predictor was fast on the two timing photographs but required correction on six of seven canonical scenes and fell back on one, demonstrating content-dependent rate slopes. Neither rejected variant remains in source.
        """
    acceptance {
        check gates {
            statement """
                Feature/default policy tests, workspace tests, formatting, lint-delta checks and AKR validation pass or pre-existing blockers are explicitly isolated.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase11-gates-2026-08-15/1 ]
        }
        check quality {
            statement """
                The canonical corpus records achieved sizes, fallback frequency, independent decode results, and SSIMULACRA2/Butteraugli deltas against Phase 10; the finalist continues to use freshly optimized production structure.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase11-quality-2026-08-15/1 ]
        }
        check speed {
            statement """
                Fresh interleaved A/B against the Phase 10 Fast preset shows a material end-to-end improvement on the pinned 4.3 MP and 12 MP photographs, with diagnostics confirming removal of navigation CfL and redundant finalist Count work.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase11-speed-2026-08-15/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase10-two-anchor-prediction ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

record jpegxl-rs.work.arch-phase12-contiguous-forward-dct/1 : work {
    title "Phase 12: contiguous forward DCT passes"
    state completed
    scope [ path "JPXL/crates/jpxl-core/src/dct.rs", path "JPXL/docs/optimize.md" ]
    intent """
        Screen a contiguous-pass implementation of the separable forward 2-D DCT identified by the Phase 11 profile. Preserve coefficient orientation, supported shapes, decoder validity, and deterministic behavior; retain the change only if focused kernel tests and fresh end-to-end PGO timing show a material gain without an unacceptable quality or size regression.
        """
    acceptance {
        check gates {
            statement """
                Workspace build, tests, formatting, no-default-features check, lint-delta review, and AKR validation pass or isolate pre-existing blockers.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase12-gates-2026-08-15/1 ]
        }
        check quality {
            statement """
                Independent decode and fixed-rate quality checks record any codestream, achieved-size, SSIMULACRA2, or Butteraugli changes caused by floating-point evaluation order.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase12-quality-2026-08-15/1 ]
        }
        check speed {
            statement """
                Fresh interleaved PGO A/B on the pinned 4.3 MP and 12 MP target-rate photographs measures the end-to-end effect against Phase 11.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase12-speed-2026-08-15/1 ]
        }
        check transform {
            statement """
                Focused transform tests cover every supported rectangular shape, roundtrip tolerances, and coefficient orientation.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase12-transform-2026-08-15/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase11-cheap-navigation ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

