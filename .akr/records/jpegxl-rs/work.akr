            verified_by [ @jpegxl-rs.evidence.phase1b-diag-available-2026-08-13/1 ]
        }
        check overhead-measured {
            statement """
                A matched 12 MP serial comparison records wall time before and after opt-in diagnostics, with any speed change reported honestly.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase1b-overhead-2026-08-13/1 ]
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
