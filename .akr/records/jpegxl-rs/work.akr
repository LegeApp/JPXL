        check probe-collapse {
            statement """
                Normal-path structural and exact probe counts meet the stated budgets with fallback at or below 5%.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase8-3-windows-speed/1 ]
        }
        check rate-and-quality {
            statement """
                Across the promotion corpus, output never exceeds target, undershoot meets the existing tolerance, SSIMULACRA2 regresses by no more than 0.25 per cell and not in aggregate, and all secondary metrics are reported.
