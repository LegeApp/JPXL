record jpegxl-rs.work.arch-phase8-6-butteraugli-localization/1 : work {
    title "Phase 8.6: localize the matched-SSIMULACRA2 Butteraugli deficit"
    state superseded
    scope [
        path ".agent/scratch/**",
        path "JPXL/crates/jpxl-cli/**",
        path "JPXL/crates/jpxl-conformance/**",
        path "JPXL/crates/jpxl-encode-policy/**"
    ]
    intent """
        Before further speed architecture changes, independently validate and localize the large-image Butteraugli deficit at fixed rate and matched SSIMULACRA2, then select a bounded clean-room quality architecture response without weakening speed or correctness gates.
        """
    note """
        The fresh Linux checkpoint measured Butteraugli 2.3292 for JPXL versus 1.4524 for cjxl on 12 MP at SSIMULACRA2 83.5492 versus 83.6969. Historical three-image evidence already found a 39-53% Butteraugli deficit and attributed the metric split to perceptual bit allocation. This work must distinguish metric artifact, spatial/channel/frequency allocation, and restoration-filter effects before implementation.
        """
    acceptance {
        check architecture-brief {
            statement """
                The next implementation brief names its owned files, expected quality mechanism, speed risk, and fixed-rate multi-metric acceptance gate.
                """
            method observation
        }
        check deficit-localized {
            statement """
                Spatial, channel, frequency, and existing policy-control screens identify which error/allocation axes account for the material gap.
                """
            method observation
        }
        check metric-valid {
            statement """
                The large-image Butteraugli gap is reproduced by an independent black-box metric path or any disagreement is explained and bounded.
                """
            method command
        }
    }
    derived_from [
        @jpegxl-rs.evidence.phase8-5-linux-matched-quality-gap-2026-08-14/1,
        @jpegxl-rs.observation.lossy-perceptual-baseline-2026-08-10/1
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

