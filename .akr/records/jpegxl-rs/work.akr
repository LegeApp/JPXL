record jpegxl-rs.work.arch-phase5m-spatial-epf-sharpness-screen/1 : work {
    title "Phase 5M: screen spatial EPF sharpness from source activity"
    state completed
    scope [
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/request.rs",
        path "JPXL/crates/jpxl-encode-policy/tests/vardct_oracle.rs",
        path "test-set/**"
    ]
    intent """
        Add two research-only EPF sharpness policies that split the per-8x8 Sharpness control image at the frame median of source luma variance: Sharpness 7 on the low-activity half and 0 on the high-activity half, plus the inverse polarity as falsification. Screen both with EPF3 on small1 (a Phase 5K winner) and small3 plus mid2 (Phase 5K regressors) at one and two bpp, using symmetric djxl decode and exact measured Butteraugli/SSIMULACRA2. Broaden only if one direction retains the winner and removes both regressors without material SSIM loss; otherwise remove the temporary policies and retain EPF1 Uniform7 production.
        """
    acceptance {
        check policy-decision {
            statement """
                The EPF1 Uniform7 production default remains byte-identical unless a full six-scene promotion gate passes.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5m-spatial-epf-policy-2026-08-11/1 ]
        }
        check quality-screen {
            statement """
                Matched-rate Butteraugli and SSIMULACRA2 on small1, small3, and mid2 at one and two bpp select one spatial policy for broader testing or reject both.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5m-spatial-epf-quality-2026-08-11/1 ]
        }
        check spatial-proof {
            statement """
                Unit and oracle tests prove each research policy emits both legal 0 and 7 sharpness levels in source-activity-dependent spatial positions and remains accepted by djxl and jxl-oxide.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase5m-spatial-epf-wire-2026-08-11/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase5l-chroma-qm-allocation-screen/1 ]
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases/1,
        @jpegxl-rs.policy.optimization-correctness-gates/1
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
}

record jpegxl-rs.work.arch-phase5n-fine-aq-lattice-screen/1 : work {
    title "Phase 5N: screen a fine per-block AQ lattice"
    state completed
    scope [
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode-policy/src/field.rs",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/request.rs",
        path "JPXL/crates/jpxl-encode-policy/tests/rate_loop.rs",
        path "JPXL/crates/jpxl-encode-policy/tests/vardct_oracle.rs",
        path "test-set/**"
    ]
    intent """
        Test whether the existing single-pass AQ signal failed because the wire factorization snapped every atom to a half-octave lattice around HfMul 2. Add temporary fine-lattice Masking and Uniform research modes that preserve the same frame quantizer product with an HfMul baseline of 8, map raw log adjustments to integer HfMul without half-octave snapping, and prebuild the exact reachable integer multiplier range. Screen both directions on small1 and small2 at one and two bpp against the Phase 5I production policy. Broaden only if one direction has no Butteraugli regression and no material SSIMULACRA2 loss; otherwise remove the temporary modes.
        """
    acceptance {
        check lattice-proof {
            statement """
                Tests prove the fine factorization preserves the baseline HF and LF quantizer products, produces more than the coarse lattice's values, stays deterministic and target-safe, and is accepted by djxl and jxl-oxide.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase5n-fine-aq-structure-2026-08-11/1 ]
        }
        check policy-decision {
            statement """
                The AQ-Off production default remains byte-identical unless a full six-scene promotion gate passes.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5n-fine-aq-policy-2026-08-11/1 ]
        }
        check quality-screen {
            statement """
                Matched-rate Butteraugli and SSIMULACRA2 on small1 and small2 at one and two bpp select one fine AQ direction for broader testing or reject both.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5n-fine-aq-quality-2026-08-11/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase5m-spatial-epf-sharpness-screen/1 ]
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases/1,
        @jpegxl-rs.policy.optimization-correctness-gates/1
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
}

