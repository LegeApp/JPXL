    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
}

record jpegxl-rs.work.arch-phase5i-active-epf-screen/1 : work {
    title "Phase 5I: activate EPF sharpness before judging restoration"
    state completed
    scope [
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/request.rs",
        path "JPXL/crates/jpxl-encode-policy/tests/vardct_oracle.rs",
        path "test-set/**"
    ]
    intent """
        Add a research-only target-rate control for EPF iteration count and a uniform Sharpness=7 grid, leaving production restoration off. First prove the decoded stream actually changes and independent decoders accept it. Then screen EPF step 1 at matched achieved rate on the dense-detail and flat/edge 0.8 MP scenes. Broaden to the six-scene matrix only if the two-scene screen has no material Butteraugli regression; otherwise remove or retain only the minimal research control according to the evidence.
        """
    acceptance {
        check activation-proof {
            statement """
                A nonzero Sharpness=7 grid is emitted with epf_iters=1, decoder output differs from EPF off on textured input, and the stream passes the independent-decoder gate.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase5i-active-epf-activation-2026-08-11/1 ]
        }
        check policy-decision {
            statement """
                EPF is broadened, pruned, or retained research-only from the preregistered screen; production behavior changes only after a broader no-regression corpus gate.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5i-active-epf-promotion-2026-08-11/1 ]
        }
        check quality-screen {
            statement """
                EPF step 1 with uniform Sharpness=7 is compared against restoration off at matched achieved rate on at least the dense-detail and flat/edge small scenes using symmetric djxl and Butteraugli.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5i-active-epf-quality-2026-08-11/2 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase5h-quant-lf-tail-gate/1 ]
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases/1,
        @jpegxl-rs.policy.optimization-correctness-gates/1
