    }
    depends_on [ @jpegxl-rs.work.arch-phase8-4-finalist-token-tape ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supersedes [ @jpegxl-rs.work.arch-phase8-5-leaf-finishing/3 ]
}

