akr 0.1
project jpegxl-rs

record jpegxl-rs.work.arch-phase0-instrumentation/1 : work {
    title "Phase 0: encode diagnostics and thread-scaling counters"
    state active
    intent """
        Instrument VarDCT plan stages (choose calls by cover/cfl_y/cfl_factor/final,
        stage wall times, candidate-forward and CfL sample memory proxies) and
        Modular plan multiplicity (residual scans, plane clone bytes). Expose via
        jpxl bench --diag. Measure 12 MP one-thread vs auto-thread for modular and
        vardct-fixed. Do not change encode outputs in this work.
        """
    acceptance {
        check counters-available {
            statement """
                jpxl bench --diag prints choose_total (or residual_scans) on a
                release binary for modular and vardct-fixed modes.
                """
            method command
        }
        check twelve-mp-diag-logged {
            statement """
                A scratch log under .agent/scratch/ records 12 MP diag lines for
                threads=1 and threads=auto for at least one VarDCT and one Modular
                path.
                """
            method observation
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
    author "grok-build"
    source {
        kind external
        path "sources/outside-advice.md"
        excerpt """
            Phase 0: Instrumentation and matched-quality testing
            """
    }
}

record jpegxl-rs.work.arch-phase1-output-preserving/1 : work {
    title "Phase 1: output-preserving encode speed fixes"
    state active
    intent """
        Output-preserving corrections from sources/outside-advice.md Phase 1:
        exact zero return and precomputed steps in HfQuantizer::choose; bounded
        block_cost and CfL residual cost; precomputed LF X/B factor costs;
        shared modular plane storage (no per-trial deep clone); specialized
        single-leaf residual paths for Gradient/Zero/West. Codestreams must
        stay byte-identical to the pre-Phase-1 encoder for the same requests.
        """
    acceptance {
        check byte-identical-default-paths {
            statement """
                Existing modular and VarDCT encode tests remain green; a golden
                fingerprint check (or unit tests asserting choose/cover identity)
                shows no output change for fixed inputs.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode -p jpxl-encode-policy --lib --release"
        }
        check plane-clone-down {
            statement """
                On a multi-megapixel modular encode, plane_clone_bytes from
                plan_for is far below the Phase-0 ~10GB (shared Arc path).
                """
            method observation
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
    author "grok-build"
    source {
        kind external
        path "sources/outside-advice.md"
        excerpt """
            Phase 1: Output-preserving corrections
            """
    }
}

record jpegxl-rs.work.arch-phase2-cfl-quant/1 : work {
    title "Phase 2: analytic CfL and once-final HF quant unit of work"
    state superseded
    intent """
        Replace frame-sized CflSample storage and per-candidate scalar choose
        refinement with closed-form tile CfL (CflAccumulator sufficient stats)
        and keep final HF quantization only on the selected cover. Optionally
        tighten final quant as a block/lane loop. Deterministic Contract A
        identity across threads is preserved. Codestreams may change vs Phase 1.
        """
    acceptance {
        check choose-cfl-down {
            statement """
                On 12 MP VarDCT defaults, choose_cfl_y and choose_cfl_factor are
                near zero (analytic path); choose_total is dominated by cover+final.
                """
            method observation
        }
        check tests-green {
            statement """
                jpxl-encode-policy and jpxl-encode lib tests pass in release.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode -p jpxl-encode-policy --lib --release"
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
    author "grok-build"
    source {
        kind external
        path "sources/outside-advice.md"
        excerpt """
            Phase 2: Replace the VarDCT quant/CfL unit of work
            """
    }
}

record jpegxl-rs.work.arch-phase2-cfl-quant/2 : work {
    title "Phase 2: analytic CfL and once-final HF quant unit of work"
    state completed
    intent """
        Replace frame-sized CflSample storage and per-candidate scalar choose
        refinement with closed-form tile CfL (CflAccumulator sufficient stats)
        and keep final HF quantization only on the selected cover. Optionally
        tighten final quant as a block/lane loop. Deterministic Contract A
        identity across threads is preserved. Codestreams may change vs Phase 1.
        """
    note """
        2026-08-07: two attempts to score the HF CfL factor purely from
        CflAccumulator's 3 sufficient statistics (no per-sample exact scoring)
        each regressed a real test -- see
        jpegxl-rs.evidence.phase2-analytic-cfl-regressed-correctness. The
        original choose-cfl-down acceptance check (near-zero choose_cfl_y and
        choose_cfl_factor) is not safely reachable without either richer
        per-tile statistics than a 2nd-moment regression, or a calibrated rate
        model built against the matched-quality harness outside-advice.md §19
        describes. Landed instead: factor_candidates window narrowed ±4 -> ±1,
        plus an exact-LS-neutral (seed==0) shortcut -- both still exact-oracle
        scored, just over fewer candidates, so no calibration risk.
        choose_total -39%, choose_cfl_factor -71%, tests green. Re-open the
        full analytic-CfL elimination only alongside Phase 0's matched-quality
        harness (or a richer per-tile summary), not as an isolated heuristic
        guess.
        """
    acceptance {
        check choose-cfl-down {
            statement """
                factor_candidates' search window is narrowed to seed±1 (from ±4) and refine_hf_factor short-circuits to the neutral factor when the closed-form least-squares seed is already 0, cutting choose_cfl_factor calls without changing the exact per-sample scoring semantics. Full elimination of choose_cfl_y/choose_cfl_factor is deferred -- see the note.
                """
            method observation
            verified_by [
                @jpegxl-rs.evidence.phase2-safe-window-narrowing-landed/1,
                @jpegxl-rs.evidence.phase2-safe-window-narrowing-landed-postcommit/1
            ]
        }
        check tests-green {
            statement """
                jpxl-encode-policy and jpxl-encode lib tests pass in release.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode -p jpxl-encode-policy --lib --release"
            verified_by [
                @jpegxl-rs.evidence.phase2-safe-window-narrowing-landed/1,
                @jpegxl-rs.evidence.phase2-safe-window-narrowing-landed-postcommit/1
            ]
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supersedes [ @jpegxl-rs.work.arch-phase2-cfl-quant/1 ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
}

record jpegxl-rs.work.arch-phase3-forward-cache/1 : work {
    title "Phase 3: eliminate the selected-forward clone; borrow from CandidateForwardCache"
    state superseded
    intent """
        outside-advice.md §7 flags two redundant retentions of full per-candidate
        HF coefficient vectors: CandidateForwardCache (every scored cover candidate,
        frame-wide, ~428 MB at 12 MP) and forward_selected's second owned clone of
        just the selected varblocks (~144 MB at 12 MP). This work eliminates the
        second one: split cover selection's per-group loop into two passes so every
        selected varblock's forward can be *borrowed* from CandidateForwardCache
        (now exposing a read-only get()) instead of cloned into groups. The first
        retention (CandidateForwardCache itself, which must keep every scored
        candidate -- winners and losers -- because the rate loop shares one cache
        across quantizer probes to avoid re-running the forward DCT per probe) is
        explicitly NOT touched by this work; see the note for why a naive LRU/FIFO
        cap on it is risky (could gut cross-probe reuse for RateSearchBudget's up to
        40 probes) and deferred pending a design that understands the rate loop's
        access pattern.
        """
    note """
        2026-08-07: landed the safe half (selected-forward clone). Verified
        output-preserving by construction (pure ownership/borrow restructuring, no
        decision logic touched) and confirmed via --diag fingerprint identity: 12MP
        vardct-fixed threads=1 output_bytes and fingerprint unchanged
        (1,530,188 / 30e55ba3faef4d64) both before and after, sel_clones/sel_bytes
        41,949/144,000,000 -> 0/0. All jpxl-encode + jpxl-encode-policy lib, oracle,
        roundtrip and rate_loop tests pass (the one pre-existing
        both_oracles_decode_a_stream_from_the_hf_mul_segment failure is unrelated,
        see jpegxl-rs.work.arch-phase2-cfl-quant's note).

        CandidateForwardCache itself (the ~428 MB frame-wide candidate retention,
        the larger of outside-advice §7's two numbers) is unaddressed. It backs
        cross-probe reuse in the rate loop (crates/jpxl-encode-policy/src/rate.rs:589
        keeps one CandidateForwardCache across all quantizer probes of one encode,
        so a probe's cover search can skip re-running the forward DCT for positions
        a prior probe already scored). A bounded cap (LRU/FIFO) risks evicting
        exactly the entries a later probe needs, which for RateSearchBudget's up to
        ~40 probes could turn a cache hit into 40x the forward-DCT work -- a real
        wall-clock regression, not just a missed win. A safe reduction here needs
        either: (a) a cap sized/validated against actual rate-loop access patterns
        (measure hit-rate degradation, not just implement and hope), or (b) the
        fuller outside-advice §8 redesign -- compact per-candidate summaries
        (estimated_rate/distortion/band_energy, not raw coefficient vectors) scored
        during cover search, with only the winning transform's exact coefficients
        ever materialized. (b) is the architecturally 'right' answer per outside-
        advice but is a much bigger change (touches block_cost/tile_region's
        candidate representation, not just an ownership pattern) and should get its
        own scoped work item rather than being bolted onto this one.
        """
    acceptance {
        check clone-eliminated {
            statement """
                --diag on a 12 MP VarDCT encode reports sel_clones=0 and sel_bytes=0.
                """
            method observation
            verified_by [
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated-postcommit/1
            ]
        }
        check output-unchanged {
            statement """
                The --diag fingerprint and output_bytes for a fixed 12 MP vardct-fixed encode are identical before and after (pure representational change, no decision logic touched).
                """
            method observation
            verified_by [
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated-postcommit/1
            ]
        }
        check tests-green {
            statement """
                jpxl-encode-policy and jpxl-encode lib, oracle, roundtrip and rate_loop tests pass (modulo the pre-existing, unrelated both_oracles_decode_a_stream_from_the_hf_mul_segment failure).
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode -p jpxl-encode-policy --lib --release && cargo test -p jpxl-encode-policy --test vardct_oracle --test vardct_roundtrip --test rate_loop"
            verified_by [
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated-postcommit/1
            ]
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
    source {
        kind external
        path "sources/outside-advice.md"
        excerpt """
            Section 7: The current forward cache is counterproductive
            """
    }
}

record jpegxl-rs.work.arch-phase3-forward-cache/2 : work {
    title "Phase 3: eliminate the selected-forward clone; borrow from CandidateForwardCache"
    state completed
    intent """
        outside-advice.md §7 flags two redundant retentions of full per-candidate
        HF coefficient vectors: CandidateForwardCache (every scored cover candidate,
        frame-wide, ~428 MB at 12 MP) and forward_selected's second owned clone of
        just the selected varblocks (~144 MB at 12 MP). This work eliminates the
        second one: split cover selection's per-group loop into two passes so every
        selected varblock's forward can be *borrowed* from CandidateForwardCache
        (now exposing a read-only get()) instead of cloned into groups. The first
        retention (CandidateForwardCache itself, which must keep every scored
        candidate -- winners and losers -- because the rate loop shares one cache
        across quantizer probes to avoid re-running the forward DCT per probe) is
        explicitly NOT touched by this work; see the note for why a naive LRU/FIFO
        cap on it is risky (could gut cross-probe reuse for RateSearchBudget's up to
        40 probes) and deferred pending a design that understands the rate loop's
        access pattern.
        """
    note """
        2026-08-07: landed the safe half (selected-forward clone). Verified
        output-preserving by construction (pure ownership/borrow restructuring, no
        decision logic touched) and confirmed via --diag fingerprint identity: 12MP
        vardct-fixed threads=1 output_bytes and fingerprint unchanged
        (1,530,188 / 30e55ba3faef4d64) both before and after, sel_clones/sel_bytes
        41,949/144,000,000 -> 0/0. All jpxl-encode + jpxl-encode-policy lib, oracle,
        roundtrip and rate_loop tests pass (the one pre-existing
        both_oracles_decode_a_stream_from_the_hf_mul_segment failure is unrelated,
        see jpegxl-rs.work.arch-phase2-cfl-quant's note).

        CandidateForwardCache itself (the ~428 MB frame-wide candidate retention,
        the larger of outside-advice §7's two numbers) was left unaddressed pending
        measurement -- see jpegxl-rs.evidence.phase3-rate-loop-cache-reuse-measured.

        2026-08-07 (later same day): measured it. Extended `jpxl bench vardct-rate
        --diag` with a new rate_diag= line surfacing RateOutcome.stats (fast_prices,
        full_prices, dct_cache_hits/misses -- fields that already existed but were
        never printed). Two images (4000x3000 and 1024x768, bpp=1.0, default
        max_prices=40 budget) both landed a ~96-97% cross-probe hit rate
        (6,349,453/6,595,028 and 497,050/513,177 respectively) over 23-25 total
        probes. Misses in both runs closely match a single vardct-fixed probe's
        unique candidate count, confirming every probe after the first scores the
        *same* candidate set (position+transform is quantizer-independent; only
        block_cost's score of each candidate depends on the probe's quantizer) and
        gets an almost-total cache hit.

        This answers the note's option (a): a size cap is **not viable**. The cache
        would need to retain essentially 100% of one frame's unique candidates to
        preserve this reuse, so capping it below that trades wall-time (up to ~23x
        more forward-DCT recomputation for evicted-then-needed entries) for a memory
        saving that shrinks to nothing as the cap approaches the size needed to avoid
        that cost. Option (b) -- outside-advice §8's compact-per-candidate-summary
        redesign (score cover candidates from summaries, materialize full
        coefficients only for the winner) -- is the only remaining path to actually
        shrinking this 428 MB, and it needs its own scoped work item: it changes
        block_cost/tile_region's candidate representation, not just a cache policy,
        so it carries real correctness/quality risk the way Phase 2's CfL rewrite
        did, not the representational-only safety of this work item's landed half.
        """
    acceptance {
        check clone-eliminated {
            statement """
                --diag on a 12 MP VarDCT encode reports sel_clones=0 and sel_bytes=0.
                """
            method observation
            verified_by [
                @jpegxl-rs.evidence.phase3-forward-cache-rev2-postcommit/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated-postcommit/1
            ]
        }
        check output-unchanged {
            statement """
                The --diag fingerprint and output_bytes for a fixed 12 MP vardct-fixed encode are identical before and after (pure representational change, no decision logic touched).
                """
            method observation
            verified_by [
                @jpegxl-rs.evidence.phase3-forward-cache-rev2-postcommit/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated-postcommit/1
            ]
        }
        check tests-green {
            statement """
                jpxl-encode-policy and jpxl-encode lib, oracle, roundtrip and rate_loop tests pass (modulo the pre-existing, unrelated both_oracles_decode_a_stream_from_the_hf_mul_segment failure).
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode -p jpxl-encode-policy --lib --release && cargo test -p jpxl-encode-policy --test vardct_oracle --test vardct_roundtrip --test rate_loop"
            verified_by [
                @jpegxl-rs.evidence.phase3-forward-cache-rev2-postcommit/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated-postcommit/1
            ]
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supersedes [ @jpegxl-rs.work.arch-phase3-forward-cache/1 ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
}

record jpegxl-rs.work.arch-phase4-0b-density-gate/1 : work {
    title "Phase 4.0b: pinned real-corpus density + decode-validity gate (prerequisite for 4A/4C)"
    state completed
    intent """
        Build the missing zero-risk instrumentation step the advisor identified as a hard prerequisite for 4A (Weighted predictor) and 4C (global MA tree): a pinned, real (non-synthetic) corpus harness that measures modular density against the cjxl oracle and decode-validity, so Contract-B sub-phases can name metric bounds (required by jpegxl-rs.decision.optimization-determinism-contract) instead of relying on the earlier, possibly-synthetic 118x density claim in jpegxl-rs.assessment.encoder-architecture-outside-advice.

        Scope: extend crates/jpxl-encode/tests/roundtrip.rs (or a new bench harness) plus jpxl-conformance/src/metrics.rs (currently pixel-error helpers only, no bpp/size-ratio helper -- that is the concrete gap) to, for a fixed set of ~4-6 real PNGs spanning a small (~1MP) and at least one large (>=12MP) size class:
        1. Encode each with jpxl (modular path) and with libjxl/build/tools/cjxl -e1 (oracle-only, per clean-room policy: run the binary, never read its source).
        2. Assert every jpxl-encoded stream round-trips byte-valid through both jpxl-decode (in-tree) and djxl (oracle) -- decode-validity gate, reusing existing roundtrip/oracle test infra.
        3. Emit a pinned per-image jpxl_bytes / cjxl_e1_bytes ratio table.
        4. Emit the exact-price byte decomposition the encoder already computes internally (residual-entropy bits vs MA-tree-cost bits, from total_cost_source in lossless.rs) per image, so the next choice between 4A (predictor strength) and 4C (tree/model strength) is made by measured contribution, not assumption.

        Not in scope: any change to encoder decisions (Contract A, zero risk); this is measurement-only.
        """
    note """
        PROPOSED, not started. Opened per jpegxl-rs.assessment.phase4-order-correction (advisor review, corrected sub-phase order). This is now the required next buildable unit before 4A or 4C can be gated -- it converts the stale, possibly-synthetic 118x density claim into a live, reproducible, real-corpus number and supplies the residual-vs-tree decomposition needed to choose between 4A and 4C with evidence.
        """
    acceptance {
        check harness-green {
            statement """
                The density+decode-validity harness runs deterministically and every corpus image round-trips byte-valid through both jpxl-decode and the djxl oracle
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase4-0b-density-gate-2026-08-08/1 ]
        }
        check ratio-table-pinned {
            statement """
                The harness prints a pinned per-image jpxl/cjxl-e1 size-ratio table plus the residual-vs-tree-cost byte decomposition, reproducing the order-of-magnitude of the prior 118x density claim on real (non-synthetic) corpus images
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase4-0b-density-gate-2026-08-08/1 ]
        }
    }
}

record jpegxl-rs.work.arch-phase4-modular-scoped/1 : work {
    title "Phase 4: rebuild modular planning, scoped density-first (sub-phases 4.0, 4A-4D)"
    state proposed
    intent """
        Scope (not yet implement) outside-advice.md Phase 4 (§20: "rebuild modular planning"), reoriented by jpegxl-rs.assessment.s8-close-phase4-reorient after S8's closure. Not a from-scratch rebuild: Phase 1 already eliminated modular's cheap copy/interpretation costs (Arc-shared score planes, specialized single-leaf residual kernels, cheap-vs-exact trial pricing -- crates/jpxl-encode/src/lossless.rs, modular/mod.rs). What outside-advice.md §14-15 still diagnoses as unaddressed is model-strength and density: no Weighted predictor, local-only MA trees (use_global_tree=false, no global histogram clustering), full-image cheap-tier trial scans instead of a sampled/summarized gather, and a naive 256-entry linear LZ77 lookback.

        Modular is the largest remaining absolute wall-time cost (33.5s vs VarDCT's 8.3s at 12MP) and the worst density benchmark point on record (~118x slower than cjxl e1 for essentially identical output size -- a model-strength failure). It is also the safest major rebuild available: lossless gives an exact-pixel-identity oracle for every sub-phase, no Butteraugli/perceptual-calibration dependency the way further VarDCT work would need (that's Phase 5's territory).

        Each sub-phase is independently gated, following the same discipline S8 and Phases 1-3 used: measure before design, prove safety/decision-preservation before wiring behind a feature flag, honest negative results are an acceptable, plan-sanctioned outcome (not a bug to chase).

        Sub-phases:
        - 4.0 (mandatory first step): re-measure the current, post-Phase-1 modular baseline by stage on real content (cheap-tier trial scans vs exact finalist pass vs LZ77 alternative-encode vs entropy), so no later sub-phase re-solves a cost Phase 1 already made cheap. Also quantify the size gap to cjxl e1/e7 per corpus stratum -- density, not speed, is modular's worst benchmark point and 4A/4C's payoff should be measured against it directly.
        - 4A: Weighted (H.5 self-correcting) predictor, currently deferred (lossless.rs). Density-only, exact-lossless-safe: pixel identity always holds, so the only oracle is byte size vs. trial-time cost. Gate behind a feature; promote only if it reduces bytes on the corpus without unacceptable trial-time regression.
        - 4D: cheap repetition-estimate gate ahead of the full LZ77 alternative encode, and/or hash-chain lookback to replace the 256-entry linear scan. Output-preserving (decides only whether/how to search matches, not what wins) -- byte-identity is the safety gate, the lowest-risk sub-phase, a good candidate to land alongside or before 4A.
        - 4B: sampled property-gather (outside-advice.md §15's core) replacing full-image cheap-tier trial scans with one sampled/summarized pass feeding tree/threshold selection; source traversed exactly only for the settled winner. The invasive piece. Scope as: (1) build the sampled gather as an additive alternative scorer: (2) prove on fixtures that winner selection matches the full-scan scorer within tolerance, using the same independent-second-walk pattern S8's regret.rs harness established; (3) wire behind a flag and measure. Honest-negative-acceptable: if sampling changes winners too often or doesn't pay for itself, it stays off.
        - 4C: global/chunk-global MA tree with histogram clustering in place of per-group local trees (use_global_tree=true path). Density-focused; scoped separately from 4B because it interacts with the entropy stage. Measure the byte win against the per-group modeling cost it gives up.

        Suggested order: 4.0 -> (4A + 4D, both cheap/safe) -> 4B -> 4C. Front-load the exact-safe density win (4A) and output-preserving speed win (4D); reserve the sampled-gather restructure (4B) and global-model change (4C) for after 4.0's measurement confirms they target the actual remaining cost.
        """
    note """
        PROPOSED, not started as a whole -- but 4.0, 4.0b, 4B (promoted to default), and 4A are all DONE.

        4.0/4.0b: baseline re-measured; the '118x' figure is a wall-time ratio, not a density gap (jpegxl-rs.assessment.phase4-density-gap-is-vs-e7-only).

        4B (sampled property-gather): DONE, promoted to default. ~2.6-2.8x modular wall-time reduction, byte-identical output, decode-validated.

        4A (Weighted predictor): DONE. Predictor::Weighted wired into jpxl-encode's predictor sweep and per-leaf refinement (not the split loop), backed by jpxl_core::modular_weighted (moved from jpxl-decode so both crates share the exact same, spec-resolved H.5.2 arithmetic). Correctness gated by forced single-leaf, mixed-tree, and multi-section round trips through jpxl-decode plus an independent djxl oracle test, all passing; a decision-preservation test proves plan_for-with-Weighted never regresses versus the pre-4A six-predictor search. NOT gated behind a feature flag: unlike 4B, this needed no approximation-safety flag because it's a strict additional candidate under the existing unconditional exact-price gate. See jpegxl-rs.assessment.phase4a-weighted-integration-design and jpegxl-rs.evidence.phase4a-weighted-predictor-wired-2026-08-08.

        Open follow-up from 4A (performance-only, not correctness): the advisor-flagged worst-case where a Weighted-seeded split search on a large frame could trigger many sequential full-plane scans per split round. A spot-check (jpegxl-rs.evidence.phase4a-worst-case-timing-spotcheck-2026-08-08) found no blowup at the size the risk would bite hardest, but is not a full stress-test closure -- left open, not blocking.

        Also surfaced (pre-existing, unrelated to 4A, NOT fixed): the encoder's search cost model excludes LZ77 (allow_lz77=false during search vs true at real emission), a known gap already scoped as the future 'Phase 4D'. This can make the search's ranking wrong on LZ77-friendly inputs; it never produces incorrect bytes, only a possible missed optimization. Worth folding into 4D's eventual scope.

        Remaining order: 4C (global tree, addresses the vs-e7-only density gap) -> 4D (LZ77 gating, now with two independent motivations: the originally-scoped hash-chain lookback AND this session's search/emission LZ77 mismatch finding).
        """
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supported_by [
        @jpegxl-rs.assessment.encoder-architecture-outside-advice,
        @jpegxl-rs.assessment.phase4-density-gap-is-vs-e7-only,
        @jpegxl-rs.assessment.phase4-order-correction,
        @jpegxl-rs.assessment.phase4a-weighted-integration-design,
        @jpegxl-rs.assessment.s8-close-phase4-reorient
    ]
}

record jpegxl-rs.work.arch-phase4a-weighted-predictor-scoped/1 : work {
    title "Phase 4A: wire Predictor::Weighted into the encoder despite its stateful, order-dependent scoring cost"
    state completed
    intent """
        Wire the H.5 self-correcting predictor (now shared at jpxl_core::modular_weighted, moved from jpxl-decode) into jpxl-encode's predictor candidate list (crates/jpxl-encode/src/lossless.rs PREDICTOR_CANDIDATES, currently the six order-independent predictors: Zero, West, North, AverageWestNorth, Select, Gradient).

        COMPLICATION found while starting this (not present in the original scoping): every other candidate predictor is a pure function of neighbouring SAMPLE values, which is what let the encoder's residual-collection functions (collect_plane_residuals, and Phase 4B's collect_plane_residuals_sampled) be absolute-indexed and order-independent -- any row can be visited in any order or skipped. Predictor::Weighted (jpxl_core::modular_weighted::WeightedState) is stateful and ORDER-DEPENDENT: per H.5.1 it must be invoked for every sample of a channel in strict raster order, unconditionally, because its error state (used by the next sample's weight computation) accumulates across the whole scan and its max_error output is a context property. Confirmed in the decoder: jpxl-decode's per-channel loop constructs WeightedState once and calls predict/update on every sample regardless of which predictor a given leaf actually uses.

        Consequences for the encoder's scoring architecture (predictor sweep -> greedy split search -> per-leaf refinement -> exact final price, all documented in lossless.rs's module doc):
        1. Any candidate tree containing a Weighted leaf needs a full sequential O(pixels) scan to price, not a sampled scan (Phase 4B's row-strided sampling would corrupt the error state) and not one of the specialised single-leaf fast paths (Zero/West/North/Gradient in collect_plane_residuals).
        2. This full sequential scan is naturally scoped to TWO of the three search stages, not all three: (a) the initial per-predictor sweep (PREDICTOR_CANDIDATES tried as single_leaf trees, one full scan each -- Weighted becomes a 7th candidate here, no combinatorial blowup, same shape as today) and (b) per-leaf predictor refinement (also one full scan per candidate swap on the settled topology). It should NOT be added as a topology-search-time option inside the greedy split loop's O(leaves x properties x thresholds) inner loop -- but this may not need special-casing anyway, since split_leaf already carries the parent leaf's already-chosen predictor forward unchanged (lossless.rs: "same predictor both sides first (cheap topology search)"), so a Weighted-winning leaf from stage (a) propagates into splits for free without the split search itself needing to know about Weighted's cost model.
        3. Open question needing an explicit choice: does pricing a Weighted-containing candidate at stages (a)/(b) cost O(pixels) unconditionally (losing Phase 4B's speedup for just those specific trials, which is bounded and probably acceptable -- 7 trials in stage (a), <= leaves x 6 trials in stage (b)), or is there a cheaper still-safe way to rank it (e.g. a smaller fixed-size early-window sequential prefix, if that ranks predictors reliably enough -- needs its own decision-preservation proof if used, echoing the 4B regret-test pattern)?
        4. SPLIT_PROPERTIES (currently missing property 15, max_error) is a SEPARATE decision from adding the predictor itself -- property 15 is only informative once some sample in the channel actually runs Weighted, which after this change is universal (state runs on every sample, unconditionally, once ANY leaf might want it) -- IS the encoder already computing property 15 for every sample regardless of whether Weighted is a chosen predictor anywhere in the tree, matching the decoder's unconditional-invocation behaviour? If the encoder's per-candidate cost estimators don't currently run WeightedState at all (true today, since it's simply not called), then adding Weighted as a predictor candidate must ALSO start running WeightedState unconditionally across every trial from that point on (even Zero/West/etc-only trials) to keep property vectors correct if property 15 is ever split on -- or property 15 can stay excluded from SPLIT_PROPERTIES for this sub-phase, deferring context-splitting on max_error to a later increment, which shrinks the immediate blast radius substantially.

        Asking an Opus advisor to give a concrete, actionable design for stages 1-4 before writing code, given the correctness-criticality (this predictor's arithmetic has a documented history of contested spec ambiguities -- see jpxl_core::modular_weighted's EXPERIMENT_* constants) and the risk of quietly reintroducing an O(pixels) cost bloom into a search architecture Phase 4B just spent effort making sub-linear.
        """
    note """
        PROPOSED. Groundwork (shared jpxl_core::modular_weighted module) already landed and tested. This record captures the architecture complication found when starting the wiring step, pending advisor input on stages 1-4 above.
        """
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supported_by [ @jpegxl-rs.assessment.phase4-density-gap-is-vs-e7-only ]
}

record jpegxl-rs.work.arch-phase4b-sampled-gather-scoped/1 : work {
    title "Phase 4B: sampled property-gather to cut modular's dominant search-time cost"
    state completed
    intent """
        Now the priority sub-phase per jpegxl-rs.assessment.phase4-density-gap-is-vs-e7-only: the 4.0b real-corpus gate showed modular's dominant, unambiguous problem is wall-clock cost (100-120x versus cjxl -e1, at essentially identical output size), driven by the 67 full-plane cheap-tier residual scans per plan_for call (6 predictors x greedy split grid over SPLIT_PROPERTIES x SPLIT_THRESHOLDS + per-leaf refinement, crates/jpxl-encode/src/lossless.rs:154-248). Each scan re-walks the entire score plane (estimate_residual_bits_full) even though only a ranking decision, not an exact price, is needed at this stage.

        Goal: replace (or augment) the full-image cheap-tier scan with a sampled/summarized pass over the score planes that still ranks predictor/split candidates correctly, so plan_for's wall time scales with sample count, not pixel count, for the topology search.

        Safety model: this is Contract-A on the OUTPUT -- the existing exact final-price gate (lossless.rs:259-306, PriceTier::Exact) already re-prices the settled MA-tree winner exactly before it is adopted, so emitted bytes stay exactly priced regardless of how the search reached that candidate. The risk is purely a SEARCH-QUALITY one: does sampling ever change WHICH candidate the greedy search picks, in a way that leaves bytes on the table versus the full-scan search? That needs its own decision-preservation proof, echoing S8 Phase C's regret.rs independent-second-walk pattern (jpegxl-rs.work.arch-s8-full-redesign-scoped) -- a second, independent full-scan verification run on a held-out fixture set, not sharing code paths with the sampled scorer, checked against how often/how badly the sampled winner diverges from the full-scan winner.

        Scope, in order:
        1. Build the sampled gather as an ADDITIVE alternative scorer (new function alongside cheap_residual_bits, not a replacement) -- e.g. stratified or fixed-stride sample of rows/blocks, scaled Shannon-hybrid estimate.
        2. Prove on fixtures (small + the 4.0b real-corpus set) that sampled-winner selection matches full-scan selection within an explicit, named tolerance (bytes-left-on-table bound), using an independent second-walk harness.
        3. Wire behind a feature flag (following the s8-cover-prune pattern: off by default, diagnostics counters gated behind the same flag per jpegxl-rs.evidence.s8-phase-d-diagnostics-gated-verified's precedent).
        4. Measure wall-time win on the 4.0b corpus (0.8/4/12MP) with --diag; promote only if wall time drops materially with no exact-price regression (the Exact tier gate already prevents byte regression; this measures whether the search still finds equally-good candidates).

        Honest-negative-acceptable: if sampling changes winners too often, or the wall-time win doesn't materialize once Exact-tier re-pricing overhead is accounted for, it stays off -- same discipline as S8.

        Not in scope here: 4A (Weighted predictor) and 4C (global tree), which address the smaller, secondary vs-cjxl-e7-only density gap and are scoped separately once 4B lands or is honestly-negatived.
        """
    note """
        PROPOSED, not started. Opened per jpegxl-rs.assessment.phase4-density-gap-is-vs-e7-only's corrected order (4.0 -> 4.0b -> 4B -> 4A -> 4C -> 4D). This is now the next actionable engineering unit for Phase 4.
        """
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supported_by [
        @jpegxl-rs.assessment.phase4-density-gap-is-vs-e7-only,
        @jpegxl-rs.evidence.phase4-0b-density-gate-2026-08-08
    ]
}

record jpegxl-rs.work.arch-phase4e-modular-effort-ramp/1 : work {
    title "Phase 4E: lossless modular effort ramp, then reoriented to a lean default (the search above e1 is chaff)"
    state completed
    scope [
        path "path \"JPXL/crates/jpxl-cli/**\"",
        path "path \"JPXL/crates/jpxl-encode/**\""
    ]
    intent """
        Build the lossless modular effort ramp (speed/size dial) per Encoder-plan1.md §12. Reoriented by measurement: the full search is chaff on real photos, earning zero bytes for 16× the wall time. Prune the default path: flip Effort::DEFAULT to the lean level 1, demote the full search to opt-in, keep level 7 as the byte-identical density anchor.
        """
    acceptance {
        check default-byte-identical {
            statement """
                The lean default (Effort::DEFAULT = 1) is byte-identical to the pre-change default on the photo corpus, at a fraction of the time.
                """
            method command
            command "pwsh -NoProfile -File .agent/scratch/effort-ramp-2026-08-10/verify_default_flip.ps1"
            verified_by [ @jpegxl-rs.evidence.modular-effort-ramp-landed-2026-08-10/1 ]
        }
        check tests-green {
            statement """
                Every effort level reconstructs pixels exactly and round-trips; level 7 reproduces the pre-ramp search field-for-field.
                """
            method command
            command "cargo test -p jpxl-encode --lib"
            verified_by [ @jpegxl-rs.evidence.modular-effort-ramp-tests-2026-08-10/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase4b-sampled-gather-scoped/1 ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
}

record jpegxl-rs.work.arch-phase4f-elide-foregone-search/1 : work {
    title "Phase 4F: elide the modular search when the effort budget already fixes its answer"
    state completed
    scope [ path "JPXL/crates/jpxl-encode/src/lossless.rs" ]
    intent """
        Stop paying for a search whose answer the effort budget already fixed.

        At the default effort the modular planner's levers are degenerate: one predictor, an empty split property/threshold grid, no leaf refinement, and neither the palette nor the squeeze trial. The predictor sweep has nothing to rank, the greedy split loop's inner loops never execute so it breaks having improved nothing, and no later stage can move the answer. The plan is exactly single_leaf(predictors[0]) with the caller's rct and neither transform -- yet plan_for still paid for it: a full RCT scoring copy of every plane, an Arc wrap of every plane, and a strided cheap residual scan of the whole frame. At 12 MP that is two 144 MB plane copies plus a scan, all discarded.

        Add ModularSearchBudget::search_is_a_foregone_conclusion and return the settled plan directly when it holds. Split the search body out as plan_by_full_search so the elision can be proved equivalent by running both paths on the same input, not merely argued in a comment.

        This is a pure work-elision change: identical bytes at every effort, by construction and by corpus fingerprint.
        """
    acceptance {
        check bytes-unchanged {
            statement """
                The corpus fingerprints are unchanged at the default effort and at the level-7 density anchor.
                """
            method command
            command "pwsh -NoProfile -File .agent/scratch/effort-ramp-2026-08-10/verify_default_flip.ps1"
            verified_by [ @jpegxl-rs.evidence.phase4f-bytes-unchanged-2026-08-10/1 ]
        }
        check elision-is-equivalent {
            statement """
                For every effort level the short-circuit claims, it produces the same plan the full search would have, across both rct polarities and both channel counts; and the whole suite stays green.
                """
            method command
            command "cargo test -p jpxl-encode --lib"
            verified_by [ @jpegxl-rs.evidence.phase4f-elision-equivalent-2026-08-10/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase4e-modular-effort-ramp/1 ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
    author "GitHub Uploader"
}

record jpegxl-rs.work.arch-phase4g-bounded-ranker-and-unit-fix/1 : work {
    title "Phase 4G: bound the cheap ranker's cost, and fix the sampled-residual vs whole-frame-tree unit mismatch"
    state completed
    scope [
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode/src/lossless.rs",
        path "JPXL/crates/jpxl-encode/src/modular/mod.rs"
    ]
    intent """
        Bound the modular cheap ranker's cost independently of frame size, so tree depth stops being unaffordable at 12 MP; then measure whether depth was ever the thing worth affording.

        Two changes. First, ModularSearchBudget gains cheap_sample_budget: a target number of scored samples per candidate. cheap_row_stride becomes a floor rather than the stride itself, and effective_cheap_stride derives the real stride once at the plan_by_full_search stage boundary from (budget, width, height, plane count). A stride is a ratio, so a fixed stride still costs frame_area/stride -- linear in frame size, which is exactly why the tree had to be collapsed on large frames. A sample budget is an absolute bound.

        Second -- and this turned out to matter far more -- lossless::total_cost_source added an unscaled whole-frame ma_tree_bit_cost * sections to a residual estimate that covered only 1/row_stride of the frame. The two terms were in different units. A split's residual saving was divided by the stride while its tree cost was not, so every extra context was over-priced by exactly the sampling ratio, and worse as frames grew. modular::estimate_residual_bits_sampled now extrapolates its data cost to whole-frame bits (the fixed table overhead is not extrapolated -- one set of ANS tables is emitted however densely the estimate sampled), putting both terms in the same unit the Exact tier already speaks.

        Also adds EncodeOptions::modular_search_overrides and four `jpxl bench modular` flags, so the ladder's constants can be swept and chosen from evidence instead of guessed.
        """
    acceptance {
        check bound-and-identity-tests {
            statement """
                The sample budget is provably a no-op below the budget, provably bounds scored samples above it, is inert when no override is set, and the whole suite stays green.
                """
            method command
            command "cargo test -p jpxl-encode --lib"
            verified_by [ @jpegxl-rs.evidence.phase4g-bound-and-identity-tests-2026-08-10/1 ]
        }
        check default-unchanged {
            statement """
                The default effort's output is byte-identical on the photo corpus: this work changes what the opt-in density levels find, never what a default encode emits.
                """
            method command
            command "pwsh -NoProfile -File .agent/scratch/effort-ramp-2026-08-10/verify_default_flip.ps1"
            verified_by [ @jpegxl-rs.evidence.phase4g-default-unchanged-2026-08-10/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase4f-elide-foregone-search/1 ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
    author "GitHub Uploader"
}

record jpegxl-rs.work.arch-phase4h-lossy-reachable-and-measurable/1 : work {
    title "Phase 4H: make the lossy VarDCT path reachable from the CLI and measurable against the oracle"
    state completed
    scope [
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-conformance/src/metrics.rs"
    ]
    intent """
        Make the lossy VarDCT path reachable and measurable. It has been the more complete half of this encoder since M1-M8, but nothing outside the library and `jpxl bench` could invoke it, and it had never been compared against the oracle at all -- the same blind spot that let the modular effort ladder ship inert for a whole phase.

        Three small pieces, no encoder change:
        - `jpxl encode --bpp <f>` / `--target-bytes <n>` route to jpxl_encode_policy::encode_srgb8_to_target. Without a rate flag the command stays the lossless modular encoder it has always been. 8-bit RGB only, because the VarDCT path converts sRGB8 to XYB and has no route for greyscale or deeper samples; anything else is refused rather than silently mangled.
        - Deliberately NO `--distance` flag. cjxl's -d targets butteraugli; this encoder has no perceptual model and its rate loop hits a size. Naming a flag --distance would promise something the encoder cannot deliver.
        - jpxl_conformance::metrics gains rmse and psnr over the integer PPM Image type. RMSE previously existed only on the NPY FloatImage conformance path, which grades a decode against a float reference per channel -- not what comparing two encoders needs. `jpxl compare <ref.ppm> <b.ppm>` exposes them so a rate/distortion sweep is drivable from a shell script with no numpy.

        PSNR is used because it is exactly reproducible in-repo, not because it is the right quality model; the harness documents that the only fair reading is the curve, never a single operating point.
        """
    acceptance {
        check lossy-is-reachable-end-to-end {
            statement """
                `jpxl encode --bpp` produces a codestream that hits its rate target and that both jpxl-decode and the independent djxl oracle accept.
                """
            method command
            command "pwsh -NoProfile -File .agent/scratch/effort-ramp-2026-08-10/headsup-lossy.ps1"
            verified_by [ @jpegxl-rs.evidence.phase4h-lossy-reachable-2026-08-10/1 ]
        }
        check metrics-are-correct {
            statement """
                RMSE and PSNR match hand-computed values, return infinity rather than NaN for identical images, and return None on a shape mismatch as the neighbouring metrics do.
                """
            method command
            command "cargo test -p jpxl-conformance --lib"
            verified_by [ @jpegxl-rs.evidence.phase4h-metrics-correct-2026-08-10/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase4g-bounded-ranker-and-unit-fix/1 ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
    author "GitHub Uploader"
}

record jpegxl-rs.work.arch-phase4i-perceptual-metrics/1 : work {
    title "Phase 4I: SSIMULACRA2 and butteraugli as opt-in metrics, plus undershoot diagnostics"
    state completed
    scope [ path "JPXL/crates/jpxl-cli/**", path "JPXL/crates/jpxl-conformance/**" ]
    intent """
        Grade lossy output on metrics that mean something. PSNR was the only distortion metric in this repository, and it measures signal error rather than what anyone looks at -- which made every comparison against cjxl an argument about the wrong axis.

        Add two, both behind off-by-default features in jpxl-conformance, both reachable from `jpxl compare --features perceptual`:
        - ssimulacra2 0.5 (BSD-2-Clause): higher is better, 100 = identical, calibrated against human ratings.
        - butteraugli 0.9 (BSD-3-Clause, pure Rust): lower is better, 0 = identical. `distance` is the max-norm libjxl calls the butteraugli distance -- the quantity `cjxl -d` targets -- reported alongside libjxl's 3-norm aggregation.

        Also: `jpxl encode --bpp` now reports when it undershoots its rate target, and distinguishes a saturated ladder (no extra budget can help) from a search that spent its price budget short of the target. That distinction is the measurement needed before anything is built to fix the undershoot.

        Dependency posture: no normative crate depends on either metric, and a default `cargo build --workspace` fetches neither. They stay opt-in because AGENTS.md section 6 bans thiserror from this project's own error types, and that ban should not be dodged by pulling it in transitively on the default path.

        Clean-room posture (AGENTS.md section 2): the butteraugli crate is a permissively-licensed port of libjxl's butteraugli. Using it to GRADE output is the same category as running cjxl/djxl as oracles. Wiring it into this encoder's own rate control would be a different decision -- it would make our perceptual model a derivative of libjxl's rather than one derived from the standard -- and must be recorded as such before anyone does it.
        """
    acceptance {
        check metrics-are-correct-and-directional {
            statement """
                Both metrics hit their defined identity value, move the right way as distortion rises, agree with each other on which of two images is worse despite opposite scales, and decline the inputs they cannot score.
                """
            method command
            command "cargo test -p jpxl-conformance --lib --features perceptual"
            verified_by [ @jpegxl-rs.evidence.phase4i-metrics-correct-2026-08-10/1 ]
        }
        check off-by-default-and-lint-clean {
            statement """
                The default build neither fetches nor references the metric crates, and both feature configurations are fmt- and clippy-clean.
                """
            method command
            command "cargo clippy -p jpxl-cli -p jpxl-conformance --all-targets"
            verified_by [ @jpegxl-rs.evidence.phase4i-off-by-default-2026-08-10/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase4h-lossy-reachable-and-measurable/1 ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
    author "GitHub Uploader"
}

record jpegxl-rs.work.arch-phase4j-aq-tuning-measurable/1 : work {
    title "Phase 4J: make the AQ field's perceptual constants data, and sweep them"
    state completed
    scope [
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode-policy/src/field.rs",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/request.rs"
    ]
    intent """
        Make the perceptual bit-allocation policy measurable, then measure it.

        The lossy deficit against cjxl is 12-20% on SSIMULACRA2 but 39-53% on butteraugli (jpegxl-rs.observation.lossy-perceptual-baseline-2026-08-10). A gap that much larger on one perceptual metric than another localises the problem to where bits go within a frame, not to coding efficiency -- which both metrics would punish alike. That points at the adaptive-quantization field, whose three constants (AQ_STRENGTH 0.25, AQ_CLAMP 1.0, CHROMA_AQ_WEIGHT 0.35) came from the 8-bit x265-family literature and had never been checked against a perceptual metric on this codec's output, because until this session the repository had none.

        Turn those constants into data: AqTuning on SearchBudget, DesiredQuantField::from_atlas_tuned, and `jpxl encode --aq-strength/--aq-clamp/--aq-chroma`. AqTuning::default() is exactly the historical values, so an untouched request encodes as before; out-of-range knobs are clamped into what the HfMul lattice can express.

        The sweep this enabled found something larger than a mistuned constant, recorded in jpegxl-rs.observation.aq-field-is-a-net-perceptual-loss-2026-08-10: at matched bitrate, turning the field OFF beats every tuning tried, on both perceptual metrics, at both rates measured. That is a finding, not yet a default change -- the evidence is one image at two rates.
        """
    acceptance {
        check default-tuning-is-the-old-field {
            statement """
                AqTuning::default() reproduces the previously hardcoded field atom for atom in both AQ directions, the knobs move the field in the direction their names promise, and out-of-range values are sanitised rather than producing an unrepresentable field.
                """
            method command
            command "cargo test -p jpxl-encode-policy --lib"
            verified_by [
                @jpegxl-rs.evidence.phase4j-tuning-is-default-preserving-2026-08-10/1
            ]
        }
        check sweep-runs-end-to-end {
            statement """
                The sweep encodes at a fixed bitrate across tunings and scores each perceptually, so the bit-allocation policy can be chosen from evidence.
                """
            method command
            command "pwsh -NoProfile -File .agent/scratch/effort-ramp-2026-08-10/aq-sweep.ps1 small_0p8MP 2.0"
            verified_by [ @jpegxl-rs.evidence.phase4j-sweep-runs-2026-08-10/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase4i-perceptual-metrics/1 ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
    author "GitHub Uploader"
}

record jpegxl-rs.work.arch-phase4k-rate-loop-probe-reduction/1 : work {
    title "Phase 4K: cut rate-loop probe count -- tolerance exit, aimed stepping with a non-monotone safety rule, Full reserve as a cap"
    state completed
    scope [ path "JPXL/crates/jpxl-encode-policy/src/rate.rs" ]
    intent """
        Cut the number of full encodes a targeted lossy encode pays for. A rate search runs 15-40 exact prices, each one a complete frame encode, and that -- not per-probe cover cost -- is the 58-530x speed gap against cjxl. It is also why high targets are missed: the measured cause of the undershoot is the Fast ladder exhausting its 24-price cap, not the quantizer ladder running out of rungs.

        Three changes, in increasing order of how much they need proving.

        1. TOLERANCE EXIT. The bisection had no stopping condition for "the caller's tolerance is already met". It stopped only when the remaining opportunity was bounded (hi - best <= slack), which on a smooth curve needs the bracket narrowed to ~1% in SIZE and therefore costs most of the bisection. Now it also stops once target - best <= slack. Safe by construction: `best` only improves, so stopping early cannot change which of the priced candidates is returned; it only declines to price more.

        2. AIMED STEPPING, with a safety rule. Bisection needs ~log2(width) prices and the ladder is ~2^17 rungs, which is more than the budget has after bracketing. A false-position step on log(size) against log(effective quantizer scale) usually lands within a rung or two. Interpolating on the RUNG INDEX would aim badly, because the index is not proportional to the quantizer -- above MAX_GLOBAL_SCALE each rung is an HfMul step worth a whole MAX_GLOBAL_SCALE of the lower segment -- so the interpolation runs on global_scale * HfMul, which is smooth across the kink.

           The safety rule is the part that matters: AN AIMED PROBE MAY MOVE `lo` UP BUT NEVER BECOMES THE NEW `hi`. On a non-monotone size function, `hi` infeasible does NOT imply everything above `hi` is infeasible, so a badly-aimed probe that tightened `hi` could fence the incumbent off from a better feasible rung above it. Moving `lo` up is always safe: `lo` only advances to rungs proved feasible and `best` is the largest feasible ever priced, so a longer jump finds the answer sooner and cannot skip past it. Termination still comes from the interleaved midpoint steps, which do tighten `hi`.

           Aiming is also abandoned permanently after one aimed probe comes back infeasible: under the safety rule such a probe cannot narrow the bracket, so it is a wasted full encode, and the same curve misfit would keep costing one per round. That bounds the worst case at "bisection plus one wasted probe" instead of "half the budget on probes that do not narrow anything", which is what a high-rate target on a stiff curve was measured doing.

        3. THE FULL RESERVE BECOMES A CAP, NOT A FLOOR. Full refinement was given max_prices - used_by_fast. Before aimed stepping the Fast ladder nearly always spent its whole allowance so the distinction never showed; now that Fast can finish in a handful of prices, handing Full the remainder would spend the saving on more expensive-entropy probes instead of banking it, and breaks the "finalist-only Full" invariant that RateProbeStats::full_confined_to_refinement asserts.
        """
    acceptance {
        check contracts-hold {
            statement """
                The loop still never exceeds its target, still lands within tolerance where the ladder can express it, still respects the price cap, and still finds the global optimum on a non-monotone sawtooth; and an aimed probe landing in an infeasible spike does not fence off the better rungs above it.
                """
            method command
            command "cargo test -p jpxl-encode-policy --lib"
            verified_by [ @jpegxl-rs.evidence.phase4k-contracts-hold-2026-08-10/1 ]
        }
        check fewer-full-encodes {
            statement """
                Real targeted encodes complete in materially fewer prices and less wall time than before.
                """
            method command
            command "jpxl encode <corpus>.ppm out.jxl --bpp N"
            verified_by [ @jpegxl-rs.evidence.phase4k-fewer-full-encodes-2026-08-10/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase4i-perceptual-metrics/1 ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
    author "GitHub Uploader"
}

record jpegxl-rs.work.arch-phase4l-single-pass-rate-search/1 : work {
    title "Phase 4L: measure and disposition the Fast/Full two-pass rate search"
    state superseded
    scope [
        path "JPXL/crates/jpxl-encode-policy/src/rate.rs",
        path "JPXL/crates/jpxl-encode-policy/tests/rate_loop.rs"
    ]
    intent """
        The Phase 4K measurements show that high-rate targets still spend the Fast cap before Full refinement, while current real-photo runs duplicate 8-20 Fast prices with 6 Full prices even when the target is reached. Measure whether the Fast upper-bound pass still pays after the existing cross-probe cache and aimed stepping. Trial a single Full-priced ladder from the request start, retaining the exact incumbent emission. Promote it only if it preserves never-over and non-monotone search contracts, improves or preserves target adherence, and materially reduces real-photo price count or wall time. An honest negative result is acceptable; do not raise max_prices to hide an inefficient search.
        """
    acceptance {
        check rate-contracts-hold {
            statement """
                The rate loop remains never-over, respects the price cap, survives the injected non-monotone cases, and all real-image rate-loop tests pass.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode-policy --lib --test rate_loop"
            verified_by [ @jpegxl-rs.evidence.phase4l-full-only-contracts-2026-08-11/1 ]
        }
        check real-photo-search-improves {
            statement """
                On pinned real-photo inputs, the selected design materially reduces total prices or wall time without worsening target adherence; otherwise the trial is reverted and the negative result is recorded.
                """
            method command
            command "cd JPXL && target/release/jpxl bench vardct-rate --input <pinned-photo.ppm> --iters 1 --bpp <target> --diag"
            verified_by [ @jpegxl-rs.evidence.phase4l-full-only-ab-negative-2026-08-11/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase4k-rate-loop-probe-reduction/1 ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
    source {
        kind internal
        role rationale
        path "JPXL/docs/HANDOFF.md"
        use """
            The Phase 4K entry identifies the remaining Fast-cap/full-refinement duplication and names the next lever.
            """
    }
}

