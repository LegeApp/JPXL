record jpegxl-rs.work.retire-handoff-ledger/1 : work {
    title "Retire HANDOFF.md as a duplicate ledger after AKR migration"
    state completed
    scope [
        path "AGENTS.md",
        path "JPXL/docs/CHANGELOG.md",
        path "JPXL/docs/HANDOFF.md",
        path "JPXL/docs/PLAN.md"
    ]
    intent """
        Complete the migration already declared by jpegxl-rs.decision.ledger-conventions: AKR records and generated views are the only live planning/handoff surface. The HANDOFF permanent sections have been audited: read_u32 wrapping, XYB inverse matrix, quant-bias defaults, modular LZ77 distance multiplier, asymmetric H.5.2 clamp, restoration filters off, E.4.4 tag count, modular 16-bit buffers, transcription-pipeline escalation, Annex H constants, C.2.6 alias mapping, and oracle output format all have matching decision or policy records. Replace the 2,185-line duplicate ledger with a short legacy tombstone, update contributor and changelog instructions to point to AKR/generated views, and preserve historical detail through Git history and the migrated records. Frozen experiment reports are not edited; the tombstone explains that their historical HANDOFF references resolve through Git history.
        """
    acceptance {
        check durable-facts-in-akr {
            statement """
                Every permanent Already-fixed/Trap item in HANDOFF.md has a corresponding AKR decision or policy record.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.retire-handoff-durable-facts-2026-08-11/1 ]
        }
        check legacy-tombstone-only {
            statement """
                JPXL/docs/HANDOFF.md is a concise legacy redirect rather than a second plan, experiment database, or dated work ledger.
                """
            method command
            command "wc -l JPXL/docs/HANDOFF.md"
            verified_by [ @jpegxl-rs.evidence.retire-handoff-tombstone-2026-08-11/1 ]
        }
        check no-live-handoff-workflow {
            statement """
                Contributor and changelog instructions no longer direct work-in-progress or handoff updates into HANDOFF.md; remaining HANDOFF references are the legacy tombstone or frozen historical experiment citations.
                """
            method command
            command "rg -n 'HANDOFF.md|HANDOFF' AGENTS.md JPXL/docs --glob '*.md'"
            verified_by [ @jpegxl-rs.evidence.retire-handoff-no-live-workflow-2026-08-11/1 ]
        }
    }
    implements [ @jpegxl-rs.decision.ledger-conventions/1 ]
}
