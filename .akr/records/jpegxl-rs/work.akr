record jpegxl-rs.work.arch-phase5d-cover-quality-screen/1 : work {
    title "Phase 5D: screen transform-cover decisions for perceptual regret"
    state completed
    scope [
        path ".agent/scratch/**",
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode-policy/src/block.rs",
        path "JPXL/crates/jpxl-encode-policy/src/regret.rs",
        path "JPXL/crates/jpxl-encode-policy/src/request.rs",
        path "test-set/**"
    ]
    intent """
        Expose the two existing VarDCT cover policies as a research control and compare fixed DCT8x8 against the hierarchical DCT8/16/32 cover at matched target rate, using the Phase 5A/5C defaults and symmetric djxl decoding. This is the cheapest counterfactual test of whether the current coefficient-SSE cover objective makes Butteraugli-wrong transform decisions before building rectangular or special-transform support.
        """
    note """
        If fixed DCT8x8 does not reveal meaningful perceptual regret, prune the brute-force alternative and retain the regret harness for more targeted counterfactuals.
        """
    acceptance {
        check cover-control {
            statement """
                The CLI can select fixed DCT8x8 or hierarchical cover for lossy research while untouched requests remain hierarchical.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode-policy -p jpxl-cli"
            verified_by [ @jpegxl-rs.evidence.phase5-scoped-tests-2026-08-11 ]
        }
        check decision {
            statement """
                The fixed-cover counterfactual is either retained as evidence of perceptual cover regret or pruned as an honest negative; no production change is made from an image-dependent or regressive result.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5d-fixed-cover-negative-2026-08-11 ]
        }
        check matched-rate-screen {
            statement """
                At least two distinct test-set photographs are encoded with both cover policies at matched target rate, decoded through djxl, and scored with Butteraugli and SSIMULACRA2.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5d-fixed-cover-negative-2026-08-11 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase5c-lf-hf-balance-screen ]
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.clean-room-boundary
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

record jpegxl-rs.work.arch-phase5e-epf-screen/1 : work {
    title "Phase 5E: screen EPF signalling before inverse modelling"
    state completed
    scope [
        path ".agent/scratch/**",
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-decode/src/vardct/render.rs",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/request.rs",
        path "JPXL/crates/jpxl-encode/src/vardct/headers.rs",
        path "test-set/**"
    ]
    intent """
        Temporarily expose epf_iters 0..3 as a research control and screen decoder EPF on top of the Phase 5A/5C policy using symmetric djxl decoding. The encoder has no EPF inverse or sharpness planner, so a positive screen only justifies modelling work; it does not justify a default change. A negative screen prunes unmodelled EPF and removes the temporary control.
        """
    note """
        The existing restoration-off policy rationale predates the decoder's current filter support and must be revised separately before any production restoration change.
        """
    acceptance {
        check epf-control {
            statement """
                The temporary CLI accepts only epf_iters 0..3 and untouched requests remain at zero.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode-policy -p jpxl-cli"
            verified_by [ @jpegxl-rs.evidence.phase5-scoped-tests-2026-08-11 ]
        }
        check scope-decision {
            statement """
                The result either justifies separately-scoped encoder-side EPF inversion/sharpness planning or records an honest negative and removes the temporary control; unmodelled EPF is never promoted directly.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5e-epf-signalling-noop-2026-08-11 ]
        }
        check screen {
            statement """
                At least two distinct test-set photographs are screened with EPF off and one or more nonzero iteration counts at matched target rate, decoded through djxl, and scored perceptually.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5e-epf-signalling-noop-2026-08-11 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase5c-lf-hf-balance-screen ]
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.clean-room-boundary
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

record jpegxl-rs.work.arch-phase5f-aqoff-oracle-compat/1 : work {
    title "Phase 5F: resolve AQ-Off HfMul oracle compatibility"
    state superseded
    scope [
        path ".agent/scratch/**",
        path "JPXL/crates/jpxl-decode/src/vardct/**",
        path "JPXL/crates/jpxl-encode-policy/src/field.rs",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/rate.rs",
        path "JPXL/crates/jpxl-encode-policy/tests/vardct_oracle.rs"
    ]
    intent """
        Minimise the AQ-Off/HfMul stream that djxl and jpxl-decode render consistently but jxl-oxide renders catastrophically differently; settle the standard semantics from the Part 1 LaTeX and concrete wire traces, then either correct JPXL if the candidate is nonconforming or document/report the external decoder defect with a standards-backed compatibility policy. Do not weaken or skip the existing oracle test merely to promote the measured quality win. Once all required oracles agree, re-run the three-photo AQ-Off plus quant_lf-8 gate and only then reconsider production defaults.
        """
    note """
        Current safe production policy remains Masking, quant_lf 16, LF fill enabled. The quality candidate remains accessible through --aq-mode off --quant-lf 8.
        """
    acceptance {
        check minimal-reproducer {
            statement """
                A minimal standards-cited HfMul/AQ-Off stream reproduces or eliminates the jxl-oxide disagreement while djxl and jpxl-decode outputs are captured.
                """
            method observation
        }
        check oracle-gate {
            statement """
                The existing VarDCT oracle suite passes without skipping or loosening the jxl-oxide assertions.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode-policy --test vardct_oracle"
        }
        check quality-regate {
            statement """
                If AQ Off becomes promotable, its three-photo matched-rate Butteraugli gate and default-control fingerprints are re-run on the resolved code.
                """
            method observation
        }
        check root-cause {
            statement """
                The disagreement is attributed to a concrete wire or rendering rule using Part 1 and bit-position evidence, not implementation source from libjxl.
                """
            method observation
        }
    }
    depends_on [
        @jpegxl-rs.work.arch-phase5a-aq-policy-gate,
        @jpegxl-rs.work.arch-phase5c-lf-hf-balance-screen
    ]
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.clean-room-boundary,
        @jpegxl-rs.policy.optimization-correctness-gates
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

