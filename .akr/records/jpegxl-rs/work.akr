akr 0.1
project jpegxl-rs

record jpegxl-rs.work.arch-phase0-instrumentation/1 : work {
    title "Phase 0: encode diagnostics and thread-scaling counters"
    state active
    intent """
        Instrument VarDCT plan stages (choose calls by cover/cfl_y/cfl_factor/final,
        stage wall times, candidate-forward and CfL sample memory proxies) and
        Modular plan multiplicity (residual scans, plane clone bytes). Expose via
        jpxl bench --diag. Measure 12 MP one-thread vs auto-thread for modular and
        vardct-fixed. Do not change encode outputs in this work.
        """
    acceptance {
        check counters-available {
            statement """
                jpxl bench --diag prints choose_total (or residual_scans) on a
                release binary for modular and vardct-fixed modes.
                """
            method command
        }
        check twelve-mp-diag-logged {
            statement """
                A scratch log under .agent/scratch/ records 12 MP diag lines for
                threads=1 and threads=auto for at least one VarDCT and one Modular
                path.
                """
            method observation
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
    author "grok-build"
    source {
        kind external
        path "sources/outside-advice.md"
        excerpt """
            Phase 0: Instrumentation and matched-quality testing
            """
    }
}

record jpegxl-rs.work.arch-phase1-output-preserving/1 : work {
    title "Phase 1: output-preserving encode speed fixes"
    state active
    intent """
        Output-preserving corrections from sources/outside-advice.md Phase 1:
        exact zero return and precomputed steps in HfQuantizer::choose; bounded
        block_cost and CfL residual cost; precomputed LF X/B factor costs;
        shared modular plane storage (no per-trial deep clone); specialized
        single-leaf residual paths for Gradient/Zero/West. Codestreams must
        stay byte-identical to the pre-Phase-1 encoder for the same requests.
        """
    acceptance {
        check byte-identical-default-paths {
            statement """
                Existing modular and VarDCT encode tests remain green; a golden
                fingerprint check (or unit tests asserting choose/cover identity)
                shows no output change for fixed inputs.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode -p jpxl-encode-policy --lib --release"
        }
        check plane-clone-down {
            statement """
                On a multi-megapixel modular encode, plane_clone_bytes from
                plan_for is far below the Phase-0 ~10GB (shared Arc path).
                """
            method observation
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
    author "grok-build"
    source {
        kind external
        path "sources/outside-advice.md"
        excerpt """
            Phase 1: Output-preserving corrections
            """
    }
}

record jpegxl-rs.work.arch-phase2-cfl-quant/1 : work {
    title "Phase 2: analytic CfL and once-final HF quant unit of work"
    state superseded
    intent """
        Replace frame-sized CflSample storage and per-candidate scalar choose
        refinement with closed-form tile CfL (CflAccumulator sufficient stats)
        and keep final HF quantization only on the selected cover. Optionally
        tighten final quant as a block/lane loop. Deterministic Contract A
        identity across threads is preserved. Codestreams may change vs Phase 1.
        """
    acceptance {
        check choose-cfl-down {
            statement """
                On 12 MP VarDCT defaults, choose_cfl_y and choose_cfl_factor are
                near zero (analytic path); choose_total is dominated by cover+final.
                """
            method observation
        }
        check tests-green {
            statement """
                jpxl-encode-policy and jpxl-encode lib tests pass in release.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode -p jpxl-encode-policy --lib --release"
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
    author "grok-build"
    source {
        kind external
        path "sources/outside-advice.md"
        excerpt """
            Phase 2: Replace the VarDCT quant/CfL unit of work
            """
    }
}

record jpegxl-rs.work.arch-phase2-cfl-quant/2 : work {
    title "Phase 2: analytic CfL and once-final HF quant unit of work"
    state completed
    intent """
        Replace frame-sized CflSample storage and per-candidate scalar choose
        refinement with closed-form tile CfL (CflAccumulator sufficient stats)
        and keep final HF quantization only on the selected cover. Optionally
        tighten final quant as a block/lane loop. Deterministic Contract A
        identity across threads is preserved. Codestreams may change vs Phase 1.
        """
    note """
        2026-08-07: two attempts to score the HF CfL factor purely from
        CflAccumulator's 3 sufficient statistics (no per-sample exact scoring)
        each regressed a real test -- see
        jpegxl-rs.evidence.phase2-analytic-cfl-regressed-correctness. The
        original choose-cfl-down acceptance check (near-zero choose_cfl_y and
        choose_cfl_factor) is not safely reachable without either richer
        per-tile statistics than a 2nd-moment regression, or a calibrated rate
        model built against the matched-quality harness outside-advice.md §19
        describes. Landed instead: factor_candidates window narrowed ±4 -> ±1,
        plus an exact-LS-neutral (seed==0) shortcut -- both still exact-oracle
        scored, just over fewer candidates, so no calibration risk.
        choose_total -39%, choose_cfl_factor -71%, tests green. Re-open the
        full analytic-CfL elimination only alongside Phase 0's matched-quality
        harness (or a richer per-tile summary), not as an isolated heuristic
        guess.
        """
    acceptance {
        check choose-cfl-down {
            statement """
                factor_candidates' search window is narrowed to seed±1 (from ±4) and refine_hf_factor short-circuits to the neutral factor when the closed-form least-squares seed is already 0, cutting choose_cfl_factor calls without changing the exact per-sample scoring semantics. Full elimination of choose_cfl_y/choose_cfl_factor is deferred -- see the note.
                """
            method observation
            verified_by [
                @jpegxl-rs.evidence.phase2-safe-window-narrowing-landed/1,
                @jpegxl-rs.evidence.phase2-safe-window-narrowing-landed-postcommit/1
            ]
        }
        check tests-green {
            statement """
                jpxl-encode-policy and jpxl-encode lib tests pass in release.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode -p jpxl-encode-policy --lib --release"
            verified_by [
                @jpegxl-rs.evidence.phase2-safe-window-narrowing-landed/1,
                @jpegxl-rs.evidence.phase2-safe-window-narrowing-landed-postcommit/1
            ]
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supersedes [ @jpegxl-rs.work.arch-phase2-cfl-quant/1 ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
}

record jpegxl-rs.work.arch-phase3-forward-cache/1 : work {
    title "Phase 3: eliminate the selected-forward clone; borrow from CandidateForwardCache"
    state superseded
    intent """
        outside-advice.md §7 flags two redundant retentions of full per-candidate
        HF coefficient vectors: CandidateForwardCache (every scored cover candidate,
        frame-wide, ~428 MB at 12 MP) and forward_selected's second owned clone of
        just the selected varblocks (~144 MB at 12 MP). This work eliminates the
        second one: split cover selection's per-group loop into two passes so every
        selected varblock's forward can be *borrowed* from CandidateForwardCache
        (now exposing a read-only get()) instead of cloned into groups. The first
        retention (CandidateForwardCache itself, which must keep every scored
        candidate -- winners and losers -- because the rate loop shares one cache
        across quantizer probes to avoid re-running the forward DCT per probe) is
        explicitly NOT touched by this work; see the note for why a naive LRU/FIFO
        cap on it is risky (could gut cross-probe reuse for RateSearchBudget's up to
        40 probes) and deferred pending a design that understands the rate loop's
        access pattern.
        """
    note """
        2026-08-07: landed the safe half (selected-forward clone). Verified
        output-preserving by construction (pure ownership/borrow restructuring, no
        decision logic touched) and confirmed via --diag fingerprint identity: 12MP
        vardct-fixed threads=1 output_bytes and fingerprint unchanged
        (1,530,188 / 30e55ba3faef4d64) both before and after, sel_clones/sel_bytes
        41,949/144,000,000 -> 0/0. All jpxl-encode + jpxl-encode-policy lib, oracle,
        roundtrip and rate_loop tests pass (the one pre-existing
        both_oracles_decode_a_stream_from_the_hf_mul_segment failure is unrelated,
        see jpegxl-rs.work.arch-phase2-cfl-quant's note).

        CandidateForwardCache itself (the ~428 MB frame-wide candidate retention,
        the larger of outside-advice §7's two numbers) is unaddressed. It backs
        cross-probe reuse in the rate loop (crates/jpxl-encode-policy/src/rate.rs:589
        keeps one CandidateForwardCache across all quantizer probes of one encode,
        so a probe's cover search can skip re-running the forward DCT for positions
        a prior probe already scored). A bounded cap (LRU/FIFO) risks evicting
        exactly the entries a later probe needs, which for RateSearchBudget's up to
        ~40 probes could turn a cache hit into 40x the forward-DCT work -- a real
        wall-clock regression, not just a missed win. A safe reduction here needs
        either: (a) a cap sized/validated against actual rate-loop access patterns
        (measure hit-rate degradation, not just implement and hope), or (b) the
        fuller outside-advice §8 redesign -- compact per-candidate summaries
        (estimated_rate/distortion/band_energy, not raw coefficient vectors) scored
        during cover search, with only the winning transform's exact coefficients
        ever materialized. (b) is the architecturally 'right' answer per outside-
        advice but is a much bigger change (touches block_cost/tile_region's
        candidate representation, not just an ownership pattern) and should get its
        own scoped work item rather than being bolted onto this one.
        """
    acceptance {
        check clone-eliminated {
            statement """
                --diag on a 12 MP VarDCT encode reports sel_clones=0 and sel_bytes=0.
                """
            method observation
            verified_by [
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated-postcommit/1
            ]
        }
        check output-unchanged {
            statement """
                The --diag fingerprint and output_bytes for a fixed 12 MP vardct-fixed encode are identical before and after (pure representational change, no decision logic touched).
                """
            method observation
            verified_by [
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated-postcommit/1
            ]
        }
        check tests-green {
            statement """
                jpxl-encode-policy and jpxl-encode lib, oracle, roundtrip and rate_loop tests pass (modulo the pre-existing, unrelated both_oracles_decode_a_stream_from_the_hf_mul_segment failure).
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode -p jpxl-encode-policy --lib --release && cargo test -p jpxl-encode-policy --test vardct_oracle --test vardct_roundtrip --test rate_loop"
            verified_by [
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated-postcommit/1
            ]
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
    source {
        kind external
        path "sources/outside-advice.md"
        excerpt """
            Section 7: The current forward cache is counterproductive
            """
    }
}

record jpegxl-rs.work.arch-phase3-forward-cache/2 : work {
    title "Phase 3: eliminate the selected-forward clone; borrow from CandidateForwardCache"
    state completed
    intent """
        outside-advice.md §7 flags two redundant retentions of full per-candidate
        HF coefficient vectors: CandidateForwardCache (every scored cover candidate,
        frame-wide, ~428 MB at 12 MP) and forward_selected's second owned clone of
        just the selected varblocks (~144 MB at 12 MP). This work eliminates the
        second one: split cover selection's per-group loop into two passes so every
        selected varblock's forward can be *borrowed* from CandidateForwardCache
        (now exposing a read-only get()) instead of cloned into groups. The first
        retention (CandidateForwardCache itself, which must keep every scored
        candidate -- winners and losers -- because the rate loop shares one cache
        across quantizer probes to avoid re-running the forward DCT per probe) is
        explicitly NOT touched by this work; see the note for why a naive LRU/FIFO
        cap on it is risky (could gut cross-probe reuse for RateSearchBudget's up to
        40 probes) and deferred pending a design that understands the rate loop's
        access pattern.
        """
    note """
        2026-08-07: landed the safe half (selected-forward clone). Verified
        output-preserving by construction (pure ownership/borrow restructuring, no
        decision logic touched) and confirmed via --diag fingerprint identity: 12MP
        vardct-fixed threads=1 output_bytes and fingerprint unchanged
        (1,530,188 / 30e55ba3faef4d64) both before and after, sel_clones/sel_bytes
        41,949/144,000,000 -> 0/0. All jpxl-encode + jpxl-encode-policy lib, oracle,
        roundtrip and rate_loop tests pass (the one pre-existing
        both_oracles_decode_a_stream_from_the_hf_mul_segment failure is unrelated,
        see jpegxl-rs.work.arch-phase2-cfl-quant's note).

        CandidateForwardCache itself (the ~428 MB frame-wide candidate retention,
        the larger of outside-advice §7's two numbers) was left unaddressed pending
        measurement -- see jpegxl-rs.evidence.phase3-rate-loop-cache-reuse-measured.

        2026-08-07 (later same day): measured it. Extended `jpxl bench vardct-rate
        --diag` with a new rate_diag= line surfacing RateOutcome.stats (fast_prices,
        full_prices, dct_cache_hits/misses -- fields that already existed but were
        never printed). Two images (4000x3000 and 1024x768, bpp=1.0, default
        max_prices=40 budget) both landed a ~96-97% cross-probe hit rate
        (6,349,453/6,595,028 and 497,050/513,177 respectively) over 23-25 total
        probes. Misses in both runs closely match a single vardct-fixed probe's
        unique candidate count, confirming every probe after the first scores the
        *same* candidate set (position+transform is quantizer-independent; only
        block_cost's score of each candidate depends on the probe's quantizer) and
        gets an almost-total cache hit.

        This answers the note's option (a): a size cap is **not viable**. The cache
        would need to retain essentially 100% of one frame's unique candidates to
        preserve this reuse, so capping it below that trades wall-time (up to ~23x
        more forward-DCT recomputation for evicted-then-needed entries) for a memory
        saving that shrinks to nothing as the cap approaches the size needed to avoid
        that cost. Option (b) -- outside-advice §8's compact-per-candidate-summary
        redesign (score cover candidates from summaries, materialize full
        coefficients only for the winner) -- is the only remaining path to actually
        shrinking this 428 MB, and it needs its own scoped work item: it changes
        block_cost/tile_region's candidate representation, not just a cache policy,
        so it carries real correctness/quality risk the way Phase 2's CfL rewrite
        did, not the representational-only safety of this work item's landed half.
        """
    acceptance {
        check clone-eliminated {
            statement """
                --diag on a 12 MP VarDCT encode reports sel_clones=0 and sel_bytes=0.
                """
            method observation
            verified_by [
                @jpegxl-rs.evidence.phase3-forward-cache-rev2-postcommit/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated-postcommit/1
            ]
        }
        check output-unchanged {
            statement """
                The --diag fingerprint and output_bytes for a fixed 12 MP vardct-fixed encode are identical before and after (pure representational change, no decision logic touched).
                """
            method observation
            verified_by [
                @jpegxl-rs.evidence.phase3-forward-cache-rev2-postcommit/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated-postcommit/1
            ]
        }
        check tests-green {
            statement """
                jpxl-encode-policy and jpxl-encode lib, oracle, roundtrip and rate_loop tests pass (modulo the pre-existing, unrelated both_oracles_decode_a_stream_from_the_hf_mul_segment failure).
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode -p jpxl-encode-policy --lib --release && cargo test -p jpxl-encode-policy --test vardct_oracle --test vardct_roundtrip --test rate_loop"
            verified_by [
                @jpegxl-rs.evidence.phase3-forward-cache-rev2-postcommit/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated/1,
                @jpegxl-rs.evidence.phase3-selected-forward-clone-eliminated-postcommit/1
            ]
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supersedes [ @jpegxl-rs.work.arch-phase3-forward-cache/1 ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
}

record jpegxl-rs.work.arch-s8-cover-lane-simd/1 : work {
    title "outside-advice.md §8 (S8), narrowed per Opus advisor review: bit-identical coefficient-lane SIMD for cover scoring"
    state completed
    intent """
        sources/outside-advice.md §8 ("Cover selection needs a surrogate-first
        design") asks for an analysis pass + compact per-candidate summaries +
        lower-bound pruning to replace block_cost's exact per-coefficient
        HfQuantizer::choose scoring. Before attempting that, an Opus advisor review
        (requested given the Phase 2 CfL near-misses at a much smaller decision
        surface) was run against the actual machinery (AnalysisAtlas,
        CandidateForwardCache, block_cost_bounded, tile_region, HfQuantizer::choose).
        Verdict: do not attempt the full §8 redesign this session -- a closed-form
        summary score has an unbounded-tail failure mode at cover selection's larger,
        more consequential decision surface (which transform exists, not just a
        correction factor). Recommended instead: a bit-identical coefficient-lane
        SIMD restructuring of block_cost_bounded's inner loop (outside-advice §3's
        "vectorize adjacent coefficients, not one cell's four candidates" -- the
        existing HfQuantizer::choose already has a SIMD path, but on the wrong axis),
        paired with an exact-agreement test harness proving zero divergence, as
        infrastructure that de-risks a later closed-form-scoring attempt without
        gambling on cover-decision correctness now. AnalysisAtlas is explicitly left
        untouched (expanding it now tunes features against a consumer -- the
        summary scorer -- that was deliberately deferred, repeating the atlas's own
        Milestone-1 mistake once already avoided).
        """
    note """
        2026-08-07: landed the recommended narrow slice. Added
        HfQuantizer::choose_lane4 (quantize.rs) -- four adjacent coefficients at
        once via `wide::f32x4`, same zero-threshold shortcut, same
        [0, estimate-1, estimate, estimate+1] candidate order and tie rule, same
        error semantics as four independent choose() calls, plus a whole-lane
        zero fast path (added after measurement showed the naive version -- always
        running the full candidate search even when the scalar zero-threshold
        shortcut would fire -- made cover_ms ~35% *slower* despite fewer choose()
        call-count in diagnostics, since a SIMD lane can't skip per-element work
        the way a scalar early return can). Added a non-simd fallback with the
        same signature (four scalar choose() calls) so callers don't feature-gate.
        Added score_channel_lanes (lib.rs) to drive it from block_cost_bounded:
        row-segment iteration (LLF-prefix skip per row, batches of 4 + scalar
        remainder), accumulating bits/weighted_sse and checking the Phase-1 cutoff
        at cell granularity, in the same raster order as before.

        Verified bit-identical by an exhaustive unit test
        (choose_lane4_is_bit_identical_to_four_scalar_choose_calls, quantize.rs)
        across 6 quantizer configurations (varying transform, HfMul, global_scale,
        qm_scale) and 10 target patterns per lane chosen to stress every boundary
        (zero threshold from both sides, half-integer ties, the |q|<=1 bias-adjust
        branch edge, both sides of MAX_QUANT), and by --diag fingerprint identity
        on real images (12MP: output_bytes/fingerprint 1,530,188 /
        30e55ba3faef4d64, unchanged). cover_ms improved from ~1784ms to a stable
        ~1524-1532ms (~14-15%) on the 12MP image after adding the whole-lane zero
        fast path. Full test suite green modulo the pre-existing, unrelated
        both_oracles_decode_a_stream_from_the_hf_mul_segment failure (documented
        against jpegxl-rs.work.arch-phase2-cfl-quant).

        Deferred, per the advisor's plan: FastDeadZone-in-scoring (a cheaper
        approximate quantizer used only for candidate scoring, gated by this same
        kind of agreement/regret harness generalized to a bounded-regret assertion
        rather than exact equality) and the full §8 closed-form summary redesign
        (needs either richer per-tile statistics than 2nd moments or the
        matched-quality harness outside-advice §19 describes).
        """
    acceptance {
        check bit-identical {
            statement """
                choose_lane4_is_bit_identical_to_four_scalar_choose_calls passes exhaustively across multiple quantizer configs and boundary-stressing target patterns; --diag fingerprint and output_bytes for a fixed 12MP vardct-fixed encode are unchanged.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode-policy --lib --release choose_lane4"
            verified_by [
                @jpegxl-rs.evidence.s8-cover-lane-simd-postcommit/1,
                @jpegxl-rs.evidence.s8-cover-lane-simd-verified/1
            ]
        }
        check measured-faster {
            statement """
                cover_ms on the 12MP vardct-fixed --diag benchmark is not slower than the pre-change baseline (it improved ~14-15% after the whole-lane zero fast path).
                """
            method observation
            verified_by [
                @jpegxl-rs.evidence.s8-cover-lane-simd-postcommit/1,
                @jpegxl-rs.evidence.s8-cover-lane-simd-verified/1
            ]
        }
        check tests-green {
            statement """
                jpxl-encode-policy lib tests (default and --no-default-features), vardct_roundtrip, vardct_oracle (modulo the pre-existing hf_mul_segment failure) and rate_loop all pass.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode-policy --lib --release && cargo test -p jpxl-encode-policy --lib --release --no-default-features && cargo test -p jpxl-encode-policy --test vardct_roundtrip --test vardct_oracle --test rate_loop --release"
            verified_by [
                @jpegxl-rs.evidence.s8-cover-lane-simd-postcommit/1,
                @jpegxl-rs.evidence.s8-cover-lane-simd-verified/1
            ]
        }
    }
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases,
        @jpegxl-rs.policy.sources-advice-completion
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
    supported_by [ @jpegxl-rs.assessment.encoder-architecture-outside-advice ]
    source {
        kind external
        path "sources/outside-advice.md"
        excerpt """
            Section 8: Cover selection needs a surrogate-first design
            """
    }
}

