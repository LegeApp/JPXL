record jpegxl-rs.work.arch-phase5g-aqoff-broader-corpus-gate/1 : work {
    title "Phase 5G: gate AQ Off plus quant_lf 8 on the representative corpus"
    state completed
    scope [
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode-policy/src/field.rs",
        path "JPXL/crates/jpxl-encode-policy/src/request.rs",
        path "test-set/**"
    ]
    intent """
        Measure the Phase 5A/5C AQ-Off plus quant_lf-8 candidate against the historical Masking/quant_lf-16 policy on four distinct 0.8 MP photographs and two distinct 4 MP photographs at 1 and 2 bpp. Decode every stream through the same pinned djxl and score measured Butteraugli plus SSIMULACRA2. Use byte-identical controls and exact achieved sizes; if rates differ materially, re-run finalists at a common target byte count. Add equal-rate cjxl e7 anchors only for the settled finalist. Promote, revise, or reject the default from the corpus evidence, not from one scene.
        """
    acceptance {
        check corpus-matrix {
            statement """
                All six distinct scenes are measured at 1 and 2 bpp for Masking/quant_lf16 and AQ-Off/quant_lf8 with symmetric djxl decoding and exact sizes.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5g-corpus-matrix-2026-08-11/2 ]
        }
        check default-decision {
            statement """
                The production AQ/LF policy is promoted, revised, or explicitly retained from the corpus and oracle evidence.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5g-target-default-2026-08-11/2 ]
        }
        check oracle-anchor {
            statement """
                The settled finalist has measured equal-rate cjxl e7 Butteraugli anchors on the representative scenes, with requested distance never substituted for measured distance.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5g-cjxl-equal-rate-anchors-2026-08-11/2 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase5f-aqoff-oracle-compat/2 ]
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases/1,
        @jpegxl-rs.policy.clean-room-boundary/1,
        @jpegxl-rs.policy.optimization-correctness-gates/1
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
}

