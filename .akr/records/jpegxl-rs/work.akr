record jpegxl-rs.work.optional-semantic-guidance-consumer/1 : work {
    title "Evaluate a license-neutral optional semantic-guidance input"
    state proposed
    scope [
        path ".agent/scratch/**",
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode-policy/src/field.rs",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/request.rs"
    ]
    intent """
        Define and screen an independently authored JPXL-side input for normalized semantic confidence layers, allowing raw-autotune or another external producer to adapt to it without a runtime or source dependency.
        """
    note """
        This is a deferred quality-policy experiment, not the next speed checkpoint. Start only with a scene-labelled fixed-rate corpus. Keep semantic inference time outside encoder timing or report it separately. The absent-guidance path must remain byte-identical.
        """
    acceptance {
        check cost-accounting {
            statement """
                Encoder overhead and any external inference overhead are measured and reported separately; promotion does not add another full exact-rate candidate unless it replaces already-paid work.
                """
            method observation
        }
        check default-byte-identity {
            statement """
                Absent guidance is byte-identical to the production encoder and deterministic guidance is bounded and geometry-validated.
                """
            method command
        }
        check fixed-rate-scene-screen {
            statement """
                A preregistered scene-labelled corpus compares absent guidance and semantic guidance at matched achieved rate using SSIMULACRA2, Butteraugli maximum and pnorm3, with per-class and pooled results.
                """
            method observation
        }
        check license-neutral-boundary {
            statement """
                JPXL defines its own versioned, codec-neutral guidance types and has no raw-autotune dependency or copied AGPL implementation; any producer adapter remains outside JPXL.
                """
            method manual
