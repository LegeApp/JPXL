record jpegxl-rs.work.arch-phase25-multi-quantizer-workspace/1 : work {
    title "Phase 25: reusable multi-quantizer coefficient workspace"
    state completed
    scope [
        path ".agent/scratch/**",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/rate.rs",
        path "JPXL/docs/optimize.md"
    ]
    intent """
        Share the physical HF coefficient arena across sequential rate-probe quantizers through a request-scoped reusable workspace. Anchor plans must be released after their exact price, and the finalist must be released before a correction plan is built. The change must preserve quantization arithmetic, entropy choices, deterministic output, decoder behavior, and the single retained final emission; it must not retain three frame-sized coefficient copies.
        """
    note """
        The reusable HF arena passed byte and decoded-image identity. The timing screen is mixed for general Balanced but positive on the targeted masking-AQ path; the higher-risk single-traversal representation remains a separate open question.
        """
    acceptance {
        check decoded-identity {
            statement """
                Candidate-decoded mid and large canonical PPMs remain byte-identical to baseline decodes.
                """
            method command
            command "bash .agent/scratch/phase25-multi-quantizer-workspace/identity.sh"
            verified_by [ @jpegxl-rs.evidence.phase25-identity-2026-08-16/2 ]
        }
        check focused-policy-tests {
            statement """
                The focused all-features policy tests and the workspace-arena invariant pass.
                """
            method command
            command "cargo test -p jpxl-encode-policy --all-features"
            verified_by [ @jpegxl-rs.evidence.phase25-policy-tests-2026-08-16/2 ]
        }
        check timing-screen {
            statement """
                The pinned image timing screen classifies general Balanced as mixed/neutral and masking-AQ as a targeted positive, without promoting a general baseline.
                """
            method command
            command "bash .agent/scratch/phase25-multi-quantizer-workspace/timing-balanced.sh; bash .agent/scratch/phase25-multi-quantizer-workspace/timing-masking-aq.sh"
            verified_by [ @jpegxl-rs.evidence.phase25-timing-2026-08-16/2 ]
        }
        check wire-identity {
            statement """
                Fast, Balanced, Quality, large Fast, and masking-AQ codestream bytes remain identical to the baseline.
                """
            method command
            command "bash .agent/scratch/phase25-multi-quantizer-workspace/identity.sh"
            verified_by [ @jpegxl-rs.evidence.phase25-identity-2026-08-16/2 ]
        }
        check workspace-safety {
            statement """
                The workspace tests, build, and formatting gates pass.
                """
            method command
            command "cargo test --workspace; cargo build --workspace; cargo fmt --all --check"
            verified_by [
                @jpegxl-rs.evidence.phase25-build-2026-08-16/1,
                @jpegxl-rs.evidence.phase25-format-2026-08-16/1,
                @jpegxl-rs.evidence.phase25-workspace-tests-2026-08-16/1
            ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase24-hfmul-overlay/3 ]
    part_of [ @jpegxl-rs.track.encoder-optimization ]
}

record jpegxl-rs.work.arch-phase27-finalist-only-entropy/1 : work {
    title "Phase 27: finalist-only entropy refinement"
    state completed
    scope [
        path ".agent/scratch/**",
        path "JPXL/crates/jpxl-encode-policy/src/**/tests/**",
        path "JPXL/crates/jpxl-encode-policy/src/diagnostics.rs",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/rate.rs",
        path "JPXL/docs/optimize.md"
    ]
    intent """
        Reduce the repeated Quality Full-path entropy candidate work identified by Phase 26. Navigate the refinement ladder with the existing exact Fast entropy model, then run the expensive Full entropy alternatives only for the selected finalist and any bounded exact correction required by the target contract. Keep the final emission exact, wire-valid, and guarded by the in-tree decode/target gate; do not introduce SIMD or approximate codestream sizing in this work.
        """
    note """
        The change is a search-policy optimization, so byte identity with the prior Quality stream is not assumed. The acceptance gate is exact final pricing, never-over target adherence, decode validity, and measured quality/rate comparison on the pinned corpus.
        """
    acceptance {
        check final-exact-price {
            statement """
                The selected finalist is emitted from an exact Full entropy plan and its recorded size equals the emitted codestream size.
                """
            method command
            verified_by [
                @jpegxl-rs.evidence.phase27-finalist-only-entropy-correctness-2026-08-16/2
            ]
        }
        check multiplicity-reduction {
            statement """
