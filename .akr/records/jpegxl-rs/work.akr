            verified_by [ @jpegxl-rs.evidence.modular-effort-ramp-landed-2026-08-10/1 ]
        }
        check tests-green {
            statement """
                Every effort level reconstructs pixels exactly and round-trips; level 7 reproduces the pre-ramp search field-for-field.
                """
            method command
            command "cargo test -p jpxl-encode --lib"
            verified_by [ @jpegxl-rs.evidence.modular-effort-ramp-tests-2026-08-10/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase4b-sampled-gather-scoped/1 ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
}

record jpegxl-rs.work.arch-phase4f-elide-foregone-search/1 : work {
    title "Phase 4F: elide the modular search when the effort budget already fixes its answer"
    state completed
    scope [ path "JPXL/crates/jpxl-encode/src/lossless.rs" ]
    intent """
        Stop paying for a search whose answer the effort budget already fixed.

        At the default effort the modular planner's levers are degenerate: one predictor, an empty split property/threshold grid, no leaf refinement, and neither the palette nor the squeeze trial. The predictor sweep has nothing to rank, the greedy split loop's inner loops never execute so it breaks having improved nothing, and no later stage can move the answer. The plan is exactly single_leaf(predictors[0]) with the caller's rct and neither transform -- yet plan_for still paid for it: a full RCT scoring copy of every plane, an Arc wrap of every plane, and a strided cheap residual scan of the whole frame. At 12 MP that is two 144 MB plane copies plus a scan, all discarded.

        Add ModularSearchBudget::search_is_a_foregone_conclusion and return the settled plan directly when it holds. Split the search body out as plan_by_full_search so the elision can be proved equivalent by running both paths on the same input, not merely argued in a comment.

        This is a pure work-elision change: identical bytes at every effort, by construction and by corpus fingerprint.
        """
    acceptance {
        check bytes-unchanged {
            statement """
                The corpus fingerprints are unchanged at the default effort and at the level-7 density anchor.
                """
            method command
            command "pwsh -NoProfile -File .agent/scratch/effort-ramp-2026-08-10/verify_default_flip.ps1"
            verified_by [ @jpegxl-rs.evidence.phase4f-bytes-unchanged-2026-08-10/1 ]
        }
        check elision-is-equivalent {
            statement """
                For every effort level the short-circuit claims, it produces the same plan the full search would have, across both rct polarities and both channel counts; and the whole suite stays green.
                """
            method command
            command "cargo test -p jpxl-encode --lib"
            verified_by [ @jpegxl-rs.evidence.phase4f-elision-equivalent-2026-08-10/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase4e-modular-effort-ramp/1 ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
    author "GitHub Uploader"
}

record jpegxl-rs.work.arch-phase4g-bounded-ranker-and-unit-fix/1 : work {
    title "Phase 4G: bound the cheap ranker's cost, and fix the sampled-residual vs whole-frame-tree unit mismatch"
    state completed
    scope [
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode/src/lossless.rs",
        path "JPXL/crates/jpxl-encode/src/modular/mod.rs"
    ]
    intent """
        Bound the modular cheap ranker's cost independently of frame size, so tree depth stops being unaffordable at 12 MP; then measure whether depth was ever the thing worth affording.

        Two changes. First, ModularSearchBudget gains cheap_sample_budget: a target number of scored samples per candidate. cheap_row_stride becomes a floor rather than the stride itself, and effective_cheap_stride derives the real stride once at the plan_by_full_search stage boundary from (budget, width, height, plane count). A stride is a ratio, so a fixed stride still costs frame_area/stride -- linear in frame size, which is exactly why the tree had to be collapsed on large frames. A sample budget is an absolute bound.

        Second -- and this turned out to matter far more -- lossless::total_cost_source added an unscaled whole-frame ma_tree_bit_cost * sections to a residual estimate that covered only 1/row_stride of the frame. The two terms were in different units. A split's residual saving was divided by the stride while its tree cost was not, so every extra context was over-priced by exactly the sampling ratio, and worse as frames grew. modular::estimate_residual_bits_sampled now extrapolates its data cost to whole-frame bits (the fixed table overhead is not extrapolated -- one set of ANS tables is emitted however densely the estimate sampled), putting both terms in the same unit the Exact tier already speaks.

        Also adds EncodeOptions::modular_search_overrides and four `jpxl bench modular` flags, so the ladder's constants can be swept and chosen from evidence instead of guessed.
        """
    acceptance {
        check bound-and-identity-tests {
            statement """
                The sample budget is provably a no-op below the budget, provably bounds scored samples above it, is inert when no override is set, and the whole suite stays green.
                """
            method command
            command "cargo test -p jpxl-encode --lib"
            verified_by [ @jpegxl-rs.evidence.phase4g-bound-and-identity-tests-2026-08-10/1 ]
        }
        check default-unchanged {
            statement """
                The default effort's output is byte-identical on the photo corpus: this work changes what the opt-in density levels find, never what a default encode emits.
                """
            method command
            command "pwsh -NoProfile -File .agent/scratch/effort-ramp-2026-08-10/verify_default_flip.ps1"
            verified_by [ @jpegxl-rs.evidence.phase4g-default-unchanged-2026-08-10/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase4f-elide-foregone-search/1 ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
    author "GitHub Uploader"
}

record jpegxl-rs.work.arch-phase4h-lossy-reachable-and-measurable/1 : work {
    title "Phase 4H: make the lossy VarDCT path reachable from the CLI and measurable against the oracle"
    state completed
    scope [
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-conformance/src/metrics.rs"
    ]
    intent """
        Make the lossy VarDCT path reachable and measurable. It has been the more complete half of this encoder since M1-M8, but nothing outside the library and `jpxl bench` could invoke it, and it had never been compared against the oracle at all -- the same blind spot that let the modular effort ladder ship inert for a whole phase.

        Three small pieces, no encoder change:
        - `jpxl encode --bpp <f>` / `--target-bytes <n>` route to jpxl_encode_policy::encode_srgb8_to_target. Without a rate flag the command stays the lossless modular encoder it has always been. 8-bit RGB only, because the VarDCT path converts sRGB8 to XYB and has no route for greyscale or deeper samples; anything else is refused rather than silently mangled.
        - Deliberately NO `--distance` flag. cjxl's -d targets butteraugli; this encoder has no perceptual model and its rate loop hits a size. Naming a flag --distance would promise something the encoder cannot deliver.
        - jpxl_conformance::metrics gains rmse and psnr over the integer PPM Image type. RMSE previously existed only on the NPY FloatImage conformance path, which grades a decode against a float reference per channel -- not what comparing two encoders needs. `jpxl compare <ref.ppm> <b.ppm>` exposes them so a rate/distortion sweep is drivable from a shell script with no numpy.

        PSNR is used because it is exactly reproducible in-repo, not because it is the right quality model; the harness documents that the only fair reading is the curve, never a single operating point.
        """
    acceptance {
        check lossy-is-reachable-end-to-end {
            statement """
                `jpxl encode --bpp` produces a codestream that hits its rate target and that both jpxl-decode and the independent djxl oracle accept.
                """
            method command
            command "pwsh -NoProfile -File .agent/scratch/effort-ramp-2026-08-10/headsup-lossy.ps1"
            verified_by [ @jpegxl-rs.evidence.phase4h-lossy-reachable-2026-08-10/1 ]
        }
        check metrics-are-correct {
            statement """
                RMSE and PSNR match hand-computed values, return infinity rather than NaN for identical images, and return None on a shape mismatch as the neighbouring metrics do.
                """
            method command
            command "cargo test -p jpxl-conformance --lib"
            verified_by [ @jpegxl-rs.evidence.phase4h-metrics-correct-2026-08-10/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase4g-bounded-ranker-and-unit-fix/1 ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
    author "GitHub Uploader"
}

record jpegxl-rs.work.arch-phase4i-perceptual-metrics/1 : work {
    title "Phase 4I: SSIMULACRA2 and butteraugli as opt-in metrics, plus undershoot diagnostics"
    state completed
    scope [ path "JPXL/crates/jpxl-cli/**", path "JPXL/crates/jpxl-conformance/**" ]
    intent """
        Grade lossy output on metrics that mean something. PSNR was the only distortion metric in this repository, and it measures signal error rather than what anyone looks at -- which made every comparison against cjxl an argument about the wrong axis.

        Add two, both behind off-by-default features in jpxl-conformance, both reachable from `jpxl compare --features perceptual`:
        - ssimulacra2 0.5 (BSD-2-Clause): higher is better, 100 = identical, calibrated against human ratings.
        - butteraugli 0.9 (BSD-3-Clause, pure Rust): lower is better, 0 = identical. `distance` is the max-norm libjxl calls the butteraugli distance -- the quantity `cjxl -d` targets -- reported alongside libjxl's 3-norm aggregation.

        Also: `jpxl encode --bpp` now reports when it undershoots its rate target, and distinguishes a saturated ladder (no extra budget can help) from a search that spent its price budget short of the target. That distinction is the measurement needed before anything is built to fix the undershoot.

        Dependency posture: no normative crate depends on either metric, and a default `cargo build --workspace` fetches neither. They stay opt-in because AGENTS.md section 6 bans thiserror from this project's own error types, and that ban should not be dodged by pulling it in transitively on the default path.

        Clean-room posture (AGENTS.md section 2): the butteraugli crate is a permissively-licensed port of libjxl's butteraugli. Using it to GRADE output is the same category as running cjxl/djxl as oracles. Wiring it into this encoder's own rate control would be a different decision -- it would make our perceptual model a derivative of libjxl's rather than one derived from the standard -- and must be recorded as such before anyone does it.
        """
    acceptance {
        check metrics-are-correct-and-directional {
            statement """
                Both metrics hit their defined identity value, move the right way as distortion rises, agree with each other on which of two images is worse despite opposite scales, and decline the inputs they cannot score.
                """
            method command
            command "cargo test -p jpxl-conformance --lib --features perceptual"
            verified_by [ @jpegxl-rs.evidence.phase4i-metrics-correct-2026-08-10/1 ]
        }
        check off-by-default-and-lint-clean {
            statement """
                The default build neither fetches nor references the metric crates, and both feature configurations are fmt- and clippy-clean.
                """
            method command
            command "cargo clippy -p jpxl-cli -p jpxl-conformance --all-targets"
            verified_by [ @jpegxl-rs.evidence.phase4i-off-by-default-2026-08-10/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase4h-lossy-reachable-and-measurable/1 ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
    author "GitHub Uploader"
}

record jpegxl-rs.work.arch-phase4j-aq-tuning-measurable/1 : work {
    title "Phase 4J: make the AQ field's perceptual constants data, and sweep them"
    state completed
    scope [
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode-policy/src/field.rs",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/request.rs"
    ]
    intent """
        Make the perceptual bit-allocation policy measurable, then measure it.

        The lossy deficit against cjxl is 12-20% on SSIMULACRA2 but 39-53% on butteraugli (jpegxl-rs.observation.lossy-perceptual-baseline-2026-08-10). A gap that much larger on one perceptual metric than another localises the problem to where bits go within a frame, not to coding efficiency -- which both metrics would punish alike. That points at the adaptive-quantization field, whose three constants (AQ_STRENGTH 0.25, AQ_CLAMP 1.0, CHROMA_AQ_WEIGHT 0.35) came from the 8-bit x265-family literature and had never been checked against a perceptual metric on this codec's output, because until this session the repository had none.

        Turn those constants into data: AqTuning on SearchBudget, DesiredQuantField::from_atlas_tuned, and `jpxl encode --aq-strength/--aq-clamp/--aq-chroma`. AqTuning::default() is exactly the historical values, so an untouched request encodes as before; out-of-range knobs are clamped into what the HfMul lattice can express.

        The sweep this enabled found something larger than a mistuned constant, recorded in jpegxl-rs.observation.aq-field-is-a-net-perceptual-loss-2026-08-10: at matched bitrate, turning the field OFF beats every tuning tried, on both perceptual metrics, at both rates measured. That is a finding, not yet a default change -- the evidence is one image at two rates.
        """
    acceptance {
        check default-tuning-is-the-old-field {
            statement """
                AqTuning::default() reproduces the previously hardcoded field atom for atom in both AQ directions, the knobs move the field in the direction their names promise, and out-of-range values are sanitised rather than producing an unrepresentable field.
                """
            method command
            command "cargo test -p jpxl-encode-policy --lib"
            verified_by [
                @jpegxl-rs.evidence.phase4j-tuning-is-default-preserving-2026-08-10/1
            ]
        }
        check sweep-runs-end-to-end {
            statement """
                The sweep encodes at a fixed bitrate across tunings and scores each perceptually, so the bit-allocation policy can be chosen from evidence.
                """
            method command
            command "pwsh -NoProfile -File .agent/scratch/effort-ramp-2026-08-10/aq-sweep.ps1 small_0p8MP 2.0"
            verified_by [ @jpegxl-rs.evidence.phase4j-sweep-runs-2026-08-10/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase4i-perceptual-metrics/1 ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
    author "GitHub Uploader"
}

record jpegxl-rs.work.arch-phase4k-rate-loop-probe-reduction/1 : work {
    title "Phase 4K: cut rate-loop probe count -- tolerance exit, aimed stepping with a non-monotone safety rule, Full reserve as a cap"
    state completed
    scope [ path "JPXL/crates/jpxl-encode-policy/src/rate.rs" ]
    intent """
        Cut the number of full encodes a targeted lossy encode pays for. A rate search runs 15-40 exact prices, each one a complete frame encode, and that -- not per-probe cover cost -- is the 58-530x speed gap against cjxl. It is also why high targets are missed: the measured cause of the undershoot is the Fast ladder exhausting its 24-price cap, not the quantizer ladder running out of rungs.

        Three changes, in increasing order of how much they need proving.

        1. TOLERANCE EXIT. The bisection had no stopping condition for "the caller's tolerance is already met". It stopped only when the remaining opportunity was bounded (hi - best <= slack), which on a smooth curve needs the bracket narrowed to ~1% in SIZE and therefore costs most of the bisection. Now it also stops once target - best <= slack. Safe by construction: `best` only improves, so stopping early cannot change which of the priced candidates is returned; it only declines to price more.

        2. AIMED STEPPING, with a safety rule. Bisection needs ~log2(width) prices and the ladder is ~2^17 rungs, which is more than the budget has after bracketing. A false-position step on log(size) against log(effective quantizer scale) usually lands within a rung or two. Interpolating on the RUNG INDEX would aim badly, because the index is not proportional to the quantizer -- above MAX_GLOBAL_SCALE each rung is an HfMul step worth a whole MAX_GLOBAL_SCALE of the lower segment -- so the interpolation runs on global_scale * HfMul, which is smooth across the kink.

           The safety rule is the part that matters: AN AIMED PROBE MAY MOVE `lo` UP BUT NEVER BECOMES THE NEW `hi`. On a non-monotone size function, `hi` infeasible does NOT imply everything above `hi` is infeasible, so a badly-aimed probe that tightened `hi` could fence the incumbent off from a better feasible rung above it. Moving `lo` up is always safe: `lo` only advances to rungs proved feasible and `best` is the largest feasible ever priced, so a longer jump finds the answer sooner and cannot skip past it. Termination still comes from the interleaved midpoint steps, which do tighten `hi`.

           Aiming is also abandoned permanently after one aimed probe comes back infeasible: under the safety rule such a probe cannot narrow the bracket, so it is a wasted full encode, and the same curve misfit would keep costing one per round. That bounds the worst case at "bisection plus one wasted probe" instead of "half the budget on probes that do not narrow anything", which is what a high-rate target on a stiff curve was measured doing.

        3. THE FULL RESERVE BECOMES A CAP, NOT A FLOOR. Full refinement was given max_prices - used_by_fast. Before aimed stepping the Fast ladder nearly always spent its whole allowance so the distinction never showed; now that Fast can finish in a handful of prices, handing Full the remainder would spend the saving on more expensive-entropy probes instead of banking it, and breaks the "finalist-only Full" invariant that RateProbeStats::full_confined_to_refinement asserts.
        """
    acceptance {
        check contracts-hold {
            statement """
                The loop still never exceeds its target, still lands within tolerance where the ladder can express it, still respects the price cap, and still finds the global optimum on a non-monotone sawtooth; and an aimed probe landing in an infeasible spike does not fence off the better rungs above it.
                """
            method command
            command "cargo test -p jpxl-encode-policy --lib"
            verified_by [ @jpegxl-rs.evidence.phase4k-contracts-hold-2026-08-10/1 ]
        }
        check fewer-full-encodes {
            statement """
                Real targeted encodes complete in materially fewer prices and less wall time than before.
                """
            method command
            command "jpxl encode <corpus>.ppm out.jxl --bpp N"
            verified_by [ @jpegxl-rs.evidence.phase4k-fewer-full-encodes-2026-08-10/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase4i-perceptual-metrics/1 ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
    author "GitHub Uploader"
}

record jpegxl-rs.work.arch-phase4l-single-pass-rate-search/1 : work {
    title "Phase 4L: measure and disposition the Fast/Full two-pass rate search"
    state superseded
    scope [
        path "JPXL/crates/jpxl-encode-policy/src/rate.rs",
        path "JPXL/crates/jpxl-encode-policy/tests/rate_loop.rs"
    ]
    intent """
        The Phase 4K measurements show that high-rate targets still spend the Fast cap before Full refinement, while current real-photo runs duplicate 8-20 Fast prices with 6 Full prices even when the target is reached. Measure whether the Fast upper-bound pass still pays after the existing cross-probe cache and aimed stepping. Trial a single Full-priced ladder from the request start, retaining the exact incumbent emission. Promote it only if it preserves never-over and non-monotone search contracts, improves or preserves target adherence, and materially reduces real-photo price count or wall time. An honest negative result is acceptable; do not raise max_prices to hide an inefficient search.
        """
    acceptance {
        check rate-contracts-hold {
            statement """
                The rate loop remains never-over, respects the price cap, survives the injected non-monotone cases, and all real-image rate-loop tests pass.
                """
            method command
            command "cd JPXL && cargo test -p jpxl-encode-policy --lib --test rate_loop"
            verified_by [ @jpegxl-rs.evidence.phase4l-full-only-contracts-2026-08-11/1 ]
        }
        check real-photo-search-improves {
            statement """
                On pinned real-photo inputs, the selected design materially reduces total prices or wall time without worsening target adherence; otherwise the trial is reverted and the negative result is recorded.
                """
            method command
            command "cd JPXL && target/release/jpxl bench vardct-rate --input <pinned-photo.ppm> --iters 1 --bpp <target> --diag"
            verified_by [ @jpegxl-rs.evidence.phase4l-full-only-ab-negative-2026-08-11/1 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase4k-rate-loop-probe-reduction/1 ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
    source {
        kind internal
        role rationale
        path "JPXL/docs/HANDOFF.md"
        use """
            The Phase 4K entry identifies the remaining Fast-cap/full-refinement duplication and names the next lever.
            """
    }
}

