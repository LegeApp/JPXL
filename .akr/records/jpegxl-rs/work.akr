record jpegxl-rs.work.opt-v1-count-only-and-arenas/1 : work {
    title "Opt-V1 count-only pricing and coefficient arenas"
    state superseded
    intent """
        Finish Opt-V1 structural sharing: count-only BitWriter path for exact
        price_codestream without retaining section payloads; group-scoped HF
        coefficient arenas so varblocks share one Arc buffer; reuse quantize
        scratch. Arc plan payloads and Gaborish-once already land. Fixed-input
        codestreams stay byte-identical (Contract A).
