record jpegxl-rs.work.arch-phase5p-special8-exact-distortion-screen/1 : work {
    title "Phase 5P: screen special transforms with exact sample-domain distortion"
    state completed
    scope [
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/regret.rs",
