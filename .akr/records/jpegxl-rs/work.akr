}

record jpegxl-rs.work.arch-phase5j-two-pass-error-aq-screen/1 : work {
    title "Phase 5J: screen two-pass reconstruction-error AQ"
    state completed
    scope [
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode-policy/src/field.rs",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
        path "JPXL/crates/jpxl-encode-policy/src/request.rs",
        path "JPXL/crates/jpxl-encode-policy/tests/rate_loop.rs",
        path "JPXL/crates/jpxl-encode-policy/tests/vardct_oracle.rs",
        path "test-set/**"
    ]
    intent """
        Add a research-only, deterministic two-pass AQ mode. Freeze transform cover and CfL from the ordinary plan; perform a uniform-HfMul analysis quantization, reconstruct each selected varblock through the encoder's normative transform/quantization path, spread measured HF reconstruction error to 8x8 atoms, and derive a bounded log-domain HfMul field for the final quantization. Screen two representative 0.8 MP scenes at one and two bpp against the Phase 5I target policy. Broaden only if Butteraugli has no material regression and at least one meaningful win; keep production AqMode::Off unless the full corpus promotion contract passes.
        """
    acceptance {
        check implementation-proof {
            statement """
                Targeted tests prove the two-pass mode is deterministic, bounded, neutral on uniform input, and changes the field on textured input.
                """
            method command
            verified_by [
                @jpegxl-rs.evidence.phase5j-two-pass-error-implementation-2026-08-11/1
            ]
        }
        check oracle-proof {
            statement """
                djxl and jxl-oxide both decode a stream emitted with two-pass reconstruction-error AQ within the existing decoder-agreement bound.
                """
            method command
            verified_by [ @jpegxl-rs.evidence.phase5j-two-pass-error-oracle-2026-08-11/1 ]
        }
        check quality-screen {
            statement """
                Matched-rate Butteraugli and SSIMULACRA2 results on the representative screen determine whether to broaden, revise, or reject the two-pass signal.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.phase5j-two-pass-error-quality-2026-08-11/2 ]
        }
    }
    depends_on [ @jpegxl-rs.work.arch-phase5i-active-epf-screen/1 ]
    implements [
        @jpegxl-rs.decision.encoder-architecture-phases/1,
        @jpegxl-rs.policy.optimization-correctness-gates/1
    ]
    part_of [ @jpegxl-rs.track.encoder-optimization/1 ]
}

