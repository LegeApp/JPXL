record jpegxl-rs.papercut.cargo-fmt-all-check-fails-on-code-committed-at/1 : papercut {
    title "`cargo fmt --all --check` fails on code committed at HEAD (25213f6):…"
    state verified
    statement """
        `cargo fmt --all --check` fails on code committed at HEAD (25213f6): jpxl-core/src/{color,dct}.rs, jpxl-encode/src/{lib,resources}.rs, jpxl-encode/src/modular/squeeze.rs, jpxl-encode/src/vardct/gaborish.rs and two blocks in jpxl-bitstream/src/writer.rs all carry pre-existing formatting drift. That makes scripts/ci-akr.sh's third gate red independently of any working-tree change, and it means running `cargo fmt` during ordinary work silently rewrites six files nobody touched -- exactly the hazard AGENTS.md section 10 warns about, now with a standing trigger. Separately, AGENTS.md section 5's documented gate `cargo clippy --workspace --all-targets -- -D warnings` cannot pass by construction: the workspace sets unwrap_used, indexing_slicing and cast_possible_truncation to "warn" and there are 100+ live hits, so -D warnings turns the project's own deliberate lint policy into errors.
        """
    observed_at git:cddce2b966a06b03e8ec92c096b3e1695d69ed55
    author "claude"
    created_at 2026-08-12
}

