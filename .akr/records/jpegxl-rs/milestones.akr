record jpegxl-rs.milestone.markdown-retired/1 : milestone {
    title "Phase E - markdown planning cut over to AKR"
    state completed
    intent """
        The generated views are the authoritative reading surface and CI enforces the
        ledger. Planning changes route through AKR, not hand-edited Markdown. Physical
        deletion of HANDOFF/PLAN/CONFORMANCE is left to the team, once the ledger also
        carries the full slice table and the conformance matrix.
        """
    acceptance {
        check cutover-wired {
            statement """
                CI (scripts/ci-akr.ps1 and .github/workflows/akr.yml) runs akr check, akr
                check --views-current, and cargo fmt --check; AGENTS.md routes planning
                through the ledger; and HANDOFF, PLAN and CONFORMANCE carry a banner
                demoting them to legacy reference that points at docs/generated.
                """
            method manual
            verified_by [ @jpegxl-rs.evidence.markdown-cutover ]
        }
    }
    after [ @jpegxl-rs.milestone.experiments-as-observations ]
    part_of [ @jpegxl-rs.track.akr-adoption ]
}

record jpegxl-rs.milestone.spine-bootstrap/1 : milestone {
    title "Phase A - AKR ledger spine live"
    state completed
    intent """
        Conventions decided; the adoption ledger exists; akr build emits the seven
        generated views; AGENTS.md already carries the AKR protocol.
        """
    acceptance {
        check builds {
            statement """
                akr build emits docs/generated and akr check reports no diagnostics.
                """
            method command
            command "akr build"
            verified_by [ @jpegxl-rs.evidence.spine-builds ]
        }
        check conventions {
            statement """
                A decision record fixes the namespace, scope convention, and kind crosswalk.
                """
            method manual
            verified_by [ @jpegxl-rs.evidence.spine-conventions ]
        }
    }
    part_of [ @jpegxl-rs.track.akr-adoption ]
    author "GitHub Uploader"
}
