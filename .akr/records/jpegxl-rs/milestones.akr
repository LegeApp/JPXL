record jpegxl-rs.milestone.markdown-retired/1 : milestone {
    title "Phase E - markdown planning retired"
    state proposed
    intent """
        CI runs akr check, akr check --views-current, and cargo fmt --check. HANDOFF,
        PLAN and CONFORMANCE are replaced by a pointer to docs/generated; the roadmap and
        lessons survive only as legacy citations; AGENTS.md workflow is cut over.
        """
    acceptance {
        check no-hand-plans {
            statement """
                No hand-edited planning markdown remains; the generated views are the
                reading surface and CI enforces akr check and views-current.
                """
            method manual
        }
    }
    after [ @jpegxl-rs.milestone.experiments-as-observations ]
    part_of [ @jpegxl-rs.track.akr-adoption ]
    author "GitHub Uploader"
}

record jpegxl-rs.milestone.spine-bootstrap/1 : milestone {
    title "Phase A - AKR ledger spine live"
    state completed
    intent """
        Conventions decided; the adoption ledger exists; akr build emits the seven
        generated views; AGENTS.md already carries the AKR protocol.
        """
    acceptance {
        check builds {
            statement """
                akr build emits docs/generated and akr check reports no diagnostics.
                """
            method command
            command "akr build"
            verified_by [ @jpegxl-rs.evidence.spine-builds ]
        }
        check conventions {
            statement """
                A decision record fixes the namespace, scope convention, and kind crosswalk.
                """
            method manual
            verified_by [ @jpegxl-rs.evidence.spine-conventions ]
        }
    }
    part_of [ @jpegxl-rs.track.akr-adoption ]
    author "GitHub Uploader"
}
