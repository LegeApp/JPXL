akr 0.1
project jpegxl-rs

record jpegxl-rs.milestone.durable-rulings/1 : milestone {
    title "Phase B - durable rulings imported"
    state completed
    intent """
        HANDOFF "Already fixed" becomes decisions; HANDOFF "Traps" becomes policies;
        LESSONS and resource limits become decisions and constraints; the ISO-18181
        crosswalk becomes terms and constraints.
        """
    acceptance {
        check rulings-captured {
            statement """
                Every HANDOFF do-not-redo and trap line exists as a decision or policy
                record, and DECISION-HISTORY.md reads as the authority.
                """
            method manual
            verified_by [ @jpegxl-rs.evidence.rulings-captured ]
        }
    }
    after [ @jpegxl-rs.milestone.spine-bootstrap ]
    part_of [ @jpegxl-rs.track.akr-adoption ]
    author "GitHub Uploader"
}

record jpegxl-rs.milestone.experiments-as-observations/1 : milestone {
    title "Phase D - experiments become observations"
    state proposed
    intent """
        Each docs/experiments note becomes an observation or evidence record with
        observed_at and watches on the source files it concerns, so it goes stale
        automatically and surfaces in REVIEW-REQUIRED.md.
        """
    acceptance {
        check queue-reflects-reality {
            statement """
                akr review-queue reflects the current stale and at-risk set, and the dated
                experiment notes are captured as records.
                """
            method manual
        }
    }
    after [ @jpegxl-rs.milestone.history-backfilled ]
    part_of [ @jpegxl-rs.track.akr-adoption ]
    author "GitHub Uploader"
}

record jpegxl-rs.milestone.history-backfilled/1 : milestone {
    title "Phase C - history M1-M8 backfilled as legacy"
    state completed
    intent """
        Import M1-M8 milestones and their slices as completed records carrying
        source { kind legacy }; D-028 exempts their old evidence commits from the
        descendant-commit gate.
        """
    acceptance {
        check history-green {
            statement """
                M1-M8 render as completed in ROADMAP.md and akr check is clean with zero
                AKR-R022.
                """
            method command
            command "akr check"
            verified_by [ @jpegxl-rs.evidence.history-backfilled ]
        }
    }
    after [ @jpegxl-rs.milestone.durable-rulings ]
    part_of [ @jpegxl-rs.track.akr-adoption ]
    author "GitHub Uploader"
}

record jpegxl-rs.milestone.m1-plan-ir/1 : milestone {
    title "M1 - VarDCT plan IR and structural split"
    state completed
    intent """
        Create jpxl-encode-policy and define exact VarDCT plan types with validate() in jpxl-encode, so malformed plans cannot reach the writer.
        """
    acceptance {
        check typed-rejection {
            statement """
                A hand-built legal plan validates and dumps; malformed plans are rejected with typed errors, tested per invariant.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.m1-plan-ir ]
        }
    }
    part_of [ @jpegxl-rs.track.vardct-encoder ]
    author "GitHub Uploader"
    source {
        kind legacy
        path "JPXL/docs/PLAN.md"
        excerpt """
            Structural split + plan IR (M1)
            """
    }
}

record jpegxl-rs.milestone.m2-fixed-dct8/1 : milestone {
    title "M2 - Fixed-DCT8x8 VarDCT vertical slice"
    state completed
    intent """
        RGB8 to XYB, one frame, DCT8x8 only, default matrices, constant HfMul, natural order, one pass and preset, filters off, ANS.
        """
    acceptance {
        check three-decoders-accept {
            statement """
                JPXL, djxl and jxl-oxide all decode the stream; pixels are within the stated lossy tolerance; the section trace and ANS terminal state are valid.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.m2-fixed-dct8 ]
        }
    }
    after [ @jpegxl-rs.milestone.m1-plan-ir ]
    part_of [ @jpegxl-rs.track.vardct-encoder ]
    author "GitHub Uploader"
    source {
        kind legacy
        path "JPXL/docs/PLAN.md"
        excerpt """
            Fixed-DCT8x8 VarDCT vertical slice (M2)
            """
    }
}

record jpegxl-rs.milestone.m3-forward-transforms/1 : milestone {
    title "M3 - Forward transform algebra"
    state completed
    intent """
        Allocation-free forward forms for every supported transform, plus lf_from_llf.
        """
    acceptance {
        check forward-inverse-pairs {
            statement """
                Forward and inverse pair tests pass per transform, and a forced-transform-map encode decodes correctly end to end.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.m3-forward-transforms ]
        }
    }
    after [ @jpegxl-rs.milestone.m2-fixed-dct8 ]
    part_of [ @jpegxl-rs.track.vardct-encoder ]
    author "GitHub Uploader"
    source {
        kind legacy
        path "JPXL/docs/PLAN.md"
        excerpt """
            Forward transform algebra (M3)
            """
    }
}

record jpegxl-rs.milestone.m4-rate-loop/1 : milestone {
    title "M4 - Exact rate loop with fixed blocks"
    state completed
    intent """
        global_scale, HfMul, LF quant, target bpp, exact section accounting, and discrete budget fill.
        """
    acceptance {
        check byte-target-hit {
            statement """
                The encoder hits a byte target within the stated tolerance with fixed blocks; monotonicity checks are bracketed, not assumed.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.m4-rate-loop ]
        }
    }
    after [ @jpegxl-rs.milestone.m3-forward-transforms ]
    part_of [ @jpegxl-rs.track.vardct-encoder ]
    author "GitHub Uploader"
    source {
        kind legacy
        path "JPXL/docs/PLAN.md"
        excerpt """
            Exact rate loop, fixed blocks (M4)
            """
    }
}

record jpegxl-rs.milestone.m5-cfl/1 : milestone {
    title "M5 - Chroma-from-luma estimation"
    state completed
    intent """
        LF correlation plus per-64x64 HF factors: regression then integer refinement.
        """
    acceptance {
        check size-improves-no-regression {
            statement """
                Size improves at equal quality on a correlated-colour corpus with zero regression on grayscale.
                """
            method observation
            verified_by [ @jpegxl-rs.evidence.m5-cfl ]
        }
    }
    after [ @jpegxl-rs.milestone.m4-rate-loop ]
    part_of [ @jpegxl-rs.track.vardct-encoder ]
    author "GitHub Uploader"
    source {
        kind legacy
        path "JPXL/docs/PLAN.md"
        excerpt """
            CfL estimation (M5)
            """
    }
}

record jpegxl-rs.milestone.m6-block-selector/1 : milestone {
    title "M6 - Hierarchical block selector"
    state completed
    intent """
        DCT8/16/32 plus common rectangles, with exact DP within the hierarchy.
