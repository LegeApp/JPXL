record jpegxl-rs.evidence.phase6-0-frequency-spread-2026-08-12/1 : evidence {
    title "Phase 6.0 gate decided per channel: Y structured, X marginal, B flat"
    state verified
    result pass
    method observation
    observed_at git:cddce2b966a06b03e8ec92c096b3e1695d69ed55
    artifact "JPXL/docs/experiments/2026-08-12-distortion-currency-frequency-response.md"
    summary """
        Preregistered structured gate passes on Y (2.65x spread, every one of 15 cross-run Pearson r >= 0.961), marginally on X (2.35x, r 0.488-0.871, saturating), and fails on B (1.56x, r -0.057-0.951); write-up is the immutable experiment record
        """
}

record jpegxl-rs.evidence.phase6-1-flatten-decision-2026-08-12/1 : evidence {
    title "Phase 6.1 gate decided per channel: Y flattens to 1.86x, chroma unmeasurable at this operating point"
    state verified
    result pass
    method observation
    observed_at git:a015011c3d86727100e61f69d83d3a380b1d9888
    artifact "JPXL/docs/experiments/2026-08-12-quantizer-normalised-distortion.md"
    summary """
        Y flattens from 2.65x to 1.86x (all six individual runs flatter than their Phase 6.0 counterparts, min pairwise r 0.843), so the I.2.5 defaults carry about 36% of the log-domain weighting and quantizer-normalised distortion becomes a motivated Y-only change; X (2.35x to 6.76x) and B (1.56x to 11.60x) fail the gate but at amplitudes far outside any real operating point, so chroma is deferred rather than judged
        """
}

record jpegxl-rs.evidence.phase6-1-step-proportional-harness-2026-08-12/1 : evidence {
    title "Phase 6.1 step-proportional harness ran clean on the same corpus at matched injected energy"
    state verified
    result pass
    method command
    observed_at git:a015011c3d86727100e61f69d83d3a380b1d9888
    command "JPXL_CALIB_REF=.agent/scratch/realworld-bench-20260806T072202Z/{small_0p8MP,mid_4MP}.ppm JPXL_CALIB_SIDE=512 JPXL_CALIB_AMPS=0.25,0.5,1.0 cargo test --release -p jpxl-conformance --features perceptual --test perceptual_frequency -- --ignored --nocapture dct8x8_quantizer_normalised"
    summary """
        18 step-proportional runs (2 photographs x 3 XYB channels x 3 amplitudes x 64 cells) completed with the zero-self-distance assertion and sample-domain SSE control intact; RMS-normalised step shapes were X 8.23x, Y 2.86x, B 20.67x over the 63 non-LLF cells, so total injected energy matched Phase 6.0's constant-amplitude sweep
        """
}

record jpegxl-rs.evidence.phase6-2-cross-size-decision-2026-08-12/1 : evidence {
    title "Phase 6.2 decision: one frequency curve fits all sizes, quantizer normalisation does not, and large transforms are under-penalised"
    state superseded
    result pass
    method observation
    observed_at git:a015011c3d86727100e61f69d83d3a380b1d9888
    artifact "JPXL/docs/experiments/2026-08-12-per-transform-frequency-weight.md"
    summary """
        Equal-coefficient-error curves collapse across the three squares once binned by radial normalised frequency and levelled (worst shared-bin disagreement 1.15x, six of nine bins within 5%), so one frequency curve prices all three; the step-proportional residual does NOT collapse (worst 2.05x, DCT8x8 a shallow bowl against DCT32x32 rising monotonically 0.59 to 2.79), so quantizer normalisation is rejected as the form of the weight; and at equal total sample-domain error a DCT32x32 basis costs 4-21% more butteraugli than DCT8x8 bases in every bin on both photographs
        """
}

