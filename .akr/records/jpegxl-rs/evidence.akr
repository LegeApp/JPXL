record jpegxl-rs.evidence.s8-cover-lane-simd-verified/1 : evidence {
    title "S8 cover-lane SIMD: bit-identical, measured faster, full suite green"
    state verified
    result pass
    method command
    observed_at git:f98e6bc375acb628c44e08774e9348bc96443586
    command "cd JPXL && cargo test -p jpxl-encode-policy --lib --release && cargo test -p jpxl-encode-policy --lib --release --no-default-features && cargo test -p jpxl-encode-policy --test vardct_roundtrip --release && cargo test -p jpxl-encode-policy --test vardct_oracle --release && cargo test -p jpxl-encode-policy --test rate_loop --release && cargo build --release -p jpxl-cli && ./target/release/jpxl bench vardct-fixed --input &lt;12MP-P6&gt; --threads 1 --iters 1 --diag"
    summary """
        HfQuantizer::choose_lane4 (quantize.rs) added: 4-adjacent-cell SIMD via wide::f32x4, bit-identical to 4 scalar choose() calls (exhaustive unit test across 6 quantizer configs x 10 boundary-stressing target patterns, all passing), with a whole-lane zero fast path added after measurement showed the naive always-run-full-search version made cover_ms ~35% slower than baseline despite fewer choose() calls (a SIMD lane can't skip per-element work the way a scalar early return can). Non-simd fallback (4 scalar choose() calls, same signature) verified via --no-default-features build+test. score_channel_lanes (lib.rs) drives it from block_cost_bounded via row-segment iteration (LLF-prefix skip, batches of 4 + scalar remainder), same raster accumulation order, same Phase-1 cutoff pruning at cell granularity. Verified output-preserving via --diag fingerprint/byte identity on a 12MP image: output_bytes=1,530,188 fingerprint=30e55ba3faef4d64, unchanged from pre-change baseline across 3 repeated runs. cover_ms improved ~1784ms -> stable ~1524-1532ms (14-15%). Full suites green: lib 60/60 (default) + 59/59 (no-default-features), vardct_roundtrip 12/12, vardct_oracle 9/10 (1 pre-existing unrelated failure), rate_loop 11/11 (+1 pre-existing ignore); rate_loop itself dropped from ~280s to ~28s wall-clock, consistent with the change directly speeding up the repeated-cover-search workload that test exercises.
        """
}

record jpegxl-rs.evidence.s8-phase-a-regret-harness-postcommit/1 : evidence {
    title "S8 Phase A landed state re-verified against commit 1c2c633"
    state verified
    result pass
    method command
    observed_at git:1c2c63326a901980867a3294f545fe04cb8afcf4
