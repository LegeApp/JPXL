        """
}

record jpegxl-rs.evidence.phase6-0-frequency-harness-2026-08-12/1 : evidence {
    title "Phase 6.0 frequency-response harness ran clean on two photographs, control passed"
    state superseded
    result pass
    method command
    observed_at git:cddce2b966a06b03e8ec92c096b3e1695d69ed55
    command "JPXL_CALIB_REF=.agent/scratch/realworld-bench-20260806T072202Z/{small_0p8MP,mid_4MP}.ppm JPXL_CALIB_SIDE=512 JPXL_CALIB_AMPS=0.25,0.5,1.0 cargo test --release -p jpxl-conformance --features perceptual --test perceptual_frequency -- --ignored --nocapture"
