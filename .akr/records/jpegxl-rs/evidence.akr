record jpegxl-rs.evidence.phase5p-distortion-proof-2026-08-12/1 : evidence {
    title "Phase 5P distortion-proof: Hornuss is not Parseval under inverse-recon sample SSE"
    state verified
    result pass
    method command
    observed_at git:3306720e0a079f2081a243cab2c0abad4809f4a2
    command "cargo test -p jpxl-encode-policy --lib exact_sample_distortion_is_not_parseval_for_hornuss -- --nocapture"
    summary """
        Unit test builds a mid-frequency impulse, quantizes under Hornuss at a baseline HfQuantizer, inverse-transforms the reconstructed coefficients, and shows coeff_SSE * 64 is not equal to sample-domain recon SSE (ratio differs from 1 by more than 5%). This is the permanent Phase 5P distortion-proof acceptance and a standing constraint on any future special-transform scorer.
        """
}

record jpegxl-rs.evidence.phase5p-policy-decision-2026-08-12/1 : evidence {
    title "Phase 5P policy: research mode removed; production square cover restored; wire specials kept"
    state verified
    result pass
    method observation
    observed_at git:3306720e0a079f2081a243cab2c0abad4809f4a2
    artifact "JPXL/docs/experiments/2026-08-12-special-exact-distortion.md"
    summary """
        No production policy change. SpecialTransformMode and CLI flag removed after the discriminating screen. Writer permanently accepts Hornuss/DCT2x2/DCT4x4/DCT8x4/DCT4x8/AFV0-3 (Phase 5O wire evidence) so a later scorer can emit them; large/rectangular families remain refused. Production fingerprint is the square hierarchical cover.
        """
}

record jpegxl-rs.evidence.phase5p-quality-screen-2026-08-12/1 : evidence {
    title "Phase 5P quality screen: exact sample specials regress SSIMULACRA2 in 8/8 and butteraugli in 7/8"
    state verified
    result pass
    method observation
    observed_at git:3306720e0a079f2081a243cab2c0abad4809f4a2
    artifact "JPXL/docs/experiments/2026-08-12-special-exact-distortion.md"
    summary """
        Eight discriminating cells (Phase 5O strongest winners and regressors) at matched production byte caps. SSIMULACRA2 better 0/8; butteraugli better 1/8 (small1/2 -7.2% BA with -5.81 SSIM). Worst cells small4/1 (-26.89 SSIM, +35.9% BA) and small3/1 (-15.83 SSIM, +28.3% BA). Gate fails under SSIMULACRA2-primary and Contract B; full matrix not run. Research mode removed.
        """
}

record jpegxl-rs.evidence.phase5p-rate-oracle-2026-08-12/1 : evidence {
