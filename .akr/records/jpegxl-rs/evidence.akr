record jpegxl-rs.evidence.phase6-2b-quality-negative-2026-08-12/1 : evidence {
    title "Phase 6.2b honest negative: correctly repricing transform size does not improve perceptual quality"
    state superseded
    result fail
    method observation
    observed_at git:7924f0a71a5bccdf16798f83fee6d89fb233b579
    artifact "JPXL/docs/experiments/2026-08-12-large-transform-penalty-screen.md"
    summary """
        Across 14 exactly-matched-rate cells (7 test-set photographs at 1 and 2 bpp, measured encoded to neutral's achieved byte count, both decoded with the pinned djxl) the measured per-transform scale improved butteraugli in 5 cells and regressed 9, mean +2.03% and median +1.18% with a range of -5.9% to +14.2%, and regressed SSIMULACRA2 in 11 of 14 (mean -0.41); measured lands 0.55% under the cap on average, worth about +0.55% butteraugli on this corpus's local RD slope, so roughly a quarter of the mean is that confound and the rest is real
        """
}

