record jpegxl-rs.evidence.phase5p-distortion-proof-2026-08-12/1 : evidence {
    title "Phase 5P distortion-proof: Hornuss is not Parseval under inverse-recon sample SSE"
    state verified
    result pass
    method command
    observed_at git:3306720e0a079f2081a243cab2c0abad4809f4a2
    command "cargo test -p jpxl-encode-policy --lib exact_sample_distortion_is_not_parseval_for_hornuss -- --nocapture"
    summary """
        Unit test builds a mid-frequency impulse, quantizes under Hornuss at a baseline HfQuantizer, inverse-transforms the reconstructed coefficients, and shows coeff_SSE * 64 is not equal to sample-domain recon SSE (ratio differs from 1 by more than 5%). This is the permanent Phase 5P distortion-proof acceptance and a standing constraint on any future special-transform scorer.
        """
}

