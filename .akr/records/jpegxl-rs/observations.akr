record jpegxl-rs.observation.phase5-aqoff-jxloxide-incompatibility-2026-08-11/1 : observation {
    title "AQ-Off HfMul candidates agree in djxl/self but fail in jxl-oxide"
    state superseded
    scope [
        path "JPXL/crates/jpxl-encode-policy/src/field.rs",
        path "JPXL/crates/jpxl-encode-policy/src/rate.rs",
