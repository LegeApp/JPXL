        "JPXL/crates/jpxl-decode/src/vardct/**"
    ]
    derived_from [ @jpegxl-rs.observation.phase5-quality-policy-screen-2026-08-11 ]
    verified_by [
        @jpegxl-rs.evidence.phase5-candidate-djxl-self-agree-2026-08-11,
        @jpegxl-rs.evidence.phase5-candidate-jxloxide-gate-2026-08-11
    ]
}

record jpegxl-rs.observation.phase5-aqoff-jxloxide-incompatibility-2026-08-11/2 : observation {
