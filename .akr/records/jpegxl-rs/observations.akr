record jpegxl-rs.observation.h52-clamp/1 : observation {
    title "H.5.2 clamp guard is XOR; defect was in the sub-predictors"
    state verified
    statement """
        H.5.2's clamp is asymmetric, not one symmetric clamp behind one guard; the guard is XOR (a single scan read resolved three sessions of chasing), and the residual defect localised to the sub-predictors, not the weights, clamp, or max_error.
        """
    observed_at git:f35cabcf45c130c513d3f1498de2017facb9551f
    watches [ "JPXL/crates/jpxl-decode/**" ]
    author "GitHub Uploader"
    source {
        kind legacy
        path "JPXL/docs/experiments/2026-08-03-h52-clamp-xor-scan-resolution.md"
        excerpt """
            H.5.2's clamp guard is XOR: one scan read closes three sessions of chasing
            """
    }
}

