record jpegxl-rs.observation.phase5-quality-policy-screen-2026-08-11/8 : observation {
    title "One active EPF step remains best globally; chroma QM is also content-dependent"
    state superseded
    scope [
        path "JPXL/crates/jpxl-cli/src/main.rs",
        path "JPXL/crates/jpxl-encode-policy/src/field.rs",
        path "JPXL/crates/jpxl-encode-policy/src/lib.rs",
