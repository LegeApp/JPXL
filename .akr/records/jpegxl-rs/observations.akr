record jpegxl-rs.observation.phase4l-full-only-negative-2026-08-11/1 : observation {
    title "Full-only rate search is slower despite fewer prices"
    state verified
    scope [ path "JPXL/crates/jpxl-encode-policy/src/rate.rs" ]
    statement """
        At base commit 315e763d72e164a36a890ce3f3660f6eb7f62dc3, a temporary uncommitted Phase 4L prototype replaced the Fast upper-bound ladder plus Full refinement with one Full-entropy ladder under the same 40-price cap. All jpxl-encode-policy lib and rate_loop tests passed and output bytes/fingerprints were identical at 1, 2, and 4 bpp on the pinned 1024x768 photo, but wall time regressed from 6460.695 to 6924.504 ms (+7%), 15765.131 to 18241.482 ms (+16%), and 27284.956 to 55846.541 ms (+105%). Price counts fell from 8 Fast + 6 Full, 13 Fast + 6 Full, and 20 Fast + 6 Full to 8, 13, and 20 Full prices respectively. The prototype was reverted. Fast remains economically useful; future work should improve Fast-to-Full handoff or Fast planning cost rather than replace all Fast prices with Full emissions. Raw diagnostic summary: .agent/scratch/phase4l-full-only-ab-2026-08-11.md.
        """
    observed_at git:315e763d72e164a36a890ce3f3660f6eb7f62dc3
    method command
    watches [ "JPXL/crates/jpxl-encode-policy/src/rate.rs" ]
}

