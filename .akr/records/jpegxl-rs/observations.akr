        "JPXL/crates/jpxl-encode/src/vardct/write.rs",
        "JPXL/crates/jpxl-encode/tests/vardct_plan.rs"
    ]
    derived_from [ @jpegxl-rs.observation.aq-field-is-a-net-perceptual-loss-2026-08-10/2 ]
    supersedes [ @jpegxl-rs.observation.phase5-quality-policy-screen-2026-08-11/10 ]
