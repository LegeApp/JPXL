akr 0.1
project jpegxl-rs

record jpegxl-rs.track.akr-adoption/1 : track {
    title "Adopt AKR as the plan-of-record"
    state proposed
    intent """
        Retire hand-maintained markdown planning (roadmap, HANDOFF, PLAN, CONFORMANCE,
        docs/experiments) and make the AKR generated views the single reading surface.
        """
    cadence "one migration phase per session"
    author "GitHub Uploader"
}

record jpegxl-rs.track.encoder-optimization/1 : track {
    title "Encoder optimization pass"
    state proposed
    intent """
        Standing encoder optimization pass for Modular lossless and VarDCT. Order is
        measurement foundation, then remove repeated work and deep copies, then coarse
        group/section parallelism, then leaf SIMD, then LTO/PGO. Rankings in the source
        assessment are static findings, not substitutes for flamegraphs.
        """
    cadence "one milestone at a time; measure before and after each change"
    source {
        kind legacy
        path "JPXL/optimization-plan.akr"
        excerpt """
            The optimization pass should not begin with a general add SIMD and Rayon
            sweep. First remove repeated transforms, deep coefficient copies, and
            per-varblock allocations. Then parallelize groups. Then vectorize leaf
            kernels still visible at the top of the profile.
            """
    }
}

record jpegxl-rs.track.vardct-encoder/1 : track {
    title "VarDCT encoder (M1-M8)"
    state proposed
    intent """
        The VarDCT encoder, built as milestones M1-M8 (PLAN.md slices 11-18) and
        backfilled from git history as legacy-sourced completed records (D-028).
        """
    cadence "one milestone per encoder slice"
    author "GitHub Uploader"
}
